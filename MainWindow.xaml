<Window
    x:Class="Zeitmanagement.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Zeitmanagement"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:Zeitmanagement.ViewModel"
    Title="{Binding WindowTitle}"
    Width="1800"
    Height="800"
    d:DataContext="{d:DesignInstance Type=viewmodel:MainViewModel}"
    ResizeMode="CanResize"
    WindowState="Maximized"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MaxWidth="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Background="#1A2238">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <Image Height="50" />
                <Button
                    Height="30"
                    MaxWidth="140"
                    Margin="5"
                    Background="#00000000"
                    Command="{Binding SelectViewCommand}"
                    CommandParameter="Dashboard"
                    Content="Dashboard"
                    Foreground="White" />
                <Button
                    Height="30"
                    MaxWidth="140"
                    Margin="5"
                    Background="#00000000"
                    Command="{Binding SelectViewCommand}"
                    CommandParameter="Hours"
                    Content="Stundenbuchung"
                    Foreground="White" />
                <Button
                    Height="30"
                    MaxWidth="140"
                    Margin="5"
                    Background="#00000000"
                    Command="{Binding SelectViewCommand}"
                    CommandParameter="Projects"
                    Content="Projektübersicht"
                    Foreground="White" />
                <Button
                    Height="30"
                    MaxWidth="140"
                    Margin="5"
                    Background="#00000000"
                    Command="{Binding SelectViewCommand}"
                    CommandParameter="QuickSelect"
                    Content="Quick Select"
                    Foreground="White" />
                <Button
                    Height="30"
                    MaxWidth="140"
                    Margin="5"
                    Background="#00000000"
                    Command="{Binding SelectViewCommand}"
                    CommandParameter="Fragmentation"
                    Content="Fragmentierung"
                    Foreground="White" />
                <Button
                    Height="30"
                    MaxWidth="140"
                    Margin="5"
                    Background="#00000000"
                    Command="{Binding SelectViewCommand}"
                    CommandParameter="Settings"
                    Content="Einstellungen"
                    Foreground="White" />
            </StackPanel>
            <TextBlock
                Grid.Row="1"
                Margin="5"
                HorizontalAlignment="Center"
                FontSize="17"
                Foreground="White"
                Text="{Binding Clock}"
                TextAlignment="Center" />
        </Grid>
        <ContentControl Grid.Column="1" Content="{Binding RightSide}" />
    </Grid>
</Window>
