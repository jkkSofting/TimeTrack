<Window
    x:Class="Zeitmanagement.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Zeitmanagement"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:Zeitmanagement.ViewModel"
    xmlns:views="clr-namespace:Zeitmanagement.Views"
    Title="{Binding WindowTitle}"
    Width="1800"
    Height="800"
    MinWidth="1000"
    MinHeight="600"
    d:DataContext="{d:DesignInstance Type=viewmodel:MainViewModel}"
    Background="{DynamicResource Theme.AppBackground}"
    FontFamily="Segoe UI"
    ResizeMode="CanResize"
    UseLayoutRounding="True"
    WindowState="Maximized"
    mc:Ignorable="d"
    PreviewMouseDown="Window_PreviewMouseDown">
    <Window.InputBindings>
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding GoBackCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding GoForwardCommand}" />
        <!--  Esc bricht das offene Overlay ab; ohne Overlay ist der Befehl null und Esc bleibt unberührt  -->
        <KeyBinding Key="Escape" Command="{Binding Overlay.Current.CancelCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <views:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <!--  Kleine Gruppenüberschrift in der Navigation  -->
        <Style x:Key="NavGroup" TargetType="TextBlock">
            <Setter Property="Margin" Value="26,18,0,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.SidebarTextMuted}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid IsEnabled="{Binding Overlay.IsOpen, Converter={StaticResource InverseBool}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ===== Seitenleiste =====  -->
            <Border
                Background="{DynamicResource Theme.Sidebar}"
                BorderBrush="{DynamicResource Theme.SidebarBorder}"
                BorderThickness="0,0,1,0">
                <DockPanel>
                    <!--  Logo: das Pinguin-Maskottchen + Schriftzug  -->
                    <StackPanel
                        Margin="22,22,16,6"
                        DockPanel.Dock="Top"
                        Orientation="Horizontal">
                        <ContentControl
                            Width="42"
                            Height="42"
                            Focusable="False"
                            Template="{StaticResource MascotLogoTemplate}" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="19"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Theme.SidebarText}"
                                Text="TimeTrack" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource Theme.SidebarTextMuted}"
                                Text="Zeiterfassung" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Verlauf: Zurück und Vor (auch Alt+Links/Alt+Rechts und die Maus-Zusatztasten)  -->
                    <StackPanel
                        Margin="18,6,18,0"
                        DockPanel.Dock="Top"
                        Orientation="Horizontal">
                        <Button
                            views:Ui.Glyph="&#xE72B;"
                            Command="{Binding GoBackCommand}"
                            Foreground="{DynamicResource Theme.SidebarText}"
                            Style="{StaticResource Button.IconGhost}"
                            ToolTip="Zurück (Alt+Links)" />
                        <Button
                            Margin="4,0,0,0"
                            views:Ui.Glyph="&#xE72A;"
                            Command="{Binding GoForwardCommand}"
                            Foreground="{DynamicResource Theme.SidebarText}"
                            Style="{StaticResource Button.IconGhost}"
                            ToolTip="Vor (Alt+Rechts)" />
                    </StackPanel>

                    <!--  Gruß des saisonalen bzw. Fan-Themes (sonst ausgeblendet)  -->
                    <Border
                        Margin="18,10,18,0"
                        Padding="10,6"
                        Background="{DynamicResource Theme.SidebarSelected}"
                        CornerRadius="{StaticResource CardRadius}"
                        DockPanel.Dock="Top">
                        <TextBlock
                            x:Name="Greeting"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Theme.SidebarSelectedText}"
                            Text="{DynamicResource Theme.Greeting}"
                            TextTrimming="CharacterEllipsis" />
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=Greeting}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!--  Fußzeile: Uhr, Datum und Hell/Dunkel-Schalter  -->
                    <Border
                        Margin="18,8,18,18"
                        Padding="14,12"
                        BorderBrush="{DynamicResource Theme.SidebarBorder}"
                        BorderThickness="0,1,0,0"
                        DockPanel.Dock="Bottom">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock
                                    FontFamily="Segoe UI Semibold"
                                    FontSize="22"
                                    Foreground="{DynamicResource Theme.SidebarText}"
                                    Text="{Binding Clock}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource Theme.SidebarTextMuted}"
                                    Text="{Binding Today}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                views:Ui.Glyph="&#xE706;"
                                Command="{Binding ToggleDarkModeCommand}"
                                Foreground="{DynamicResource Theme.SidebarText}"
                                Style="{StaticResource Button.IconGhost}"
                                ToolTip="Zwischen heller und dunkler Variante des Designs wechseln. Weitere Designs gibt es in den Einstellungen." />
                        </Grid>
                    </Border>

                    <!--  Navigation  -->
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource NavGroup}" Text="ZEITERFASSUNG" />
                            <RadioButton
                                views:Ui.Glyph="&#xE80F;"
                                Command="{Binding SelectViewCommand}"
                                CommandParameter="Dashboard"
                                Content="Dashboard"
                                GroupName="Nav"
                                IsChecked="{Binding CurrentView, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=dashboard}"
                                Style="{StaticResource NavItem}" />
                            <!--  Keine Seite, sondern das kleine Quick-Switch-Fenster zum Starten, Pausieren und Stoppen von Buchungen  -->
                            <Button
                                views:Ui.Glyph="&#xE8A7;"
                                Click="OpenQuickSwitch_Click"
                                Content="Quick Switch"
                                Style="{StaticResource NavAction}"
                                ToolTip="Kleines, immer sichtbares Fenster zum schnellen Wechseln zwischen Projekten öffnen" />
                            <RadioButton
                                views:Ui.Glyph="&#xE787;"
                                Command="{Binding SelectViewCommand}"
                                CommandParameter="Hours"
                                Content="Stundenbuchung"
                                GroupName="Nav"
                                IsChecked="{Binding CurrentView, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=hours}"
                                Style="{StaticResource NavItem}" />

                            <TextBlock Style="{StaticResource NavGroup}" Text="AUSWERTUNG" />
                            <RadioButton
                                views:Ui.Glyph="&#xE9D2;"
                                Command="{Binding SelectViewCommand}"
                                CommandParameter="Fragmentation"
                                Content="Fragmentierung"
                                GroupName="Nav"
                                IsChecked="{Binding CurrentView, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=fragmentation}"
                                Style="{StaticResource NavItem}" />
                            <RadioButton
                                views:Ui.Glyph="&#xE8EF;"
                                Command="{Binding SelectViewCommand}"
                                CommandParameter="Sap"
                                Content="SAP-Verrechnung"
                                GroupName="Nav"
                                IsChecked="{Binding CurrentView, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=sap}"
                                Style="{StaticResource NavItem}" />
                            <RadioButton
                                views:Ui.Glyph="&#xE9F9;"
                                Command="{Binding SelectViewCommand}"
                                CommandParameter="Controlling"
                                Content="Projektcontrolling"
                                GroupName="Nav"
                                IsChecked="{Binding CurrentView, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=controlling}"
                                Style="{StaticResource NavItem}" />
                            <RadioButton
                                views:Ui.Glyph="&#xE8A5;"
                                Command="{Binding SelectViewCommand}"
                                CommandParameter="Export"
                                Content="Tätigkeitsnachweis"
                                GroupName="Nav"
                                IsChecked="{Binding CurrentView, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=export}"
                                Style="{StaticResource NavItem}" />

                            <TextBlock Style="{StaticResource NavGroup}" Text="ORGANISATION" />
                            <RadioButton
                                views:Ui.Glyph="&#xE7C4;"
                                Command="{Binding SelectViewCommand}"
                                CommandParameter="Todo"
                                Content="To-Do"
                                GroupName="Nav"
                                IsChecked="{Binding CurrentView, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=todo}"
                                Style="{StaticResource NavItem}" />
                            <RadioButton
                                views:Ui.Glyph="&#xE70B;"
                                Command="{Binding SelectViewCommand}"
                                CommandParameter="Notes"
                                Content="Notizen"
                                GroupName="Nav"
                                IsChecked="{Binding CurrentView, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=notes}"
                                Style="{StaticResource NavItem}" />

                            <TextBlock Style="{StaticResource NavGroup}" Text="VERWALTUNG" />
                            <RadioButton
                                views:Ui.Glyph="&#xE8B7;"
                                Command="{Binding SelectViewCommand}"
                                CommandParameter="Projects"
                                Content="Projekte"
                                GroupName="Nav"
                                IsChecked="{Binding CurrentView, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=projects}"
                                Style="{StaticResource NavItem}" />
                            <RadioButton
                                views:Ui.Glyph="&#xE74D;"
                                Command="{Binding SelectViewCommand}"
                                CommandParameter="Trash"
                                Content="Papierkorb"
                                GroupName="Nav"
                                IsChecked="{Binding CurrentView, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=trash}"
                                Style="{StaticResource NavItem}" />
                            <RadioButton
                                views:Ui.Glyph="&#xE713;"
                                Command="{Binding SelectViewCommand}"
                                CommandParameter="Settings"
                                Content="Einstellungen"
                                GroupName="Nav"
                                IsChecked="{Binding CurrentView, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=settings}"
                                Style="{StaticResource NavItem}" />

                            <!--  Seiten der aktivierten Plugins (Gruppe nur sichtbar, wenn es welche gibt)  -->
                            <TextBlock
                                Style="{StaticResource NavGroup}"
                                Text="PLUGINS"
                                Visibility="{Binding HasPluginPages, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl Focusable="False" ItemsSource="{Binding PluginNavigationItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewmodel:PluginNavigationItem}">
                                        <RadioButton
                                            views:Ui.Glyph="{Binding Glyph}"
                                            Command="{Binding DataContext.SelectViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Key}"
                                            Content="{Binding Title}"
                                            GroupName="Nav"
                                            IsChecked="{Binding IsSelected, Mode=OneWay}"
                                            Style="{StaticResource NavItem}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource NavGroup}" Text="INFO" />
                            <Grid>
                                <RadioButton
                                    views:Ui.Glyph="&#xE897;"
                                    Command="{Binding SelectViewCommand}"
                                    CommandParameter="Help"
                                    Content="Hilfe &amp; Neuigkeiten"
                                    GroupName="Nav"
                                    IsChecked="{Binding CurrentView, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=help}"
                                    Style="{StaticResource NavItem}" />
                                <!--  Punkt, solange die Neuigkeiten der installierten Version ungelesen sind  -->
                                <Ellipse
                                    Width="9"
                                    Height="9"
                                    Margin="0,0,24,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Fill="{DynamicResource Theme.Accent}"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding Help.HasUnseenNews, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!--  ===== Inhalt =====  -->
            <ContentControl
                Grid.Column="1"
                Content="{Binding RightSide}"
                Focusable="False" />
        </Grid>

        <!--
            ===== Overlay =====
            Modales Bearbeiten-Formular über der ganzen App. Solange es offen ist, ist die Schicht darunter
            gesperrt (IsEnabled=false: keine Maus, kein Tab). Der Inhalt kommt aus dem impliziten DataTemplate
            des jeweiligen OverlayViewModelBase-Typs (Views/Templates.xaml).
        -->
        <Grid
            x:Name="OverlayLayer"
            Background="#99000000"
            Focusable="False"
            Visibility="{Binding Overlay.IsOpen, Converter={StaticResource BoolToVis}}">
            <Border
                x:Name="OverlayCard"
                MaxWidth="640"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Theme.Card}"
                BorderBrush="{DynamicResource Theme.CardBorder}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardRadius}"
                Effect="{DynamicResource Theme.PopupShadow}"
                KeyboardNavigation.ControlTabNavigation="Cycle"
                KeyboardNavigation.TabNavigation="Cycle">
                <DockPanel Margin="24,20,24,20">
                    <TextBlock
                        Margin="0,0,0,16"
                        DockPanel.Dock="Top"
                        Style="{StaticResource Text.PageTitle}"
                        Text="{Binding Overlay.Current.Title}" />

                    <!--  Aktionsleiste: links die optionale dritte Aktion (z. B. Löschen), rechts Abbrechen und Speichern  -->
                    <Grid Margin="0,20,0,0" DockPanel.Dock="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Command="{Binding Overlay.Current.DangerCommand}"
                            Content="{Binding Overlay.Current.DangerText}"
                            Style="{StaticResource Button.Danger}"
                            Visibility="{Binding Overlay.Current.DangerCommand, Converter={StaticResource NullToCollapsed}}" />
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                Command="{Binding Overlay.Current.CancelCommand}"
                                Content="{Binding Overlay.Current.CancelText}" />
                            <Button
                                Margin="8,0,0,0"
                                Command="{Binding Overlay.Current.SaveCommand}"
                                Content="{Binding Overlay.Current.SaveText}"
                                Style="{StaticResource Button.Primary}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ContentControl
                            Content="{Binding Overlay.Current}"
                            Focusable="False"
                            IsTabStop="False" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
