<UserControl
    x:Class="Zeitmanagement.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Zeitmanagement.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:Zeitmanagement.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:SettingsViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Color x:Key="ColCard">#1A2238</Color>
        <Color x:Key="ColText">#F5F7FB</Color>
        <Color x:Key="ColTextMuted">#B7C0D8</Color>

        <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColText}" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColTextMuted}" />
        <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColCard}" />

        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#0B1020" />
            <GradientStop Offset="1" Color="#121A33" />
        </LinearGradientBrush>

        <!--  Card  -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{StaticResource BrushCard}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="18"
                        Opacity="0.4"
                        ShadowDepth="3"
                        Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Flat-Button  -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Background" Value="#2D3A63" />
            <Setter Property="BorderBrush" Value="#42507C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#34406E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Primary Flat-Button (Speichern)  -->
        <Style x:Key="PrimaryFlatButton" BasedOn="{StaticResource FlatButton}" TargetType="Button">
            <Setter Property="Background" Value="#3A7BD5" />
            <Setter Property="BorderBrush" Value="#5B9BE8" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!--  Pretty ComboBox - text color is set explicitly via TextElement.Foreground on the
              ContentPresenters because the default theme's ComboBoxItem/ToggleButton templates
              don't template-bind Foreground, so a plain Style Setter has no visible effect.  -->
        <Style x:Key="NiceCombo" BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Background" Value="#233055" />
            <Setter Property="BorderBrush" Value="#33406A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton
                                x:Name="ToggleButton"
                                ClickMode="Press"
                                Focusable="False"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border
                                            Background="#233055"
                                            BorderBrush="#33406A"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <DockPanel Margin="10,6">
                                                <Path
                                                    Width="10"
                                                    Height="6"
                                                    DockPanel.Dock="Right"
                                                    VerticalAlignment="Center"
                                                    Data="M 0 0 L 5 5 L 10 0"
                                                    Fill="{StaticResource BrushTextMuted}" />
                                                <ContentPresenter
                                                    Margin="2,0,8,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    TextElement.Foreground="{StaticResource BrushText}" />
                                            </DockPanel>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup
                                x:Name="Popup"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PopupAnimation="Slide">
                                <Border
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="#233055"
                                    BorderBrush="#33406A"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <ScrollViewer MaxHeight="240">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter TextElement.Foreground="{StaticResource BrushText}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#2A3A67" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#334579" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border
            Grid.Row="0"
            Margin="16,16,16,8"
            Style="{StaticResource Card}">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource BrushText}"
                Text="Einstellungen" />
        </Border>

        <!--  Body  -->
        <Border
            Grid.Row="1"
            Margin="16,8,16,16"
            Style="{StaticResource Card}"
            VerticalAlignment="Top">
            <StackPanel MaxWidth="480" HorizontalAlignment="Left">
                <CheckBox Content="Mit Windows starten" IsChecked="{Binding AutostartEnabled, Mode=TwoWay}" />

                <TextBlock
                    Margin="2,14,0,4"
                    Foreground="{StaticResource BrushTextMuted}"
                    Text="Programm starten als" />
                <ComboBox
                    DisplayMemberPath="Label"
                    ItemsSource="{Binding StartupModeOptions}"
                    SelectedValue="{Binding SelectedStartupMode, Mode=TwoWay}"
                    SelectedValuePath="Value"
                    Style="{StaticResource NiceCombo}" />

                <CheckBox
                    Margin="0,18,0,0"
                    Content="Schnellwechsel-Fenster immer im Vordergrund halten"
                    IsChecked="{Binding FloatingWindowAlwaysOnTop, Mode=TwoWay}" />

                <StackPanel
                    Margin="0,24,0,0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <Button
                        MinWidth="110"
                        Command="{Binding SaveCommand}"
                        Content="Speichern"
                        Style="{StaticResource PrimaryFlatButton}" />
                    <Button
                        MinWidth="110"
                        Margin="8,0,0,0"
                        Command="{Binding CancelCommand}"
                        Content="Verwerfen"
                        Style="{StaticResource FlatButton}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
