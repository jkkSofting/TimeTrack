<UserControl
    x:Class="Zeitmanagement.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Zeitmanagement.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:Zeitmanagement.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:SettingsViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  Karte einer Einstellungsgruppe mit Icon und Titel  -->
        <Style
            x:Key="SettingsCard"
            BasedOn="{StaticResource Card}"
            TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="CardIcon" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" />
        </Style>

        <Style x:Key="CardHeader" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Orientation" Value="Horizontal" />
        </Style>

        <!--  Eine Zeile mit Trennlinie zwischen Einstellungen  -->
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Padding" Value="0,12" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Divider}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="64" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <!--  Design-Auswahl: Kacheln mit kleiner Vorschau des Farbschemas  -->
        <Style x:Key="ThemeTile" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="frame"
                            Width="148"
                            Padding="6"
                            Background="{DynamicResource Theme.Surface}"
                            BorderBrush="{DynamicResource Theme.CardBorder}"
                            BorderThickness="2"
                            CornerRadius="12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Theme.TextSubtle}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                                <Setter TargetName="frame" Property="Background" Value="{DynamicResource Theme.AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ThemeTileTemplate" DataType="{x:Type viewmodel:ThemeOption}">
            <StackPanel>
                <!--  Mini-Vorschau: Seitenleiste, Hintergrund, Karte mit Akzent  -->
                <Border
                    Height="70"
                    Background="{Binding Background}"
                    BorderBrush="{Binding CardBorder}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    CornerRadius="7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{Binding Sidebar}" CornerRadius="6,0,0,6">
                            <StackPanel Margin="6,10,6,0">
                                <Border
                                    Height="4"
                                    Margin="0,0,0,5"
                                    Background="{Binding Accent}"
                                    CornerRadius="2" />
                                <Border
                                    Height="4"
                                    Margin="0,0,0,5"
                                    Background="{Binding Text}"
                                    CornerRadius="2" />
                                <Border
                                    Height="4"
                                    Background="{Binding Text}"
                                    CornerRadius="2" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Column="1"
                            Margin="8,10,8,10"
                            Padding="7"
                            Background="{Binding Card}"
                            BorderBrush="{Binding CardBorder}"
                            BorderThickness="1"
                            CornerRadius="5">
                            <StackPanel>
                                <Border
                                    Width="40"
                                    Height="4"
                                    HorizontalAlignment="Left"
                                    Background="{Binding Text}"
                                    CornerRadius="2" />
                                <Border
                                    Width="26"
                                    Height="10"
                                    Margin="0,9,0,0"
                                    HorizontalAlignment="Right"
                                    Background="{Binding Accent}"
                                    CornerRadius="3" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <DockPanel Margin="2,6,2,0">
                    <Border
                        Padding="5,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Theme.Surface}"
                        BorderBrush="{DynamicResource Theme.CardBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        DockPanel.Dock="Right"
                        ToolTip="Erscheint auch automatisch zur passenden Jahreszeit"
                        Visibility="{Binding IsSeasonal, Converter={StaticResource BoolToVis}}">
                        <TextBlock
                            FontSize="10"
                            Foreground="{DynamicResource Theme.TextMuted}"
                            Text="saisonal" />
                    </Border>
                    <TextBlock
                        FontWeight="SemiBold"
                        Style="{StaticResource Text.Body}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <!--  Kleiner Fisch für die Statistik (wie der geworfene Fisch, verkleinert)  -->
        <DrawingImage x:Key="FishIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#4F7FB0" Geometry="M16,22 L0,4 5,22 0,40 Z M30,10 L40,0 56,10 Z M34,34 L42,43 52,34 Z" />
                    <GeometryDrawing Geometry="M10,22 A33,15 0 1 1 76,22 A33,15 0 1 1 10,22 Z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#6F9CCB" />
                                <GradientStop Offset="0.55" Color="#B8D4EE" />
                                <GradientStop Offset="1" Color="#EEF5FB" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="White" Geometry="M57,19.5 A3.5,3.5 0 1 1 64,19.5 A3.5,3.5 0 1 1 57,19.5 Z" />
                    <GeometryDrawing Brush="Black" Geometry="M60,19.75 A1.75,1.75 0 1 1 63.5,19.75 A1.75,1.75 0 1 1 60,19.75 Z" />
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </UserControl.Resources>

    <Grid Style="{StaticResource Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Style="{StaticResource PageHeader}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="Einstellungen" />
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="Das Design wird sofort übernommen, alles andere mit „Speichern“ unten." />
            </StackPanel>
        </DockPanel>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid Margin="28,0,28,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  ===== Darstellung (volle Breite) =====  -->
                <Border Grid.ColumnSpan="3" Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource CardHeader}">
                            <TextBlock Style="{StaticResource CardIcon}" Text="&#xE790;" />
                            <TextBlock Style="{StaticResource Text.Section}" Text="Design" />
                        </StackPanel>

                        <ListBox
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource ThemeTile}"
                            ItemTemplate="{StaticResource ThemeTileTemplate}"
                            ItemsSource="{Binding ThemeOptions}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
                            <!--  Ohne eigenen ScrollViewer, damit das Mausrad die Seite scrollt  -->
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ItemsPresenter />
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <Border Margin="0,4,0,0" Style="{StaticResource SettingRow}">
                            <StackPanel>
                                <CheckBox
                                    Content="Saisonale Designs automatisch anzeigen"
                                    IsChecked="{Binding SeasonalThemesEnabled, Mode=TwoWay}"
                                    Style="{StaticResource Switch}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{Binding SeasonalThemesHint}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Margin="0,4,0,0"
                            Padding="10,8"
                            Background="{DynamicResource Theme.AccentSoft}"
                            CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ThemeStatusText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    FontSize="13"
                                    Foreground="{DynamicResource Theme.AccentSoftText}"
                                    Style="{StaticResource Text.Icon}"
                                    Text="&#xE946;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Theme.AccentSoftText}"
                                    Text="{Binding ThemeStatusText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!--  ===== Linke Spalte =====  -->
                <StackPanel Grid.Row="1">
                    <!--  Start & Fenster  -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource CardHeader}">
                                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE7E8;" />
                                <TextBlock Style="{StaticResource Text.Section}" Text="Start &amp; Fenster" />
                            </StackPanel>

                            <Border BorderThickness="0" Style="{StaticResource SettingRow}">
                                <CheckBox
                                    Content="Mit Windows starten"
                                    IsChecked="{Binding AutostartEnabled, Mode=TwoWay}"
                                    Style="{StaticResource Switch}" />
                            </Border>

                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <ComboBox
                                        Width="300"
                                        DockPanel.Dock="Right"
                                        ItemsSource="{Binding StartupModeOptions}"
                                        SelectedValue="{Binding SelectedStartupMode, Mode=TwoWay}"
                                        SelectedValuePath="Value">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Text.Body}"
                                        Text="Programm starten als" />
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource SettingRow}">
                                <CheckBox
                                    Content="Quick-Switch-Fenster immer im Vordergrund halten"
                                    IsChecked="{Binding FloatingWindowAlwaysOnTop, Mode=TwoWay}"
                                    Style="{StaticResource Switch}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!--  Automatisierung  -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource CardHeader}">
                                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE945;" />
                                <TextBlock Style="{StaticResource Text.Section}" Text="Automatisierung" />
                            </StackPanel>

                            <Border BorderThickness="0" Style="{StaticResource SettingRow}">
                                <StackPanel>
                                    <CheckBox
                                        Content="Buchung bei Sperrbildschirm/Ruhemodus automatisch beenden"
                                        IsChecked="{Binding AutoStopOnLockEnabled, Mode=TwoWay}"
                                        Style="{StaticResource Switch}" />
                                    <StackPanel
                                        Margin="0,10,0,0"
                                        IsEnabled="{Binding AutoStopOnLockEnabled}"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Text.Muted}"
                                            Text="Nach" />
                                        <TextBox
                                            Margin="8,0"
                                            Style="{StaticResource NumberBox}"
                                            Text="{Binding AutoStopOnLockMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Text.Muted}"
                                            Text="Minuten Sperrbildschirm" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingRow}">
                                <StackPanel>
                                    <CheckBox
                                        Content="Erinnern, wenn kein Projekt läuft"
                                        IsChecked="{Binding ReminderNudgeEnabled, Mode=TwoWay}"
                                        Style="{StaticResource Switch}" />
                                    <StackPanel
                                        Margin="0,10,0,0"
                                        IsEnabled="{Binding ReminderNudgeEnabled}"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Text.Muted}"
                                            Text="Alle" />
                                        <TextBox
                                            Margin="8,0"
                                            Style="{StaticResource NumberBox}"
                                            Text="{Binding ReminderNudgeIntervalMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Text.Muted}"
                                            Text="Minuten erinnern" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!--  Updates  -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource CardHeader}">
                                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE895;" />
                                <TextBlock Style="{StaticResource Text.Section}" Text="Updates" />
                            </StackPanel>

                            <Border BorderThickness="0" Style="{StaticResource SettingRow}">
                                <CheckBox
                                    Content="Regelmäßig automatisch nach Updates suchen"
                                    IsChecked="{Binding AutoUpdateCheckEnabled, Mode=TwoWay}"
                                    Style="{StaticResource Switch}" />
                            </Border>

                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button
                                            local:Ui.Glyph="&#xE72C;"
                                            Command="{Binding CheckForUpdateCommand}"
                                            Content="Suchen" />
                                        <Button
                                            Margin="8,0,0,0"
                                            local:Ui.Glyph="&#xE896;"
                                            Command="{Binding InstallUpdateCommand}"
                                            Content="Installieren"
                                            Style="{StaticResource Button.Primary}"
                                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding UpdateStatusText}" />
                                        <TextBlock Style="{StaticResource Hint}" Text="{Binding CurrentVersionText, StringFormat='Installierte Version: {0}'}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  ===== Rechte Spalte =====  -->
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <!--  Pinguin  -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource CardHeader}">
                                <ContentControl
                                    Width="22"
                                    Height="22"
                                    Margin="0,0,10,0"
                                    Focusable="False"
                                    Template="{StaticResource MascotLogoTemplate}" />
                                <TextBlock Style="{StaticResource Text.Section}" Text="Pinguin" />
                            </StackPanel>

                            <Border BorderThickness="0" Style="{StaticResource SettingRow}">
                                <StackPanel>
                                    <CheckBox
                                        Click="PenguinCheckBox_Click"
                                        Content="Pinguin ab und zu hinter der Taskleiste auftauchen lassen"
                                        IsChecked="{Binding PenguinEnabled, Mode=TwoWay}"
                                        Style="{StaticResource Switch}" />
                                    <StackPanel
                                        Margin="0,10,0,0"
                                        IsEnabled="{Binding PenguinEnabled}"
                                        Orientation="Horizontal"
                                        ToolTip="Mindestens 10 Minuten">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Text.Muted}"
                                            Text="Alle" />
                                        <TextBox
                                            Margin="8,0"
                                            Style="{StaticResource NumberBox}"
                                            Text="{Binding PenguinMinDelayMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Text.Muted}"
                                            Text="bis" />
                                        <TextBox
                                            Margin="8,0"
                                            Style="{StaticResource NumberBox}"
                                            Text="{Binding PenguinMaxDelayMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Text.Muted}"
                                            Text="Minuten" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!--  Statistik  -->
                            <Border Style="{StaticResource SettingRow}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Body}" Text="Deine Fangstatistik" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Klick den Pinguin rechtzeitig an, dann wirft er dir einen Fisch zu. Den musst du dann noch erwischen, bevor er runterrutscht." />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Inset}">
                                            <StackPanel Orientation="Horizontal">
                                                <ContentControl
                                                    Width="36"
                                                    Height="36"
                                                    Margin="0,0,12,0"
                                                    Focusable="False"
                                                    Template="{StaticResource MascotLogoTemplate}" />
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource Text.Value}" Text="{Binding PenguinCaughtCount}" />
                                                    <TextBlock Style="{StaticResource Text.Label}" Text="Pinguin gefangen" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource Inset}">
                                            <StackPanel Orientation="Horizontal">
                                                <Image
                                                    Width="40"
                                                    Height="24"
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Center"
                                                    Source="{StaticResource FishIcon}" />
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource Text.Value}" Text="{Binding FishCaughtCount}" />
                                                    <TextBlock Style="{StaticResource Text.Label}" Text="Fisch gefangen" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!--  Datensicherung  -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource CardHeader}">
                                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE8F7;" />
                                <TextBlock Style="{StaticResource Text.Section}" Text="Datensicherung" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button
                                    local:Ui.Glyph="&#xE74E;"
                                    Command="{Binding CreateBackupCommand}"
                                    Content="Sicherung jetzt erstellen"
                                    Style="{StaticResource Button.Primary}" />
                                <Button
                                    Margin="8,0,0,0"
                                    local:Ui.Glyph="&#xE8E5;"
                                    Command="{Binding BrowseBackupCommand}"
                                    Content="Sicherung laden…" />
                            </StackPanel>

                            <TextBlock
                                Margin="0,18,0,6"
                                Style="{StaticResource Text.Label}"
                                Text="Vorhandene Sicherungen" />

                            <ItemsControl ItemsSource="{Binding AvailableBackups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SettingRow}">
                                            <DockPanel>
                                                <Button
                                                    local:Ui.Glyph="&#xE777;"
                                                    Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Wiederherstellen"
                                                    DockPanel.Dock="Right"
                                                    Style="{StaticResource Button.Ghost}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource Text.Body}"
                                                    Text="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm:ss'}" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--  Aktionsleiste: immer sichtbar  -->
        <Border
            Grid.Row="2"
            Padding="28,12"
            Background="{DynamicResource Theme.Card}"
            BorderBrush="{DynamicResource Theme.CardBorder}"
            BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    MinWidth="110"
                    Command="{Binding CancelCommand}"
                    Content="Verwerfen" />
                <Button
                    MinWidth="130"
                    Margin="8,0,0,0"
                    local:Ui.Glyph="&#xE74E;"
                    Command="{Binding SaveCommand}"
                    Content="Speichern"
                    Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
