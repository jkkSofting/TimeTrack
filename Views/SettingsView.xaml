<UserControl
    x:Class="Zeitmanagement.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Zeitmanagement.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:Zeitmanagement.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:SettingsViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Color x:Key="ColCard">#1A2238</Color>
        <Color x:Key="ColText">#F5F7FB</Color>
        <Color x:Key="ColTextMuted">#B7C0D8</Color>

        <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColText}" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColTextMuted}" />
        <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColCard}" />

        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#0B1020" />
            <GradientStop Offset="1" Color="#121A33" />
        </LinearGradientBrush>

        <!--  Card  -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{StaticResource BrushCard}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="18"
                        Opacity="0.4"
                        ShadowDepth="3"
                        Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Flat-Button  -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Background" Value="#2D3A63" />
            <Setter Property="BorderBrush" Value="#42507C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#34406E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Primary Flat-Button (Speichern)  -->
        <Style x:Key="PrimaryFlatButton" BasedOn="{StaticResource FlatButton}" TargetType="Button">
            <Setter Property="Background" Value="#3A7BD5" />
            <Setter Property="BorderBrush" Value="#5B9BE8" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Background" Value="#233055" />
            <Setter Property="BorderBrush" Value="#33406A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border
            Grid.Row="0"
            Margin="16,16,16,8"
            Style="{StaticResource Card}">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource BrushText}"
                Text="Einstellungen" />
        </Border>

        <!--  Body  -->
        <Border
            Grid.Row="1"
            Margin="16,8,16,8"
            Style="{StaticResource Card}"
            VerticalAlignment="Top">
            <StackPanel MaxWidth="480" HorizontalAlignment="Left">
                <CheckBox Content="Mit Windows starten" IsChecked="{Binding AutostartEnabled, Mode=TwoWay}" />

                <TextBlock
                    Margin="2,14,0,4"
                    Foreground="{StaticResource BrushTextMuted}"
                    Text="Programm starten als" />
                <ComboBox
                    ItemsSource="{Binding StartupModeOptions}"
                    SelectedValue="{Binding SelectedStartupMode, Mode=TwoWay}"
                    SelectedValuePath="Value"
                    Style="{StaticResource NiceCombo}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <CheckBox
                    Margin="0,18,0,0"
                    Content="Schnellwechsel-Fenster immer im Vordergrund halten"
                    IsChecked="{Binding FloatingWindowAlwaysOnTop, Mode=TwoWay}" />

                <StackPanel
                    Margin="0,24,0,0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <Button
                        MinWidth="110"
                        Command="{Binding SaveCommand}"
                        Content="Speichern"
                        Style="{StaticResource PrimaryFlatButton}" />
                    <Button
                        MinWidth="110"
                        Margin="8,0,0,0"
                        Command="{Binding CancelCommand}"
                        Content="Verwerfen"
                        Style="{StaticResource FlatButton}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  Automatisierung  -->
        <Border
            Grid.Row="2"
            Margin="16,8,16,8"
            Style="{StaticResource Card}"
            VerticalAlignment="Top">
            <StackPanel MaxWidth="480" HorizontalAlignment="Left">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource BrushText}"
                    Text="Automatisierung" />

                <CheckBox
                    Margin="0,14,0,0"
                    Content="Buchung bei Sperrbildschirm/Ruhemodus automatisch beenden"
                    IsChecked="{Binding AutoStopOnLockEnabled, Mode=TwoWay}" />

                <StackPanel
                    Margin="0,6,0,0"
                    Orientation="Horizontal"
                    IsEnabled="{Binding AutoStopOnLockEnabled}">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{StaticResource BrushTextMuted}"
                        Text="Verzögerung bei Sperrbildschirm (Minuten):" />
                    <TextBox
                        Width="60"
                        Margin="8,0,0,0"
                        Text="{Binding AutoStopOnLockMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <CheckBox
                    Margin="0,18,0,0"
                    Content="Erinnern, wenn kein Projekt ausgewählt ist"
                    IsChecked="{Binding ReminderNudgeEnabled, Mode=TwoWay}" />

                <StackPanel
                    Margin="0,6,0,0"
                    Orientation="Horizontal"
                    IsEnabled="{Binding ReminderNudgeEnabled}">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{StaticResource BrushTextMuted}"
                        Text="Erinnerungsintervall (Minuten):" />
                    <TextBox
                        Width="60"
                        Margin="8,0,0,0"
                        Text="{Binding ReminderNudgeIntervalMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  Updates  -->
        <Border
            Grid.Row="3"
            Margin="16,8,16,8"
            Style="{StaticResource Card}"
            VerticalAlignment="Top">
            <StackPanel MaxWidth="480" HorizontalAlignment="Left">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource BrushText}"
                    Text="Updates" />

                <CheckBox
                    Margin="0,14,0,0"
                    Content="Regelmäßig automatisch nach Updates suchen"
                    IsChecked="{Binding AutoUpdateCheckEnabled, Mode=TwoWay}" />

                <TextBlock
                    Margin="2,14,0,0"
                    Foreground="{StaticResource BrushTextMuted}"
                    Text="{Binding CurrentVersionText, StringFormat='Installierte Version: {0}'}" />

                <TextBlock
                    Margin="2,4,0,0"
                    Foreground="{StaticResource BrushText}"
                    Text="{Binding UpdateStatusText}" />

                <StackPanel
                    Margin="0,14,0,0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <Button
                        MinWidth="170"
                        Command="{Binding CheckForUpdateCommand}"
                        Content="Nach Updates suchen"
                        Style="{StaticResource FlatButton}" />
                    <Button
                        MinWidth="170"
                        Margin="8,0,0,0"
                        Command="{Binding InstallUpdateCommand}"
                        Content="Update installieren"
                        Style="{StaticResource PrimaryFlatButton}"
                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  Backup  -->
        <Border
            Grid.Row="4"
            Margin="16,8,16,16"
            Style="{StaticResource Card}"
            VerticalAlignment="Top">
            <StackPanel MaxWidth="480" HorizontalAlignment="Left">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource BrushText}"
                    Text="Datensicherung" />

                <StackPanel
                    Margin="0,14,0,0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <Button
                        MinWidth="170"
                        Command="{Binding CreateBackupCommand}"
                        Content="Sicherung jetzt erstellen"
                        Style="{StaticResource PrimaryFlatButton}" />
                    <Button
                        MinWidth="170"
                        Margin="8,0,0,0"
                        Command="{Binding BrowseBackupCommand}"
                        Content="Sicherung durchsuchen..."
                        Style="{StaticResource FlatButton}" />
                </StackPanel>

                <TextBlock
                    Margin="2,18,0,4"
                    Foreground="{StaticResource BrushTextMuted}"
                    Text="Vorhandene Sicherungen" />

                <ItemsControl ItemsSource="{Binding AvailableBackups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,6"
                                Padding="10,8"
                                Background="#20294A"
                                BorderBrush="#33406E"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource BrushText}"
                                        Text="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm:ss'}" />
                                    <Button
                                        Grid.Column="1"
                                        MinWidth="110"
                                        Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="Wiederherstellen"
                                        Style="{StaticResource FlatButton}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
