<UserControl
    x:Class="Zeitmanagement.Views.TodoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Zeitmanagement.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:Zeitmanagement.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:TodoViewModel}"
    d:DesignHeight="720"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,14,0,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
        </Style>

        <!--  Ein Ticket: Karte mit Titel und (gekürzter) Beschreibung  -->
        <Style x:Key="TicketCard" TargetType="Border">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="{DynamicResource Theme.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.TextSubtle}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            Die Wurzel jedes Tickets (Karte samt Abstand darunter) nimmt die Maus- und Ziehereignisse entgegen, damit
            auch der Abstand zwischen zwei Karten ein gültiges Ziel ist. Die Marke zeigt, wo das Ticket landet.
        -->
        <DataTemplate x:Key="TicketTemplate" DataType="{x:Type viewmodel:TodoTicketViewModel}">
            <Grid
                Background="Transparent"
                AllowDrop="True"
                DragOver="Ticket_DragOver"
                Drop="Ticket_Drop"
                MouseLeftButtonUp="Ticket_MouseLeftButtonUp"
                PreviewMouseLeftButtonDown="Ticket_PreviewMouseLeftButtonDown"
                PreviewMouseMove="Ticket_PreviewMouseMove">
                <Border Style="{StaticResource TicketCard}">
                    <StackPanel>
                        <TextBlock
                            FontWeight="SemiBold"
                            Style="{StaticResource Text.Body}"
                            Text="{Binding Title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            MaxHeight="54"
                            FontSize="12"
                            Foreground="{DynamicResource Theme.TextMuted}"
                            Text="{Binding Description}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
                <Rectangle
                    x:Name="markAbove"
                    Height="3"
                    Margin="0,-6,0,0"
                    VerticalAlignment="Top"
                    Fill="{DynamicResource Theme.Accent}"
                    IsHitTestVisible="False"
                    RadiusX="1.5"
                    RadiusY="1.5"
                    Visibility="Collapsed" />
                <Rectangle
                    x:Name="markBelow"
                    Height="3"
                    Margin="0,0,0,2"
                    VerticalAlignment="Bottom"
                    Fill="{DynamicResource Theme.Accent}"
                    IsHitTestVisible="False"
                    RadiusX="1.5"
                    RadiusY="1.5"
                    Visibility="Collapsed" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDropAbove}" Value="True">
                    <Setter TargetName="markAbove" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDropBelow}" Value="True">
                    <Setter TargetName="markBelow" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Eine Spalte: Kopf mit Name und Anzahl, Tickets, „Ticket hinzufügen“  -->
        <DataTemplate x:Key="ColumnTemplate" DataType="{x:Type viewmodel:TodoColumnViewModel}">
            <Border
                x:Name="columnBorder"
                Width="300"
                Margin="0,0,14,0"
                Padding="12,10,12,10"
                AllowDrop="True"
                DragLeave="Column_DragLeave"
                DragOver="Column_DragOver"
                Drop="Column_Drop"
                Style="{StaticResource Inset}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="2,0,0,8">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Right"
                            FontSize="13"
                            Foreground="{DynamicResource Theme.TextMuted}"
                            Style="{StaticResource Text.Icon}"
                            Text="&#xE945;"
                            ToolTip="Die Tickets dieser Spalte sind im Quick Switch wählbar."
                            Visibility="{Binding QuickSwitch, Converter={StaticResource BoolToVis}}" />
                        <Button
                            Width="28"
                            Height="28"
                            local:Ui.Glyph="&#xE74D;"
                            Command="{Binding DeleteCommand}"
                            CommandParameter="{Binding}"
                            DockPanel.Dock="Right"
                            Style="{StaticResource Button.IconGhost}"
                            ToolTip="Spalte löschen" />
                        <Button
                            Width="28"
                            Height="28"
                            local:Ui.Glyph="&#xE70F;"
                            Command="{Binding EditCommand}"
                            CommandParameter="{Binding}"
                            DockPanel.Dock="Right"
                            Style="{StaticResource Button.IconGhost}"
                            ToolTip="Spalte umbenennen oder verschieben" />
                        <Border
                            Margin="0,0,6,0"
                            Padding="8,1"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Theme.AccentSoft}"
                            CornerRadius="10"
                            DockPanel.Dock="Right">
                            <TextBlock
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Theme.AccentSoftText}"
                                Text="{Binding TicketCountText}" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Style="{StaticResource Text.Section}"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl
                            Margin="0,6,0,0"
                            Focusable="False"
                            ItemTemplate="{StaticResource TicketTemplate}"
                            ItemsSource="{Binding Tickets}" />
                    </ScrollViewer>

                    <Button
                        Grid.Row="2"
                        Margin="0,6,0,0"
                        HorizontalContentAlignment="Left"
                        local:Ui.Glyph="&#xE710;"
                        Command="{Binding AddTicketCommand}"
                        CommandParameter="{Binding}"
                        Content="Ticket hinzufügen"
                        Style="{StaticResource Button.Ghost}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter TargetName="columnBorder" Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                    <Setter TargetName="columnBorder" Property="Background" Value="{DynamicResource Theme.SurfaceHover}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Abdunkelung hinter Ticket- und Spalten-Editor  -->
        <SolidColorBrush x:Key="Scrim" Color="#99000000" />
    </UserControl.Resources>

    <Grid Style="{StaticResource Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Style="{StaticResource PageHeader}">
            <StackPanel
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Text.Muted}"
                    Text="Board von" />
                <ComboBox
                    Width="260"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="Projekt, dessen Board angezeigt wird"
                    ItemsSource="{Binding ProjectOptions}"
                    SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                    ToolTip="Jedes Projekt hat sein eigenes Board. „Ohne Projekt“ ist für alles, was zu keinem Projekt gehört." />
                <Button
                    local:Ui.Glyph="&#xE72C;"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Aktualisieren" />
                <Button
                    Margin="8,0,0,0"
                    local:Ui.Glyph="&#xE710;"
                    Command="{Binding AddColumnCommand}"
                    Content="Neue Spalte"
                    Style="{StaticResource Button.Primary}" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="To-Do" />
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="{Binding HeaderSubtitle}" />
            </StackPanel>
        </DockPanel>

        <!--  Das Board: Spalten nebeneinander, bei Bedarf seitlich scrollbar  -->
        <ScrollViewer
            Grid.Row="1"
            Margin="28,0,14,24"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal">
                <ItemsControl
                    Focusable="False"
                    ItemTemplate="{StaticResource ColumnTemplate}"
                    ItemsSource="{Binding Columns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!--  Spalte am Ende des Boards anlegen  -->
                <Button
                    Width="300"
                    Margin="0,0,14,0"
                    VerticalAlignment="Top"
                    HorizontalContentAlignment="Left"
                    local:Ui.Glyph="&#xE710;"
                    Command="{Binding AddColumnCommand}"
                    Content="Spalte hinzufügen"
                    Style="{StaticResource Button.Secondary}" />
            </StackPanel>
        </ScrollViewer>

        <!--  Hinweis, solange das Board keine Spalte hat  -->
        <TextBlock
            Grid.Row="1"
            Margin="28,0,28,24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="Das Board hat keine Spalten. Lege oben mit „Neue Spalte“ die erste an.">
            <TextBlock.Style>
                <Style BasedOn="{StaticResource Text.Muted}" TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasColumns}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!--  ===== Ticket anlegen / bearbeiten =====  -->
        <Grid
            x:Name="TicketEditor"
            Grid.RowSpan="2"
            Background="{StaticResource Scrim}"
            IsVisibleChanged="TicketEditor_IsVisibleChanged"
            Visibility="{Binding IsTicketEditorOpen, Converter={StaticResource BoolToVis}}">
            <Grid.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CancelTicketCommand}" />
                <KeyBinding
                    Command="{Binding SaveTicketCommand}"
                    Gesture="Ctrl+Return" />
            </Grid.InputBindings>
            <Border
                Width="540"
                MaxWidth="540"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24"
                Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.PageTitle}" FontSize="20" Text="{Binding TicketEditorTitle}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Titel" />
                    <TextBox
                        x:Name="TicketTitleBox"
                        MaxLength="200"
                        local:Ui.Placeholder="Was ist zu tun?"
                        Text="{Binding TicketTitle, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Beschreibung" />
                    <TextBox
                        MinHeight="150"
                        MaxHeight="280"
                        AcceptsReturn="True"
                        local:Ui.Placeholder="Details, Notizen, Links …"
                        Text="{Binding TicketDescription, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        VerticalContentAlignment="Top" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Spalte" />
                    <ComboBox
                        AutomationProperties.Name="Spalte des Tickets"
                        ItemsSource="{Binding Columns}"
                        SelectedItem="{Binding SelectedTicketColumn, Mode=TwoWay}" />

                    <DockPanel Margin="0,20,0,0">
                        <Button
                            local:Ui.Glyph="&#xE74D;"
                            Command="{Binding DeleteTicketCommand}"
                            Content="Löschen"
                            DockPanel.Dock="Left"
                            Style="{StaticResource Button.Danger}"
                            Visibility="{Binding IsEditingTicket, Converter={StaticResource BoolToVis}}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button
                                Command="{Binding CancelTicketCommand}"
                                Content="Abbrechen"
                                Style="{StaticResource Button.Ghost}" />
                            <Button
                                Margin="8,0,0,0"
                                Command="{Binding SaveTicketCommand}"
                                Content="Speichern"
                                Style="{StaticResource Button.Primary}"
                                ToolTip="Strg+Enter" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!--  ===== Spalte anlegen / bearbeiten =====  -->
        <Grid
            x:Name="ColumnEditor"
            Grid.RowSpan="2"
            Background="{StaticResource Scrim}"
            IsVisibleChanged="ColumnEditor_IsVisibleChanged"
            Visibility="{Binding IsColumnEditorOpen, Converter={StaticResource BoolToVis}}">
            <Grid.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CancelColumnCommand}" />
                <KeyBinding Key="Return" Command="{Binding SaveColumnCommand}" />
            </Grid.InputBindings>
            <Border
                Width="420"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24"
                Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.PageTitle}" FontSize="20" Text="{Binding ColumnEditorTitle}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                    <TextBox
                        x:Name="ColumnNameBox"
                        MaxLength="60"
                        local:Ui.Placeholder="z. B. Warten auf Antwort"
                        Text="{Binding ColumnName, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox
                        Margin="0,14,0,0"
                        Content="Tickets im Quick Switch anbieten"
                        IsChecked="{Binding ColumnQuickSwitch, Mode=TwoWay}"
                        Visibility="{Binding IsProjectBoard, Converter={StaticResource BoolToVis}}"
                        ToolTip="Ein: Die Tickets dieser Spalte lassen sich im Quick Switch (Modus „Tickets“) wählen und werden auf das Projekt dieses Boards gebucht. Aus: Sie erscheinen dort nicht." />

                    <StackPanel
                        Margin="0,14,0,0"
                        Orientation="Horizontal"
                        Visibility="{Binding IsEditingColumn, Converter={StaticResource BoolToVis}}">
                        <Button
                            local:Ui.Glyph="&#xE76B;"
                            Command="{Binding MoveColumnLeftCommand}"
                            Content="Nach links"
                            ToolTip="Spalte eine Stelle nach links schieben" />
                        <Button
                            Margin="8,0,0,0"
                            local:Ui.Glyph="&#xE76C;"
                            Command="{Binding MoveColumnRightCommand}"
                            Content="Nach rechts"
                            ToolTip="Spalte eine Stelle nach rechts schieben" />
                    </StackPanel>

                    <DockPanel Margin="0,20,0,0">
                        <Button
                            local:Ui.Glyph="&#xE74D;"
                            Command="{Binding DeleteColumnCommand}"
                            Content="Löschen"
                            DockPanel.Dock="Left"
                            Style="{StaticResource Button.Danger}"
                            ToolTip="Spalte samt ihren Tickets löschen (mit Rückfrage)"
                            Visibility="{Binding IsEditingColumn, Converter={StaticResource BoolToVis}}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button
                                Command="{Binding CancelColumnCommand}"
                                Content="Abbrechen"
                                Style="{StaticResource Button.Ghost}" />
                            <Button
                                Margin="8,0,0,0"
                                Command="{Binding SaveColumnCommand}"
                                Content="Speichern"
                                Style="{StaticResource Button.Primary}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
