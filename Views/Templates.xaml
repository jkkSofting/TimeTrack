<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Zeitmanagement.Views"
    xmlns:vm="clr-namespace:Zeitmanagement.ViewModel">
    <!--  Implizite Templates: WPF rendert diese automatisch im ContentControl  -->
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <views:DashboardView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ProjectsViewModel}">
        <views:ProjectsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:EntriesViewModel}">
        <views:EntriesView />
    </DataTemplate>
</ResourceDictionary>