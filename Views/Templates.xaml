<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Zeitmanagement.Views"
    xmlns:vm="clr-namespace:Zeitmanagement.ViewModel">
    <!--  Implizite Templates: WPF rendert diese automatisch im ContentControl  -->
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <views:DashboardView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ProjectsViewModel}">
        <views:ProjectsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:EntriesViewModel}">
        <views:EntriesView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:FragmentationViewModel}">
        <views:FragmentationView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SapBookingViewModel}">
        <views:SapBookingView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ProjectControllingViewModel}">
        <views:ProjectControllingView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ExportViewModel}">
        <views:ExportView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:HelpViewModel}">
        <views:HelpView />
    </DataTemplate>

    <!--  Seite eines Plugins: die vom Plugin gelieferte Ansicht, über Besuche hinweg dieselbe Instanz  -->
    <DataTemplate DataType="{x:Type vm:PluginPageViewModel}">
        <views:PluginViewHost View="{Binding View}" />
    </DataTemplate>
</ResourceDictionary>