<UserControl
    x:Class="Zeitmanagement.Views.ExportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Zeitmanagement.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:Zeitmanagement.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:ExportViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="1300"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Kleine Beschriftung über einer Gruppe von Einstellungen  -->
        <Style
            x:Key="FieldLabel"
            BasedOn="{StaticResource Text.Label}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="2,14,0,6" />
        </Style>

        <!--  Gemeinsame Umrandung für Umschalter aus mehreren Segmenten  -->
        <Style x:Key="SegmentBar" TargetType="Border">
            <Setter Property="Padding" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  Auf dem App-weiten CheckBox-Style aufbauen, sonst fehlt dem Kästchen sein Template  -->
        <Style
            x:Key="OptionCheck"
            BasedOn="{StaticResource {x:Type CheckBox}}"
            TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="RightText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="TrimmedText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>

        <!--  Buchungen, die in einer Warnung stehen (z. B. ohne Beschreibung), sind hinterlegt  -->
        <Style
            x:Key="PreviewRow"
            BasedOn="{StaticResource {x:Type DataGridRow}}"
            TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasIssue}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Theme.WarningSoft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Kopf: Titel links, Export rechts  -->
        <DockPanel Style="{StaticResource PageHeader}">
            <StackPanel
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <Button
                    local:Ui.Glyph="&#xE890;"
                    Command="{Binding PreviewPdfCommand}"
                    Content="PDF-Vorschau"
                    Style="{StaticResource Button.Ghost}"
                    ToolTip="Erzeugt das PDF als temporäre Datei und öffnet es, ohne zu speichern. So prüfst du das Aussehen." />
                <Button
                    Margin="8,0,0,0"
                    local:Ui.Glyph="&#xE8A9;"
                    Command="{Binding ExportCsvCommand}"
                    Content="CSV speichern"
                    ToolTip="Eine Zeile je Buchung, für Excel und Abrechnung. UTF-8 mit Umlauten, Semikolon als Trenner." />
                <Button
                    Margin="8,0,0,0"
                    local:Ui.Glyph="&#xE8A5;"
                    Command="{Binding ExportPdfCommand}"
                    Content="PDF speichern"
                    Style="{StaticResource Button.Primary}"
                    ToolTip="Tätigkeitsnachweis als PDF, zum Ablegen oder Versenden" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="Tätigkeitsnachweis" />
                <TextBlock
                    Style="{StaticResource Text.Subtitle}"
                    Text="Buchungen eines Projekts und Zeitraums als PDF oder CSV exportieren, als Nachweis oder für die Abrechnung."
                    TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="28,0,28,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ===== Auswahl und Optionen =====  -->
            <ScrollViewer
                Grid.Column="0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">

                    <!--  Zeitraum  -->
                    <Border Margin="0,0,0,12" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Section}" Text="Zeitraum" />
                            <ComboBox
                                Margin="0,12,0,0"
                                AutomationProperties.Name="Schnellwahl für den Zeitraum"
                                DisplayMemberPath="Text"
                                ItemsSource="{Binding Presets}"
                                SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <DatePicker AutomationProperties.Name="Von" SelectedDate="{Binding From, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Text.Muted}"
                                    Text="–" />
                                <DatePicker
                                    Grid.Column="2"
                                    AutomationProperties.Name="Bis"
                                    SelectedDate="{Binding To, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource Theme.Danger}"
                                Text="{Binding RangeError}"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasRangeError, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!--  Projekte  -->
                    <Border Margin="0,0,0,12" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Hint}"
                                    Text="{Binding ProjectSelectionText}" />
                                <TextBlock Style="{StaticResource Text.Section}" Text="Projekte" />
                            </DockPanel>

                            <Grid Margin="0,12,0,0">
                                <TextBox
                                    Padding="32,7,8,7"
                                    local:Ui.Placeholder="Suchen nach Name, Kunde, Kostenträger"
                                    AutomationProperties.Name="Projekte suchen"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Margin="11,0,0,0"
                                    HorizontalAlignment="Left"
                                    FontSize="13"
                                    Foreground="{DynamicResource Theme.TextSubtle}"
                                    IsHitTestVisible="False"
                                    Style="{StaticResource Text.Icon}"
                                    Text="&#xE721;" />
                            </Grid>

                            <ComboBox
                                Margin="0,8,0,0"
                                AutomationProperties.Name="Nach Kunde filtern"
                                ItemsSource="{Binding Customers}"
                                SelectedItem="{Binding CustomerFilter, Mode=TwoWay}" />

                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                <Button
                                    Command="{Binding SelectAllVisibleCommand}"
                                    Content="Alle gezeigten wählen"
                                    ToolTip="Wählt alle Projekte, die gerade in der Liste stehen (nach Suche und Kunde)" />
                                <Button
                                    Margin="6,0,0,0"
                                    Command="{Binding ClearSelectionCommand}"
                                    Content="Auswahl leeren"
                                    Style="{StaticResource Button.Ghost}" />
                            </StackPanel>

                            <Border
                                Margin="0,10,0,0"
                                Padding="6"
                                Style="{StaticResource Inset}">
                                <ScrollViewer
                                    MaxHeight="250"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ProjectsView}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Margin="2,4" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}">
                                                    <StackPanel>
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Style="{StaticResource Text.Body}"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Style="{StaticResource Text.Muted}"
                                                            Text="{Binding Detail}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{DynamicResource Theme.TextSubtle}"
                                                            Text="{Binding Stats}" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="ART DER PROJEKTE" />
                            <Border Style="{StaticResource SegmentBar}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton
                                        Content="Alle"
                                        GroupName="ExportKind"
                                        IsChecked="{Binding IsKindAll, Mode=TwoWay}"
                                        Style="{StaticResource Segment}" />
                                    <RadioButton
                                        Content="Extern"
                                        GroupName="ExportKind"
                                        IsChecked="{Binding IsKindExternal, Mode=TwoWay}"
                                        Style="{StaticResource Segment}"
                                        ToolTip="Nur Projekte, die der Kunde bezahlt" />
                                    <RadioButton
                                        Content="Intern"
                                        GroupName="ExportKind"
                                        IsChecked="{Binding IsKindInternal, Mode=TwoWay}"
                                        Style="{StaticResource Segment}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!--  Inhalt  -->
                    <Border Margin="0,0,0,12" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Section}" Text="Inhalt" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="GLIEDERUNG" />
                            <Border Style="{StaticResource SegmentBar}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton
                                        Content="Nach Tag"
                                        GroupName="ExportGrouping"
                                        IsChecked="{Binding IsGroupByDay, Mode=TwoWay}"
                                        Style="{StaticResource Segment}"
                                        ToolTip="Chronologisch, Tagessumme bei mehreren Buchungen am Tag" />
                                    <RadioButton
                                        Content="Nach Projekt"
                                        GroupName="ExportGrouping"
                                        IsChecked="{Binding IsGroupByProject, Mode=TwoWay}"
                                        Style="{StaticResource Segment}"
                                        ToolTip="Ein Abschnitt je Projekt mit Zwischensumme" />
                                    <RadioButton
                                        Content="Nach Woche"
                                        GroupName="ExportGrouping"
                                        IsChecked="{Binding IsGroupByWeek, Mode=TwoWay}"
                                        Style="{StaticResource Segment}"
                                        ToolTip="Ein Abschnitt je Kalenderwoche mit Zwischensumme" />
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="DAUER ANZEIGEN ALS" />
                            <Border Style="{StaticResource SegmentBar}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton
                                        Content="Dezimal"
                                        GroupName="ExportDuration"
                                        IsChecked="{Binding IsDurationDecimal, Mode=TwoWay}"
                                        Style="{StaticResource Segment}"
                                        ToolTip="z. B. 1,50" />
                                    <RadioButton
                                        Content="h:mm"
                                        GroupName="ExportDuration"
                                        IsChecked="{Binding IsDurationClock, Mode=TwoWay}"
                                        Style="{StaticResource Segment}"
                                        ToolTip="z. B. 1:30" />
                                    <RadioButton
                                        Content="Beides"
                                        GroupName="ExportDuration"
                                        IsChecked="{Binding IsDurationBoth, Mode=TwoWay}"
                                        Style="{StaticResource Segment}"
                                        ToolTip="z. B. 1,50 (1:30)" />
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="RUNDUNG" />
                            <ComboBox
                                AutomationProperties.Name="Dauer je Buchung runden"
                                DisplayMemberPath="Text"
                                ItemsSource="{Binding RoundingChoices}"
                                SelectedItem="{Binding SelectedRounding, Mode=TwoWay}"
                                ToolTip="Rundet die Dauer jeder Buchung kaufmännisch. Im Dokument steht dann ein Hinweis mit der ungerundeten Summe." />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="SPALTEN" />
                            <CheckBox
                                Content="Uhrzeiten (Von – Bis) zeigen"
                                IsChecked="{Binding ShowTimes}"
                                Style="{StaticResource OptionCheck}"
                                ToolTip="Aus: Der Nachweis nennt nur die Dauer, nicht die Uhrzeiten." />
                            <CheckBox
                                Content="Projekt-Spalte auch bei nur einem Projekt"
                                IsChecked="{Binding AlwaysShowProjectColumn}"
                                Style="{StaticResource OptionCheck}"
                                ToolTip="Bei mehreren Projekten erscheint die Spalte automatisch." />
                            <CheckBox
                                Content="Kostenträger-Spalte zeigen"
                                IsChecked="{Binding ShowCarrierColumn}"
                                Style="{StaticResource OptionCheck}" />
                            <CheckBox
                                Content="Tagessumme zeigen"
                                IsChecked="{Binding ShowDaySubtotals}"
                                IsEnabled="{Binding IsGroupByDay}"
                                Style="{StaticResource OptionCheck}"
                                ToolTip="Bei „Nach Tag“: unter Tagen mit mehreren Buchungen steht die Summe des Tages. Bei den anderen Gliederungen gibt es sie nicht." />
                        </StackPanel>
                    </Border>

                    <!--  Dokument  -->
                    <Border Margin="0,0,0,12" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Section}" Text="Dokument" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="TITEL" />
                            <TextBox AutomationProperties.Name="Titel des Dokuments" Text="{Binding Title}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="BEMERKUNG" />
                            <TextBox
                                MinHeight="64"
                                Padding="8,7"
                                VerticalContentAlignment="Top"
                                local:Ui.Placeholder="Steht unter dem Einzelnachweis (optional)"
                                AcceptsReturn="True"
                                AutomationProperties.Name="Bemerkung"
                                Text="{Binding Note}"
                                TextWrapping="Wrap" />

                            <CheckBox
                                Margin="0,12,0,0"
                                Content="Querformat"
                                IsChecked="{Binding Landscape}"
                                Style="{StaticResource OptionCheck}" />
                            <CheckBox
                                Content="„Erstellt mit TimeTrack“ in der Fußzeile"
                                IsChecked="{Binding ShowBranding}"
                                Style="{StaticResource OptionCheck}" />

                            <Button
                                Margin="0,14,0,0"
                                HorizontalAlignment="Left"
                                local:Ui.Glyph="&#xE70F;"
                                Command="{Binding ToggleMetaPanelCommand}"
                                Content="Auftragnehmer &amp; Auftraggeber"
                                ToolTip="Wer den Nachweis ausstellt und für wen" />

                            <Border
                                Margin="0,10,0,0"
                                Style="{StaticResource Inset}"
                                Visibility="{Binding IsMetaPanelOpen, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock
                                        Margin="2,0,0,5"
                                        Style="{StaticResource Text.Label}"
                                        Text="AUFTRAGNEHMER (DU)" />
                                    <TextBox
                                        MinHeight="84"
                                        VerticalContentAlignment="Top"
                                        local:Ui.Placeholder="Name, Firma, Anschrift, Kontakt – eine Zeile je Angabe"
                                        AcceptsReturn="True"
                                        AutomationProperties.Name="Auftragnehmer"
                                        Text="{Binding IssuerBlock}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="2,4,0,0"
                                        Style="{StaticResource Hint}"
                                        Text="Die erste Zeile steht fett. Die Angabe bleibt für den nächsten Nachweis gespeichert." />

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="AUFTRAGGEBER" />
                                    <TextBox
                                        local:Ui.Placeholder="Name des Auftraggebers"
                                        AutomationProperties.Name="Name des Auftraggebers"
                                        Text="{Binding ClientName}" />
                                    <TextBox
                                        Margin="0,6,0,0"
                                        MinHeight="64"
                                        VerticalContentAlignment="Top"
                                        local:Ui.Placeholder="Anschrift, Ansprechpartner (optional)"
                                        AcceptsReturn="True"
                                        AutomationProperties.Name="Anschrift des Auftraggebers"
                                        Text="{Binding ClientBlock}"
                                        TextWrapping="Wrap" />

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="AUFTRAGS- / BESTELLNUMMER" />
                                    <TextBox
                                        local:Ui.Placeholder="optional"
                                        AutomationProperties.Name="Auftrags- oder Bestellnummer"
                                        Text="{Binding ReferenceNumber}" />
                                    <TextBlock
                                        Margin="2,4,0,0"
                                        Style="{StaticResource Hint}"
                                        Text="Nummer und Auftraggeber merkt sich TimeTrack für das Projekt, wenn du genau ein Projekt exportierst." />

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="LOGO (OPTIONAL)" />
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Command="{Binding ChooseLogoCommand}" Content="Wählen …" />
                                            <Button
                                                Margin="6,0,0,0"
                                                Command="{Binding RemoveLogoCommand}"
                                                Content="Entfernen"
                                                Style="{StaticResource Button.Ghost}" />
                                        </StackPanel>
                                        <TextBlock
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Text.Muted}"
                                            Text="{Binding LogoText}"
                                            TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock
                                        Margin="2,4,0,0"
                                        Style="{StaticResource Hint}"
                                        Text="PNG oder JPEG, erscheint oben rechts im PDF. Die Datei bleibt, wo sie ist." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!--  CSV  -->
                    <Border Margin="0,0,0,4" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Section}" Text="CSV" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource Hint}"
                                Text="Standard: Semikolon als Trenner und Dezimalkomma, wie es das deutsche Excel erwartet." />
                            <CheckBox
                                Content="International (Komma als Trenner, Dezimalpunkt)"
                                IsChecked="{Binding CsvInternational}"
                                Style="{StaticResource OptionCheck}" />
                            <CheckBox
                                Content="Datum als JJJJ-MM-TT"
                                IsChecked="{Binding CsvIsoDates}"
                                Style="{StaticResource OptionCheck}" />
                            <CheckBox
                                Content="Summenzeile am Ende"
                                IsChecked="{Binding CsvTotalRow}"
                                Style="{StaticResource OptionCheck}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!--  ===== Vorschau: was exportiert wird =====  -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Top"
                        Style="{StaticResource Text.Section}"
                        Text="Das wird exportiert" />

                    <!--  Kennzahlen  -->
                    <UniformGrid
                        Margin="0,12,0,0"
                        Columns="4"
                        DockPanel.Dock="Top">
                        <Border Margin="0,0,8,0" Style="{StaticResource Inset}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Label}" Text="Gesamtzeit" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Theme.Text}"
                                    Text="{Binding TotalText}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,8,0" Style="{StaticResource Inset}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Label}" Text="Buchungen" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Theme.Text}"
                                    Text="{Binding EntryCountText}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,8,0" Style="{StaticResource Inset}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Label}" Text="Arbeitstage" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Theme.Text}"
                                    Text="{Binding WorkDaysText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Inset}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Label}" Text="Ø pro Arbeitstag" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Theme.Text}"
                                    Text="{Binding AverageText}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!--  Ergebnis des letzten Exports  -->
                    <Border
                        Margin="0,12,0,0"
                        Background="{DynamicResource Theme.AccentSoft}"
                        BorderBrush="{DynamicResource Theme.Accent}"
                        DockPanel.Dock="Top"
                        Style="{StaticResource Inset}"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <StackPanel
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Orientation="Horizontal">
                                <Button
                                    Command="{Binding OpenResultCommand}"
                                    Content="Öffnen"
                                    Style="{StaticResource Button.Primary}" />
                                <Button
                                    Margin="6,0,0,0"
                                    Command="{Binding ShowResultInFolderCommand}"
                                    Content="Im Ordner zeigen" />
                            </StackPanel>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Theme.AccentSoftText}"
                                Text="{Binding ResultMessage}"
                                TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>

                    <TextBlock
                        Margin="0,10,0,0"
                        DockPanel.Dock="Top"
                        Style="{StaticResource Text.Muted}"
                        Text="Wird erstellt …"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                    <!--  Prüfungen  -->
                    <Border
                        Margin="0,12,0,0"
                        DockPanel.Dock="Top"
                        Style="{StaticResource Inset}"
                        Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="Mark"
                                            Margin="0,1,8,0"
                                            VerticalAlignment="Top"
                                            FontSize="13"
                                            Foreground="{DynamicResource Theme.TextMuted}"
                                            Style="{StaticResource Text.Icon}"
                                            Text="&#xE946;" />
                                        <TextBlock
                                            x:Name="Message"
                                            Grid.Column="1"
                                            FontSize="13"
                                            Foreground="{DynamicResource Theme.TextMuted}"
                                            Text="{Binding Message}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                            <Setter TargetName="Mark" Property="Text" Value="&#xE7BA;" />
                                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Theme.Warning}" />
                                            <Setter TargetName="Message" Property="Foreground" Value="{DynamicResource Theme.Text}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!--  Die Buchungen, wie sie im Nachweis stehen  -->
                    <Grid Margin="0,12,0,0">
                        <DataGrid
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            ItemsSource="{Binding PreviewRows}"
                            RowHeight="34"
                            RowStyle="{StaticResource PreviewRow}"
                            Visibility="{Binding HasEntries, Converter={StaticResource BoolToVis}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="130"
                                    Binding="{Binding DateText}"
                                    Header="Datum" />
                                <DataGridTextColumn
                                    Width="120"
                                    Binding="{Binding TimeText}"
                                    Header="Zeit" />
                                <DataGridTextColumn
                                    Width="110"
                                    Binding="{Binding DurationText}"
                                    ElementStyle="{StaticResource RightText}"
                                    Header="Dauer" />
                                <DataGridTextColumn
                                    Width="1.2*"
                                    Binding="{Binding Project}"
                                    ElementStyle="{StaticResource TrimmedText}"
                                    Header="Projekt" />
                                <DataGridTextColumn
                                    Width="3*"
                                    Binding="{Binding Description}"
                                    ElementStyle="{StaticResource TrimmedText}"
                                    Header="Tätigkeit" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock
                            MaxWidth="460"
                            Margin="0,40,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Style="{StaticResource Text.Muted}"
                            Text="{Binding PreviewHint}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasPreviewHint, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
