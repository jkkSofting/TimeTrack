                <GeometryDrawing Geometry="M 20,22 A 20,20 0 1 1 60,22 A 20,20 0 1 1 20,22 Z" Pen="{StaticResource ThrowItemPen.Football}" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--  WerderBremen: derselbe Fussball mit gruenem Ring (#1D9053)  -->
    <DrawingImage x:Key="ThrowItem.WerderBremen" po:Freeze="True">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource ThrowItemFrame}" />
                <GeometryDrawing Brush="{StaticResource ThrowItemBrush.Football}" Geometry="M 20,22 A 20,20 0 1 1 60,22 A 20,20 0 1 1 20,22 Z" />
                <DrawingGroup>
                    <DrawingGroup.ClipGeometry>
                        <EllipseGeometry
                            Center="40,22"
                            RadiusX="19.6"
                            RadiusY="19.6" />
