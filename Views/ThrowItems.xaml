                            RadiusX="19.6"
                            RadiusY="19.6" />
                    </DrawingGroup.ClipGeometry>
                    <GeometryDrawing Geometry="M 40,15 L 40,10.5 M 46.66,19.84 L 50.94,18.45 M 44.11,27.66 L 46.76,31.3 M 35.89,27.66 L 33.24,31.3 M 33.34,19.84 L 29.06,18.45" Pen="{StaticResource ThrowItemPen.Football}" />
                    <GeometryDrawing Brush="#22252B" Geometry="M 40,15 L 46.66,19.84 L 44.11,27.66 L 35.89,27.66 L 33.34,19.84 Z M 40,10.5 L 34.29,6.35 L 36.47,-0.35 L 43.53,-0.35 L 45.71,6.35 Z M 50.94,18.45 L 53.12,11.74 L 60.17,11.74 L 62.35,18.45 L 56.64,22.59 Z M 46.76,31.3 L 53.81,31.3 L 55.99,37.01 L 50.29,42.16 L 44.58,38.01 Z M 33.24,31.3 L 26.19,31.3 L 24.01,37.01 L 29.71,42.16 L 35.42,38.01 Z M 29.06,18.45 L 26.88,11.74 L 19.83,11.74 L 17.65,18.45 L 23.36,22.59 Z" />
                </DrawingGroup>
