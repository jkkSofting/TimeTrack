<UserControl
    x:Class="Zeitmanagement.Views.EntriesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Zeitmanagement.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:Zeitmanagement.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:EntriesViewModel}"
    d:DesignHeight="720"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:DecimalHoursToHHmmConverter x:Key="HoursToHHmm" />

        <!--  Zeile einer Zusammenfassung (Name, Anzahl Buchungen, Stunden)  -->
        <DataTemplate x:Key="SummaryRowTemplate">
            <Border
                Padding="0,10"
                BorderBrush="{DynamicResource Theme.Divider}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            FontWeight="SemiBold"
                            Style="{StaticResource Text.Body}"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding Name}" />
                        <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Count, StringFormat='{}{0} Buchungen'}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Theme.Text}"
                        Text="{Binding Hours, Converter={StaticResource HoursToHHmm}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!--  Kennzahl-Kapsel im Kopf; Farbvarianten über Background/Foreground  -->
        <Style
            x:Key="KpiPill"
            BasedOn="{StaticResource Pill}"
            TargetType="Border">
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,0,0,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Kopf: Titel links, Tagesnavigation rechts  -->
        <DockPanel Style="{StaticResource PageHeader}">
            <StackPanel
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <Button
                    local:Ui.Glyph="&#xE76B;"
                    Command="{Binding GoToLastDayCommand}"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Vorheriger Tag" />
                <TextBox
                    Width="110"
                    Margin="6,0"
                    Text="{Binding SelectedDate, UpdateSourceTrigger=PropertyChanged}"
                    TextAlignment="Center"
                    ToolTip="Datum (TT.MM.JJJJ)" />
                <Button
                    local:Ui.Glyph="&#xE76C;"
                    Command="{Binding GoToNextDayCommand}"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Nächster Tag" />
                <Button
                    Margin="8,0,0,0"
                    Command="{Binding TodayCommand}"
                    Content="Heute" />
                <Button
                    Margin="8,0,0,0"
                    local:Ui.Glyph="&#xE72C;"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Aktualisieren" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="Stundenbuchung" />
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="{Binding HeaderSubtitle}" />
            </StackPanel>
        </DockPanel>

        <!--  Kennzahlen des Tages  -->
        <WrapPanel Grid.Row="1" Margin="28,0,28,8">
            <Border Style="{StaticResource KpiPill}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Muted}" Text="Heute " />
                    <TextBlock
                        FontWeight="SemiBold"
                        Style="{StaticResource Text.Body}"
                        Text="{Binding TodayTotalHours, Converter={StaticResource HoursToHHmm}}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding TodayEntryCount, StringFormat='{} · {0} Buchungen'}" />
                </StackPanel>
            </Border>

            <!--  Beginn der ersten bis Ende der letzten Buchung, wie gebucht  -->
            <Border
                Style="{StaticResource KpiPill}"
                ToolTip="Beginn der ersten und Ende der letzten Buchung des Tages, wie gebucht. In Klammern: real gearbeitete Zeit (ohne Pausen, parallele Buchungen nur einmal gezählt)."
                Visibility="{Binding HasWorkDay, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Muted}" Text="Arbeitstag " />
                    <TextBlock
                        FontWeight="SemiBold"
                        Style="{StaticResource Text.Body}"
                        Text="{Binding WorkDayStart}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Text=" – " />
                    <TextBlock
                        FontWeight="SemiBold"
                        Style="{StaticResource Text.Body}"
                        Text="{Binding WorkDayEnd}" />
                    <TextBlock
                        Margin="6,0,0,0"
                        Style="{StaticResource Text.Muted}"
                        Text="{Binding WorkDayReal, StringFormat={}({0} real)}" />
                </StackPanel>
            </Border>

            <!--  Summe der Lücken zwischen Buchungen  -->
            <Border
                Background="{DynamicResource Theme.WarningSoft}"
                BorderBrush="Transparent"
                Style="{StaticResource KpiPill}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,6,0"
                        FontSize="12"
                        Foreground="{DynamicResource Theme.Warning}"
                        Style="{StaticResource Text.Icon}"
                        Text="&#xE769;" />
                    <TextBlock Foreground="{DynamicResource Theme.Warning}" Text="Pausen " />
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Theme.Warning}"
                        Text="{Binding TotalBreakHours, Converter={StaticResource HoursToHHmm}}" />
                </StackPanel>
            </Border>

            <!--  Gebuchtes Ende zzgl. Überschneidungen und fehlender Pause  -->
            <Border
                Background="{DynamicResource Theme.SuccessSoft}"
                BorderBrush="Transparent"
                Style="{StaticResource KpiPill}"
                ToolTip="{Binding ActualDayEndToolTip}"
                Visibility="{Binding HasWorkDay, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource Theme.Success}" Text="Tatsächliches Ende " />
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Theme.Success}"
                        Text="{Binding ActualDayEnd}" />
                    <TextBlock
                        Margin="6,0,0,0"
                        Foreground="{DynamicResource Theme.Success}"
                        Opacity="0.8"
                        Text="{Binding ActualDayEndNote, StringFormat={}({0})}" />
                </StackPanel>
            </Border>

            <!--  Warnung: nur sichtbar bei Überschneidungen  -->
            <Border
                Background="{DynamicResource Theme.DangerSoft}"
                BorderBrush="Transparent"
                Style="{StaticResource KpiPill}"
                ToolTip="Es gibt Buchungen, die sich zeitlich überschneiden."
                Visibility="{Binding HasOverlaps, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,6,0"
                        FontSize="12"
                        Foreground="{DynamicResource Theme.Danger}"
                        Style="{StaticResource Text.Icon}"
                        Text="&#xE7BA;" />
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Theme.Danger}"
                        Text="{Binding OverlapCount}" />
                    <TextBlock Foreground="{DynamicResource Theme.Danger}" Text=" Überschneidung(en)" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <!--  Inhalt  -->
        <Grid Grid.Row="2" Margin="28,0,28,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!--  LINKS: Neue Buchung, Tagesverlauf, Bearbeiten  -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Neue Buchung  -->
                    <Border Style="{StaticResource Inset}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource FormLabel}" Text="Projekt" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,4"
                                Style="{StaticResource FormLabel}"
                                Text="Von" />
                            <TextBlock
                                Grid.Column="2"
                                Margin="10,0,0,4"
                                Style="{StaticResource FormLabel}"
                                Text="Bis" />
                            <TextBlock
                                Grid.Column="3"
                                Margin="10,0,0,4"
                                Style="{StaticResource FormLabel}"
                                Text="Beschreibung" />

                            <ComboBox
                                Grid.Row="1"
                                ItemsSource="{Binding ProjectNames}"
                                SelectedItem="{Binding NewProjektname, Mode=TwoWay}" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="80"
                                Margin="10,0,0,0"
                                local:Ui.Placeholder="HH:mm"
                                Text="{Binding NewStart, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Start (HH:mm)" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="2"
                                Width="80"
                                Margin="10,0,0,0"
                                local:Ui.Placeholder="HH:mm"
                                Text="{Binding NewEnd, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Ende (HH:mm)" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="3"
                                Margin="10,0,0,0"
                                local:Ui.Placeholder="Woran hast du gearbeitet? (optional)"
                                Text="{Binding NewBeschreibung}" />

                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="4"
                                Margin="10,0,0,0"
                                Orientation="Horizontal">
                                <Button
                                    local:Ui.Glyph="&#xE710;"
                                    Command="{Binding AddEntryCommand}"
                                    Content="Hinzufügen"
                                    Style="{StaticResource Button.Primary}" />
                                <Button
                                    Margin="6,0,0,0"
                                    local:Ui.Glyph="&#xE894;"
                                    Command="{Binding ResetNewFormCommand}"
                                    Style="{StaticResource Button.IconGhost}"
                                    ToolTip="Eingaben zurücksetzen" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--
                        Git-Graph-Tagesverlauf: der Trunk (Lane 0) läuft von der ersten Einstempelzeit
                        bis zur letzten Endzeit von oben nach unten. Überschneidende Buchungen zweigen als
                        parallele Branches ab, echte Pausen werden gestrichelt dargestellt. Jede Buchung
                        hat eine eigene Zeile: Knoten und Label stehen immer auf gleicher Höhe. Klick auf
                        einen Knoten oder ein Label öffnet die Buchung im Bearbeiten-Panel unten (inkl.
                        Löschen dort); die geöffnete Buchung bleibt im Graph hervorgehoben.
                    -->
                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <StackPanel
                            Margin="0,40,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Visibility="{Binding HasNoGraphEntries, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="32"
                                Foreground="{DynamicResource Theme.TextSubtle}"
                                Style="{StaticResource Text.Icon}"
                                Text="&#xE787;" />
                            <TextBlock
                                Margin="0,10,0,0"
                                HorizontalAlignment="Center"
                                Style="{StaticResource Text.Muted}"
                                Text="Keine Buchungen an diesem Tag" />
                        </StackPanel>

                        <ScrollViewer
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="{Binding HasGraphEntries, Converter={StaticResource BoolToVis}}">
                            <Grid Height="{Binding GraphHeight}" Margin="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  Graph: Kanten (Trunk / Branch / Pause) und Knoten (Buchungsstart/-ende, Tagesendpunkte)  -->
                                <Grid Grid.Column="0" Width="{Binding GraphWidth}">
                                    <ItemsControl ItemsSource="{Binding GraphEdges}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Path
                                                    Data="{Binding Geometry}"
                                                    Stroke="{Binding Stroke}"
                                                    StrokeDashArray="{Binding Dashes}"
                                                    StrokeEndLineCap="Round"
                                                    StrokeLineJoin="Round"
                                                    StrokeStartLineCap="Round"
                                                    StrokeThickness="{Binding StrokeThickness}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding GraphNodes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Width="{Binding HitSize}"
                                                    Height="{Binding HitSize}"
                                                    Margin="0"
                                                    Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Entry}"
                                                    Focusable="False"
                                                    ToolTip="{Binding ToolTip}"
                                                    ToolTipService.ShowOnDisabled="True">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <!--  Transparente Fläche: größere Klickfläche als der sichtbare Punkt  -->
                                                            <Grid Background="Transparent">
                                                                <Ellipse
                                                                    x:Name="Dot"
                                                                    Width="{Binding Diameter}"
                                                                    Height="{Binding Diameter}"
                                                                    Fill="{Binding Fill}"
                                                                    Stroke="{Binding Stroke}"
                                                                    StrokeThickness="2" />
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Theme.Text}" />
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Theme.Text}" />
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Cursor" Value="Arrow" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <!--
                                    Labels (Zeitspanne, Projekt, Dauer + Beschreibung bzw. Pausenlänge), eine
                                    Zeile je Knoten. Zu lange Beschreibungen werden gekürzt (voller Text im Tooltip).
                                -->
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding GraphLabels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                            <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Height="{Binding Height}"
                                                Margin="0"
                                                Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Entry}"
                                                Focusable="False"
                                                ToolTip="{Binding ToolTip}"
                                                ToolTipService.ShowOnDisabled="True">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border
                                                            x:Name="Row"
                                                            Padding="8,0"
                                                            Background="Transparent"
                                                            BorderBrush="Transparent"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                            <DockPanel VerticalAlignment="Center" LastChildFill="True">
                                                                <TextBlock
                                                                    Width="86"
                                                                    DockPanel.Dock="Left"
                                                                    FontSize="13"
                                                                    Foreground="{DynamicResource Theme.TextMuted}"
                                                                    Text="{Binding TimeText}" />
                                                                <!--  Projektfarbe als Markierung, der Name selbst in Textfarbe (gut lesbar in jedem Theme)  -->
                                                                <Border
                                                                    Width="8"
                                                                    Height="8"
                                                                    Margin="0,0,7,0"
                                                                    VerticalAlignment="Center"
                                                                    Background="{Binding Brush}"
                                                                    CornerRadius="2"
                                                                    DockPanel.Dock="Left" />
                                                                <TextBlock
                                                                    Margin="0,0,10,0"
                                                                    DockPanel.Dock="Left"
                                                                    FontSize="13"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource Theme.Text}"
                                                                    Text="{Binding Title}" />
                                                                <TextBlock
                                                                    FontSize="13"
                                                                    Foreground="{DynamicResource Theme.TextMuted}"
                                                                    Text="{Binding Detail}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Theme.Hover}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Theme.Selection}" />
                                                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Cursor" Value="Arrow" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!--  Buchung bearbeiten (öffnet sich per Klick auf eine Buchung im Verlauf)  -->
                    <Border
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        Background="{DynamicResource Theme.AccentSoft}"
                        BorderBrush="{DynamicResource Theme.Accent}"
                        Style="{StaticResource Inset}"
                        Visibility="{Binding IsEditPanelOpen, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock
                                Margin="2,0,0,8"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Theme.AccentSoftText}"
                                Text="Buchung bearbeiten" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox ItemsSource="{Binding ProjectNames}" SelectedItem="{Binding EditProjektname, Mode=TwoWay}" />
                                <TextBox
                                    Grid.Column="1"
                                    Width="80"
                                    Margin="10,0,0,0"
                                    local:Ui.Placeholder="HH:mm"
                                    Text="{Binding EditStart}"
                                    ToolTip="Start (HH:mm)" />
                                <TextBox
                                    Grid.Column="2"
                                    Width="80"
                                    Margin="10,0,0,0"
                                    local:Ui.Placeholder="HH:mm"
                                    Text="{Binding EditEnd}"
                                    ToolTip="Ende (HH:mm)" />
                                <TextBox
                                    Grid.Column="3"
                                    Margin="10,0,0,0"
                                    local:Ui.Placeholder="Beschreibung"
                                    Text="{Binding EditBeschreibung}" />

                                <StackPanel
                                    Grid.Column="4"
                                    Margin="10,0,0,0"
                                    Orientation="Horizontal">
                                    <Button
                                        local:Ui.Glyph="&#xE74E;"
                                        Command="{Binding SaveEditCommand}"
                                        Content="Speichern"
                                        Style="{StaticResource Button.Primary}" />
                                    <Button
                                        Margin="6,0,0,0"
                                        Command="{Binding CancelEditCommand}"
                                        Content="Abbrechen" />
                                    <Button
                                        Margin="6,0,0,0"
                                        local:Ui.Glyph="&#xE74D;"
                                        Command="{Binding DeleteEditingEntryCommand}"
                                        Content="Löschen"
                                        Style="{StaticResource Button.Danger}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!--  RECHTS: Zusammenfassungen  -->
            <Grid Grid.Column="1" Margin="16,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock
                            Margin="0,0,0,4"
                            DockPanel.Dock="Top"
                            Style="{StaticResource Text.Section}"
                            Text="Stunden je Projekt" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemTemplate="{StaticResource SummaryRowTemplate}" ItemsSource="{Binding SumByProject}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock
                            Margin="0,0,0,4"
                            DockPanel.Dock="Top"
                            Style="{StaticResource Text.Section}"
                            Text="Stunden je Kostenträger" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemTemplate="{StaticResource SummaryRowTemplate}" ItemsSource="{Binding SumByKTR}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
