<UserControl
    x:Class="Zeitmanagement.Views.EntriesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Zeitmanagement.Views"
    xmlns:viewmodel="clr-namespace:Zeitmanagement.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:EntriesViewModel}"
    d:DesignHeight="720"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <!--  ========== RESOURCES / THEME ==========  -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:DecimalHoursToHHmmConverter x:Key="HoursToHHmm" />

        <!--  Farben  -->
        <Color x:Key="ColBgDark">#0B1020</Color>
        <Color x:Key="ColCard">#1A2238</Color>
        <Color x:Key="ColText">#F5F7FB</Color>
        <Color x:Key="ColTextMuted">#B7C0D8</Color>

        <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColText}" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColTextMuted}" />
        <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColCard}" />

        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#0B1020" />
            <GradientStop Offset="1" Color="#121A33" />
        </LinearGradientBrush>

        <!--  Accent für die blauen Pillen (anpassbar)  -->
        <SolidColorBrush x:Key="BrushAccent" Color="#1F2A4D" />

        <!--  Pillenkarte  -->
        <Style x:Key="SummaryPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="Background" Value="{StaticResource BrushAccent}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="12"
                        Opacity="0.35"
                        ShadowDepth="2"
                        Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Karte für ein Zusammenfassungsobjekt (Name, Hours, Count)  -->
        <DataTemplate x:Key="SummaryCardTemplate">
            <Border Style="{StaticResource SummaryPill}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--  Titel mittig  -->
                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource BrushText}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <!--  Zahlen/Labels  -->
                    <Grid Grid.Row="1" Margin="8,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                            <TextBlock
                                HorizontalAlignment="Left"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushText}"
                                Text="{Binding Count}" />
                            <TextBlock
                                Foreground="{StaticResource BrushText}"
                                Opacity="0.9"
                                Text="BUCHUNGEN" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushText}"
                                Text="{Binding Hours, Converter={StaticResource HoursToHHmm}}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Foreground="{StaticResource BrushText}"
                                Opacity="0.9"
                                Text="STUNDEN" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  Card  -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{StaticResource BrushCard}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="18"
                        Opacity="0.4"
                        ShadowDepth="3"
                        Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Inputs  -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Background" Value="#233055" />
            <Setter Property="BorderBrush" Value="#33406A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Background" Value="#2D3A63" />
            <Setter Property="BorderBrush" Value="#42507C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!--  Pretty DatePicker  -->
        <Style
            x:Key="NiceDatePicker"
            BasedOn="{StaticResource {x:Type DatePicker}}"
            TargetType="DatePicker">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="BorderBrush" Value="#33406A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DatePicker}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <DatePickerTextBox
                                x:Name="PART_TextBox"
                                Grid.Column="0"
                                Background="#233055"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Foreground="{StaticResource BrushText}" />

                            <Button
                                Grid.Column="1"
                                Padding="10,6"
                                Background="#2D3A63"
                                BorderBrush="#42507C"
                                BorderThickness="1"
                                Focusable="False">
                                <Path
                                    Width="14"
                                    Height="14"
                                    Data="M6,0 L8,0 8,6 14,6 14,8 8,8 8,14 6,14 6,8 0,8 0,6 6,6 z"
                                    Fill="{StaticResource BrushText}"
                                    Stretch="Uniform" />
                            </Button>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="CalendarStyle">
                <Setter.Value>
                    <Style TargetType="Calendar">
                        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                        <Setter Property="Background" Value="#233055" />
                        <Setter Property="BorderBrush" Value="#33406A" />
                        <Setter Property="BorderThickness" Value="1" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--  ========== LAYOUT ==========  -->
    <Grid Background="{StaticResource BgGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border
            Grid.Row="0"
            Margin="16,16,16,8"
            Style="{StaticResource Card}">
            <!--
                Die Navigation wird zuerst angedockt und sitzt damit immer fest am rechten Rand. Die
                Kacheln, deren Breite sich beim Datumswechsel ändert, bekommen den Platz links daneben,
                der Titel den Rest (der Untertitel wird bei Platzmangel gekürzt).
            -->
            <DockPanel>
                <!--  Navigation  -->
                <StackPanel
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button Command="{Binding GoToLastDayCommand}" Content="-" />
                    <TextBox
                        Width="80"
                        Text="{Binding SelectedDate, UpdateSourceTrigger=PropertyChanged}"
                        TextAlignment="Center"
                        ToolTip="Datum TT.MM.YYYY" />
                    <Button Command="{Binding GoToNextDayCommand}" Content="+" />
                    <!--<DatePicker
                        SelectedDate="{Binding SelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource NiceDatePicker}"
                        Visibility="Collapsed" />-->
                    <Button Command="{Binding TodayCommand}" Content="Heute" />
                    <Button Command="{Binding RefreshCommand}" Content="Aktualisieren" />
                </StackPanel>

                <!--  KPI-Kacheln  -->
                <StackPanel
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <!--  === HEUTE-KPI: Stunden + Buchungen (Summe aller Buchungen) ===  -->
                    <Border
                        Margin="8,0,0,0"
                        Padding="10,6"
                        Background="{StaticResource BrushAccent}"
                        CornerRadius="18">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,6,0"
                                Foreground="{StaticResource BrushTextMuted}"
                                Text="Heute:" />
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushText}"
                                Text="{Binding TodayTotalHours, Converter={StaticResource HoursToHHmm}}" />
                            <TextBlock
                                Margin="8,0,0,0"
                                Foreground="{StaticResource BrushTextMuted}"
                                Text="(" />
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushText}"
                                Text="{Binding TodayEntryCount}" />
                            <TextBlock Foreground="{StaticResource BrushTextMuted}" Text=" Buchungen)" />
                        </StackPanel>
                    </Border>

                    <!--  === ARBEITSTAG-KPI: Beginn der ersten bis Ende der letzten Buchung, wie gebucht ===  -->
                    <Border
                        Margin="8,0,0,0"
                        Padding="10,6"
                        Background="{StaticResource BrushAccent}"
                        CornerRadius="18"
                        ToolTip="Beginn der ersten und Ende der letzten Buchung des Tages, wie gebucht."
                        Visibility="{Binding HasWorkDay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,6,0"
                                Foreground="{StaticResource BrushTextMuted}"
                                Text="Arbeitstag:" />
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushText}"
                                Text="{Binding WorkDayStart}" />
                            <TextBlock Foreground="{StaticResource BrushTextMuted}" Text=" – " />
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushText}"
                                Text="{Binding WorkDayEnd}" />
                        </StackPanel>
                    </Border>

                    <!--  === PAUSEN-KPI: Summe der Lücken zwischen Buchungen ===  -->
                    <Border
                        Margin="8,0,0,0"
                        Padding="10,6"
                        Background="#3A2A16"
                        CornerRadius="18">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Foreground="#FFB454"
                                Text="&#x23F8; Pausen:" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="#FFB454"
                                Text="{Binding TotalBreakHours, Converter={StaticResource HoursToHHmm}}" />
                        </StackPanel>
                    </Border>

                    <!--  === TATSÄCHLICHES-ENDE-KPI: gebuchtes Ende zzgl. Überschneidungen und fehlender Pause ===  -->
                    <Border
                        Margin="8,0,0,0"
                        Padding="10,6"
                        Background="#153A2E"
                        BorderBrush="#2E6E52"
                        BorderThickness="1"
                        CornerRadius="18"
                        ToolTip="{Binding ActualDayEndToolTip}"
                        Visibility="{Binding HasWorkDay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,6,0"
                                Foreground="#7FE0B8"
                                Text="Tatsächliches Ende:" />
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="#7FE0B8"
                                Text="{Binding ActualDayEnd}" />
                            <TextBlock
                                Margin="6,0,0,0"
                                Foreground="#7FE0B8"
                                Opacity="0.75"
                                Text="{Binding ActualDayEndNote, StringFormat={}({0})}" />
                        </StackPanel>
                    </Border>

                    <!--  === WARNUNG: Überschneidungen (nur sichtbar bei Problemen) ===  -->
                    <Border
                        Margin="8,0,0,0"
                        Padding="10,6"
                        Background="#3A1620"
                        BorderBrush="#7A2A3A"
                        BorderThickness="1"
                        CornerRadius="18"
                        ToolTip="Es gibt Buchungen, die sich zeitlich überschneiden."
                        Visibility="{Binding HasOverlaps, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Foreground="#FF6B81"
                                Text="&#x26A0;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="#FF6B81"
                                Text="{Binding OverlapCount}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="#E6889A"
                                Text=" Überschneidung(en)" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Vertical">
                    <TextBlock
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource BrushText}"
                        Text="Zeitbuchungen"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{StaticResource BrushTextMuted}"
                        Text="{Binding HeaderSubtitle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  Body  -->
        <Border
            Grid.Row="1"
            Margin="16,8,16,16"
            Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  LEFT: Add + Grid + Edit  -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Add Panel  -->
                    <Border
                        Grid.Row="0"
                        Margin="0,0,0,10"
                        Padding="12"
                        Background="#1F2A4D"
                        CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox
                                Grid.Column="0"
                                ItemsSource="{Binding ProjectNames}"
                                SelectedItem="{Binding NewProjektname, Mode=TwoWay}"
                                Style="{StaticResource NiceCombo}" />

                            <TextBox
                                Grid.Column="1"
                                Width="90"
                                Text="{Binding NewStart, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Start (HH:mm)" />
                            <TextBox
                                Grid.Column="2"
                                Width="90"
                                Text="{Binding NewEnd, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Ende (HH:mm)" />
                            <TextBox
                                Grid.Column="3"
                                Text="{Binding NewBeschreibung}"
                                ToolTip="Beschreibung" />

                            <StackPanel
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button Command="{Binding AddEntryCommand}" Content="Hinzufügen" />
                                <Button Command="{Binding ResetNewFormCommand}" Content="Reset" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--
                        Git-Graph-Tagesverlauf (ersetzt die frühere Buchungen-Tabelle): der Trunk (Lane 0) läuft
                        von der ersten Einstempelzeit bis zur letzten Endzeit von oben nach unten. Überschneidende
                        Buchungen zweigen als parallele Branches ab, echte Pausen werden gestrichelt dargestellt.
                        Jede Buchung hat eine eigene Zeile: Knoten und Label stehen immer auf gleicher Höhe.
                        Klick auf einen Knoten oder ein Label öffnet die Buchung im Bearbeiten-Panel unten
                        (inkl. Löschen dort); die geöffnete Buchung bleibt im Graph hervorgehoben.
                    -->
                    <Grid Grid.Row="1">
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            FontSize="13"
                            FontStyle="Italic"
                            Foreground="{StaticResource BrushTextMuted}"
                            Text="Keine Buchungen"
                            Visibility="{Binding HasNoGraphEntries, Converter={StaticResource BoolToVis}}" />

                        <ScrollViewer
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="{Binding HasGraphEntries, Converter={StaticResource BoolToVis}}">
                            <Grid Height="{Binding GraphHeight}" Margin="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  Graph: Kanten (Trunk / Branch / Pause) und Knoten (Buchungsstart/-ende, Tagesendpunkte)  -->
                                <Grid Grid.Column="0" Width="{Binding GraphWidth}">
                                    <ItemsControl ItemsSource="{Binding GraphEdges}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Path
                                                    Data="{Binding Geometry}"
                                                    Stroke="{Binding Stroke}"
                                                    StrokeDashArray="{Binding Dashes}"
                                                    StrokeEndLineCap="Round"
                                                    StrokeLineJoin="Round"
                                                    StrokeStartLineCap="Round"
                                                    StrokeThickness="{Binding StrokeThickness}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding GraphNodes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!--  Margin="0" überschreibt den globalen Button-Margin, sonst säße der Knoten versetzt neben der Linie  -->
                                                <Button
                                                    Width="{Binding HitSize}"
                                                    Height="{Binding HitSize}"
                                                    Margin="0"
                                                    Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Entry}"
                                                    Focusable="False"
                                                    ToolTip="{Binding ToolTip}"
                                                    ToolTipService.ShowOnDisabled="True">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <!--  Transparente Fläche: größere Klickfläche als der sichtbare Punkt  -->
                                                            <Grid Background="Transparent">
                                                                <Ellipse
                                                                    x:Name="Dot"
                                                                    Width="{Binding Diameter}"
                                                                    Height="{Binding Diameter}"
                                                                    Fill="{Binding Fill}"
                                                                    Stroke="{Binding Stroke}"
                                                                    StrokeThickness="2" />
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource BrushText}" />
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource BrushText}" />
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Cursor" Value="Arrow" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <!--
                                    Labels (Zeitspanne, Projekt, Dauer + Beschreibung bzw. Pausenlänge), eine Zeile je
                                    Knoten. Die Spalte wächst mit dem Fenster; zu lange Beschreibungen werden gekürzt
                                    (voller Text im Tooltip) statt einen horizontalen Scrollbalken zu erzwingen.
                                -->
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding GraphLabels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                            <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Height="{Binding Height}"
                                                Margin="0"
                                                Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Entry}"
                                                Focusable="False"
                                                ToolTip="{Binding ToolTip}"
                                                ToolTipService.ShowOnDisabled="True">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border
                                                            x:Name="Row"
                                                            Padding="8,0"
                                                            Background="Transparent"
                                                            BorderBrush="Transparent"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                            <DockPanel VerticalAlignment="Center" LastChildFill="True">
                                                                <TextBlock
                                                                    Width="86"
                                                                    DockPanel.Dock="Left"
                                                                    FontSize="13"
                                                                    Foreground="{StaticResource BrushTextMuted}"
                                                                    Text="{Binding TimeText}" />
                                                                <TextBlock
                                                                    Margin="0,0,10,0"
                                                                    DockPanel.Dock="Left"
                                                                    FontSize="13"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{Binding Brush}"
                                                                    Text="{Binding Title}" />
                                                                <TextBlock
                                                                    FontSize="13"
                                                                    Foreground="{StaticResource BrushTextMuted}"
                                                                    Text="{Binding Detail}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="#243056" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="#2C3A69" />
                                                                <Setter TargetName="Row" Property="BorderBrush" Value="#42507C" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Cursor" Value="Arrow" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!--  Edit Panel  -->
                    <Border
                        Grid.Row="2"
                        Margin="0,10,0,0"
                        Padding="12"
                        Background="#1F2A4D"
                        CornerRadius="12"
                        Visibility="{Binding IsEditPanelOpen, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox
                                Grid.Column="0"
                                ItemsSource="{Binding ProjectNames}"
                                SelectedItem="{Binding EditProjektname, Mode=TwoWay}"
                                Style="{StaticResource NiceCombo}" />

                            <TextBox
                                Grid.Column="1"
                                Width="90"
                                Text="{Binding EditStart}" />
                            <TextBox
                                Grid.Column="2"
                                Width="90"
                                Text="{Binding EditEnd}" />
                            <TextBox Grid.Column="3" Text="{Binding EditBeschreibung}" />

                            <StackPanel
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button Command="{Binding SaveEditCommand}" Content="Speichern" />
                                <Button Command="{Binding CancelEditCommand}" Content="Abbrechen" />
                                <Button Command="{Binding DeleteEditingEntryCommand}" Content="Löschen" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!--  RIGHT: Sidebar Summaries  -->
                <Grid Grid.Column="1" Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Stunden je Projekt  -->
                    <Border
                        Grid.Row="0"
                        Padding="12"
                        Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushText}"
                                Text="Stunden je Projekt" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemTemplate="{StaticResource SummaryCardTemplate}" ItemsSource="{Binding SumByProject}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!--  Stunden je Kostenträger  -->
                    <Border
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        Padding="12"
                        Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushText}"
                                Text="Stunden je Kostenträger" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemTemplate="{StaticResource SummaryCardTemplate}" ItemsSource="{Binding SumByKTR}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>