<UserControl
    x:Class="Zeitmanagement.Views.SapBookingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Zeitmanagement.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:Zeitmanagement.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:SapBookingViewModel}"
    d:DesignHeight="720"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="BrushText" Color="#F5F7FB" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="#B7C0D8" />
        <SolidColorBrush x:Key="BrushCard" Color="#1A2238" />
        <SolidColorBrush x:Key="BrushTrack" Color="#2A3050" />

        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#0B1020" />
            <GradientStop Offset="1" Color="#121A33" />
        </LinearGradientBrush>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{StaticResource BrushCard}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" Opacity="0.4" ShadowDepth="3" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="#2A3050" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrushText}" Text="SAP-Verrechnung" />
                <TextBlock
                    Margin="0,4,0,12"
                    FontSize="13"
                    Foreground="{StaticResource BrushTextMuted}"
                    Text="Was muss wirklich im SAP gebucht werden? Externe Zeit deckt parallele interne Zeit ab; Überschuss wird bis Monatsende auf freie interne Zeiten geschoben."
                    TextWrapping="Wrap" />
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Command="{Binding PreviousCommand}" Content="◀" Style="{StaticResource NavButton}" />
                    <TextBlock
                        MinWidth="180"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource BrushText}"
                        Text="{Binding RangeLabel}"
                        TextAlignment="Center" />
                    <Button Command="{Binding NextCommand}" Content="▶" Style="{StaticResource NavButton}" />
                    <Button
                        Width="Auto"
                        Margin="16,0,0,0"
                        Padding="12,0"
                        Command="{Binding TodayCommand}"
                        Content="Aktueller Monat"
                        Style="{StaticResource NavButton}" />
                    <DatePicker
                        Width="140"
                        Margin="16,0,0,0"
                        FontSize="13"
                        SelectedDate="{Binding ReferenceDate}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="0,0,0,8" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  Kennzahlen  -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Kpis}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="200"
                                        Margin="0,0,12,12"
                                        Padding="12,10"
                                        Background="#233055"
                                        BorderBrush="{Binding Accent}"
                                        BorderThickness="0,3,0,0"
                                        CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Muted}" Text="{Binding Title}" />
                                            <TextBlock
                                                FontSize="22"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource BrushText}"
                                                Text="{Binding Value}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{StaticResource BrushTextMuted}"
                                                Text="{Binding Hint}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            FontSize="13"
                            Foreground="{StaticResource BrushText}"
                            Text="{Binding StatusNote}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="13"
                            Foreground="#FFC107"
                            Text="Hinweis: In diesem Monat ist kein Projekt als extern markiert, daher wird nichts verrechnet. Unter „Projektübersicht“ lässt sich pro Projekt festlegen, ob es extern (vom Kunden bezahlt) ist."
                            TextWrapping="Wrap"
                            Visibility="{Binding NoExternalProjects, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!--  Legende  -->
                <Border Style="{StaticResource Card}">
                    <WrapPanel>
                        <StackPanel Margin="0,0,20,4" Orientation="Horizontal">
                            <Border Width="14" Height="14" Margin="0,0,6,0" Background="#5AC8FA" CornerRadius="3" />
                            <TextBlock Foreground="{StaticResource BrushText}" Text="Extern (wird gebucht)" />
                        </StackPanel>
                        <StackPanel Margin="0,0,20,4" Orientation="Horizontal">
                            <Border Width="14" Height="14" Margin="0,0,6,0" Background="#8E8BFF" CornerRadius="3" />
                            <TextBlock Foreground="{StaticResource BrushText}" Text="Intern (wird gebucht)" />
                        </StackPanel>
                        <StackPanel Margin="0,0,20,4" Orientation="Horizontal">
                            <Border Width="14" Height="14" Margin="0,0,6,0" Background="#4ECA84" CornerRadius="3" />
                            <TextBlock Foreground="{StaticResource BrushText}" Text="Intern, durch parallele externe Arbeit gedeckt (entfällt)" />
                        </StackPanel>
                        <StackPanel Margin="0,0,20,4" Orientation="Horizontal">
                            <Border Width="14" Height="14" Margin="0,0,6,0" Background="#FFC107" CornerRadius="3" />
                            <TextBlock Foreground="{StaticResource BrushText}" Text="Intern, mit gespeichertem Überschuss verrechnet (entfällt)" />
                        </StackPanel>
                        <StackPanel Margin="0,0,20,4" Orientation="Horizontal">
                            <Border Width="14" Height="6" Margin="0,0,6,0" Background="#FF8A50" CornerRadius="2" />
                            <TextBlock Foreground="{StaticResource BrushText}" Text="Überschuss entsteht (mehrere externe Projekte parallel)" />
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <!--  Monatssumme je Projekt  -->
                <Border Style="{StaticResource Card}" Visibility="{Binding HasDays, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrushText}"
                            Text="Im SAP zu buchen – Monat je Projekt" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Muted}" Text="Projekt" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Muted}" Text="Typ" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Muted}" Text="Gebucht (brutto)" />
                            <TextBlock Grid.Column="3" Style="{StaticResource Muted}" Text="Im SAP buchen" />
                            <TextBlock Grid.Column="4" Style="{StaticResource Muted}" Text="Verrechnet" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding MonthProjects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="{StaticResource BrushText}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Foreground="{Binding TypeBrush}" Text="{Binding TypeText}" />
                                        <TextBlock Grid.Column="2" Foreground="{StaticResource BrushTextMuted}" Text="{Binding GrossText}" />
                                        <TextBlock Grid.Column="3" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Text="{Binding BookedText}" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource Muted}" Text="{Binding NoteText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!--  Tage  -->
                <ItemsControl ItemsSource="{Binding Days}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="8,4" Padding="14" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="340" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Datum und Arbeitszeit  -->
                                    <StackPanel>
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Text="{Binding DateLabel}" />
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Muted}" Text="Arbeitszeit" />
                                        <TextBlock FontSize="13" Foreground="{StaticResource BrushText}" Text="{Binding SpanText}" />
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding RangeText}" />
                                    </StackPanel>

                                    <!--  Zeitleiste, Erklärung, Speicher  -->
                                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                        <Viewbox Height="{Binding TimelineHeight}" Stretch="Fill">
                                            <ItemsControl
                                                Width="1000"
                                                Height="{Binding TimelineHeight}"
                                                Background="{StaticResource BrushTrack}"
                                                ItemsSource="{Binding Rects}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            Width="{Binding Width}"
                                                            Height="{Binding Height}"
                                                            Background="{Binding Brush}"
                                                            CornerRadius="3"
                                                            ToolTip="{Binding ToolTip}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Viewbox>
                                        <Grid Margin="0,2,0,6">
                                            <TextBlock FontSize="10" Foreground="{StaticResource BrushTextMuted}" Text="{Binding StartLabel}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                FontSize="10"
                                                Foreground="{StaticResource BrushTextMuted}"
                                                Text="{Binding EndLabel}" />
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Lines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,1" Orientation="Horizontal">
                                                        <Border
                                                            Width="8"
                                                            Height="8"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding Brush}"
                                                            CornerRadius="4" />
                                                        <TextBlock FontSize="12" Foreground="{StaticResource BrushText}" Text="{Binding Text}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" ToolTip="{Binding PoolTip}">
                                            <TextBlock
                                                Width="130"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource Muted}"
                                                Text="Überschuss-Speicher" />
                                            <Border Width="100" Height="8" Background="{StaticResource BrushTrack}" CornerRadius="4">
                                                <Border
                                                    Width="{Binding PoolBarWidth}"
                                                    HorizontalAlignment="Left"
                                                    Background="#FF8A50"
                                                    CornerRadius="4" />
                                            </Border>
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{StaticResource BrushText}"
                                                Text="{Binding PoolText}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!--  SAP-Buchung dieses Tages  -->
                                    <Border
                                        Grid.Column="2"
                                        Padding="10"
                                        Background="#233055"
                                        CornerRadius="10">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Text="Im SAP buchen" />
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource BrushText}"
                                                    Text="{Binding SapTotalText}" />
                                            </Grid>
                                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Projects}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border
                                                                        Width="8"
                                                                        Height="8"
                                                                        Margin="0,0,6,0"
                                                                        VerticalAlignment="Center"
                                                                        Background="{Binding TypeBrush}"
                                                                        CornerRadius="4" />
                                                                    <TextBlock
                                                                        FontSize="12"
                                                                        Foreground="{StaticResource BrushText}"
                                                                        Text="{Binding Name}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <TextBlock Margin="14,0,0,0" FontSize="10" Foreground="{StaticResource BrushTextMuted}">
                                                                    <Run Text="{Binding TypeText, Mode=OneWay}" /> · gebucht <Run Text="{Binding GrossText, Mode=OneWay}" /> <Run Text="{Binding NoteText, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                FontSize="13"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource BrushText}"
                                                                Text="{Binding BookedText}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
