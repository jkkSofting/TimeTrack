<UserControl
    x:Class="Zeitmanagement.Views.SapBookingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Zeitmanagement.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:Zeitmanagement.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:SapBookingViewModel}"
    d:DesignHeight="720"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="LegendSwatch" TargetType="Border">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <Style x:Key="LegendItem" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,20,6" />
            <Setter Property="Orientation" Value="Horizontal" />
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Kopf: Titel links, Monatsauswahl rechts  -->
        <DockPanel Style="{StaticResource PageHeader}">
            <StackPanel
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <Button
                    local:Ui.Glyph="&#xE76B;"
                    Command="{Binding PreviousCommand}"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Vorheriger Monat" />
                <TextBlock
                    MinWidth="160"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Theme.Text}"
                    Text="{Binding RangeLabel}"
                    TextAlignment="Center" />
                <Button
                    local:Ui.Glyph="&#xE76C;"
                    Command="{Binding NextCommand}"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Nächster Monat" />
                <Button
                    Margin="12,0,0,0"
                    Command="{Binding TodayCommand}"
                    Content="Aktueller Monat" />
                <DatePicker
                    Width="140"
                    Margin="12,0,0,0"
                    SelectedDate="{Binding ReferenceDate}" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="SAP-Verrechnung" />
                <TextBlock
                    Style="{StaticResource Text.Subtitle}"
                    Text="Was muss wirklich im SAP gebucht werden? Externe Zeit deckt parallele interne Zeit ab; Überschuss wird bis Monatsende auf freie interne Zeiten geschoben."
                    TextTrimming="None"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,0,28,24">

                <!--  Kennzahlen  -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Kpis}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="200"
                                        Margin="0,0,12,12"
                                        Padding="14,12"
                                        Background="{DynamicResource Theme.Surface}"
                                        BorderBrush="{Binding Accent}"
                                        BorderThickness="0,3,0,0"
                                        CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Muted}" Text="{Binding Title}" />
                                            <TextBlock
                                                Margin="0,2,0,2"
                                                FontSize="22"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource Theme.Text}"
                                                Text="{Binding Value}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource Theme.TextMuted}"
                                                Text="{Binding Hint}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            Style="{StaticResource Text.Body}"
                            Text="{Binding StatusNote}"
                            TextWrapping="Wrap" />
                        <Border
                            Margin="0,10,0,0"
                            Background="{DynamicResource Theme.WarningSoft}"
                            BorderBrush="Transparent"
                            Style="{StaticResource Inset}"
                            Visibility="{Binding NoExternalProjects, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                FontSize="13"
                                Foreground="{DynamicResource Theme.Warning}"
                                Text="Hinweis: In diesem Monat ist kein Projekt als extern markiert, daher wird nichts verrechnet. Unter „Projekte“ lässt sich pro Projekt festlegen, ob es extern (vom Kunden bezahlt) ist."
                                TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!--  Legende (dieselben Theme-Farben wie im SapBookingViewModel)  -->
                <WrapPanel Margin="4,16,0,4">
                    <StackPanel Style="{StaticResource LegendItem}">
                        <Border Background="{DynamicResource Theme.Data0}" Style="{StaticResource LegendSwatch}" />
                        <TextBlock Style="{StaticResource Text.Muted}" Text="Extern (wird gebucht)" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource LegendItem}">
                        <Border Background="{DynamicResource Theme.Data1}" Style="{StaticResource LegendSwatch}" />
                        <TextBlock Style="{StaticResource Text.Muted}" Text="Intern (wird gebucht)" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource LegendItem}">
                        <Border Background="{DynamicResource Theme.Data2}" Style="{StaticResource LegendSwatch}" />
                        <TextBlock Style="{StaticResource Text.Muted}" Text="Intern, durch parallele externe Arbeit gedeckt (entfällt)" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource LegendItem}">
                        <Border Background="{DynamicResource Theme.Data3}" Style="{StaticResource LegendSwatch}" />
                        <TextBlock Style="{StaticResource Text.Muted}" Text="Intern, mit gespeichertem Überschuss verrechnet (entfällt)" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource LegendItem}">
                        <Border Background="{DynamicResource Theme.DataNeutral}" Style="{StaticResource LegendSwatch}" />
                        <TextBlock Style="{StaticResource Text.Muted}" Text="Intern, parallel zu internem Projekt mit mehr Stunden (verworfen)" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource LegendItem}">
                        <Border
                            Height="6"
                            Background="{DynamicResource Theme.Data4}"
                            Style="{StaticResource LegendSwatch}" />
                        <TextBlock Style="{StaticResource Text.Muted}" Text="Überschuss entsteht (mehrere externe Projekte parallel)" />
                    </StackPanel>
                </WrapPanel>

                <!--  Monatssumme je Kostenträger  -->
                <Border
                    Margin="0,8,0,0"
                    Style="{StaticResource Card}"
                    Visibility="{Binding HasDays, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,12"
                            Style="{StaticResource Text.Section}"
                            Text="Im SAP zu buchen – Monat je Kostenträger" />
                        <Border
                            Padding="0,0,0,8"
                            BorderBrush="{DynamicResource Theme.Divider}"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Muted}" Text="Kostenträger" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource Muted}"
                                    Text="Typ" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource Muted}"
                                    Text="Gebucht (brutto)" />
                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource Muted}"
                                    Text="Im SAP buchen" />
                                <TextBlock
                                    Grid.Column="4"
                                    Style="{StaticResource Muted}"
                                    Text="Verrechnet" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding MonthProjects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="0,8"
                                        BorderBrush="{DynamicResource Theme.Divider}"
                                        BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="3*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Style="{StaticResource Text.Body}"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <!--  Farbe als Markierung neben dem Text, der Text selbst bleibt in Textfarbe  -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Border
                                                    Width="8"
                                                    Height="8"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding TypeBrush}"
                                                    CornerRadius="4" />
                                                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding TypeText}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="2"
                                                Style="{StaticResource Text.Muted}"
                                                Text="{Binding GrossText}" />
                                            <TextBlock
                                                Grid.Column="3"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource Text.Body}"
                                                Text="{Binding BookedText}" />
                                            <TextBlock
                                                Grid.Column="4"
                                                Style="{StaticResource Muted}"
                                                Text="{Binding NoteText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!--  Tage  -->
                <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Days}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,12"
                                Padding="16"
                                Style="{StaticResource Card.Flat}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="340" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Datum und Arbeitszeit  -->
                                    <StackPanel>
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Style="{StaticResource Text.Body}"
                                            Text="{Binding DateLabel}" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            Style="{StaticResource Muted}"
                                            Text="Arbeitszeit" />
                                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding SpanText}" />
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding RangeText}" />
                                    </StackPanel>

                                    <!--  Zeitleiste, Erklärung, Speicher  -->
                                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                        <Viewbox Height="{Binding TimelineHeight}" Stretch="Fill">
                                            <ItemsControl
                                                Width="1000"
                                                Height="{Binding TimelineHeight}"
                                                Background="{DynamicResource Theme.Track}"
                                                ItemsSource="{Binding Rects}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            Width="{Binding Width}"
                                                            Height="{Binding Height}"
                                                            Background="{Binding Brush}"
                                                            CornerRadius="3"
                                                            ToolTip="{Binding ToolTip}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Viewbox>
                                        <Grid Margin="0,2,0,6">
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{DynamicResource Theme.TextMuted}"
                                                Text="{Binding StartLabel}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                FontSize="10"
                                                Foreground="{DynamicResource Theme.TextMuted}"
                                                Text="{Binding EndLabel}" />
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Lines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,1" Orientation="Horizontal">
                                                        <Border
                                                            Width="8"
                                                            Height="8"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding Brush}"
                                                            CornerRadius="4" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{DynamicResource Theme.Text}"
                                                            Text="{Binding Text}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel
                                            Margin="0,8,0,0"
                                            Orientation="Horizontal"
                                            ToolTip="{Binding PoolTip}">
                                            <TextBlock
                                                Width="130"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource Muted}"
                                                Text="Überschuss-Speicher" />
                                            <Border
                                                Width="100"
                                                Height="8"
                                                Background="{DynamicResource Theme.Track}"
                                                CornerRadius="4">
                                                <Border
                                                    Width="{Binding PoolBarWidth}"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource Theme.Data4}"
                                                    CornerRadius="4" />
                                            </Border>
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource Theme.Text}"
                                                Text="{Binding PoolText}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!--  SAP-Buchung dieses Tages  -->
                                    <Border Grid.Column="2" Style="{StaticResource Inset}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Style="{StaticResource Text.Body}"
                                                    Text="Im SAP buchen" />
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    FontWeight="Bold"
                                                    Style="{StaticResource Text.Body}"
                                                    Text="{Binding SapTotalText}" />
                                            </Grid>
                                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Projects}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border
                                                                        Width="8"
                                                                        Height="8"
                                                                        Margin="0,0,6,0"
                                                                        VerticalAlignment="Center"
                                                                        Background="{Binding TypeBrush}"
                                                                        CornerRadius="4" />
                                                                    <TextBlock
                                                                        FontSize="12"
                                                                        Foreground="{DynamicResource Theme.Text}"
                                                                        Text="{Binding Name}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <TextBlock
                                                                    Margin="14,0,0,0"
                                                                    FontSize="10"
                                                                    Foreground="{DynamicResource Theme.TextMuted}">
                                                                    <Run Text="{Binding TypeText, Mode=OneWay}" /><Run Text=" · gebucht " /><Run Text="{Binding GrossText, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding NoteText, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                FontSize="13"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource Theme.Text}"
                                                                Text="{Binding BookedText}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
