<UserControl
    x:Class="Zeitmanagement.Views.ProjectsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:Zeitmanagement.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:ProjectsViewModel}"
    d:DesignHeight="720"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--  Farben wie im Dashboard  -->
        <Color x:Key="ColBgDark">#0B1020</Color>
        <Color x:Key="ColCard">#1A2238</Color>
        <Color x:Key="ColText">#F5F7FB</Color>
        <Color x:Key="ColTextMuted">#B7C0D8</Color>
        <Color x:Key="ColAccent">#5AC8FA</Color>

        <SolidColorBrush x:Key="BrushBg" Color="{StaticResource ColBgDark}" />
        <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColCard}" />
        <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColText}" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColTextMuted}" />
        <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColAccent}" />

        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#0B1020" />
            <GradientStop Offset="1" Color="#121A33" />
        </LinearGradientBrush>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{StaticResource BrushCard}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="18"
                        Opacity="0.4"
                        ShadowDepth="3"
                        Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Modernes TextBox-Style  -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Background" Value="#233055" />
            <Setter Property="BorderBrush" Value="#33406A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="4" />
        </Style>

        <!--  Button  -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Background" Value="#2D3A63" />
            <Setter Property="BorderBrush" Value="#42507C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!--  DataGrid minimal dunkel  -->
        <Style TargetType="DataGrid">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="36" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalGridLinesBrush" Value="#30406B" />
            <Setter Property="VerticalGridLinesBrush" Value="#30406B" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E2A4A" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#2A3861" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#202B4E" />
            <Setter Property="BorderBrush" Value="#2A3861" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#26345E" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2C3A69" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header + Aktionen  -->
        <Border
            Grid.Row="0"
            Margin="16,16,16,8"
            Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <TextBlock
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource BrushText}"
                        Text="Projekte" />
                    <TextBlock Foreground="{StaticResource BrushTextMuted}" Text="{Binding HeaderSubtitle}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBox
                        Width="240"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Suchen (Name, Kunde, Kostenträger)" />
                    <Button Command="{Binding ToggleAddPanelCommand}" Content="Neu" />
                    <Button Command="{Binding RefreshCommand}" Content="Aktualisieren" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Hauptkarte: Add-Flyout + DataGrid  -->
        <Border
            Grid.Row="1"
            Margin="16,8,16,16"
            Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Add Panel (ein-/ausblendbar)  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    Padding="12"
                    Background="#1F2A4D"
                    CornerRadius="12"
                    Visibility="{Binding IsAddPanelOpen, Converter={StaticResource BoolToVis}}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding NewProjektname}" />
                        <TextBox Grid.Column="1" Text="{Binding NewKunde}" />
                        <TextBox Grid.Column="2" Text="{Binding NewKostentraeger}" />

                        <StackPanel
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button Command="{Binding AddProjectCommand}" Content="Hinzufügen" />
                            <Button Command="{Binding ToggleAddPanelCommand}" Content="Abbrechen" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Tabelle  -->
                <DataGrid
                    Grid.Row="1"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding ProjectsView}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="2*"
                            Binding="{Binding Projektname}"
                            Header="Projekt" />
                        <DataGridTextColumn
                            Width="2*"
                            Binding="{Binding Kunde}"
                            Header="Kunde" />
                        <DataGridTextColumn
                            Width="2*"
                            Binding="{Binding Kostentraeger}"
                            Header="Kostenträger" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Buchungen}"
                            Header="Buchungen" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Stunden, StringFormat=0.##}"
                            Header="Stunden" />

                        <DataGridTemplateColumn Width="*" Header="Aktionen">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button
                                            MinHeight="30"
                                            Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="Löschen" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
