<UserControl
    x:Class="Zeitmanagement.Views.ProjectsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Zeitmanagement.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:Zeitmanagement.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:ProjectsViewModel}"
    d:DesignHeight="720"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:DecimalHoursToHHmmConverter x:Key="HoursToHHmm" />

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,0,0,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
        </Style>

        <!--  Gemeinsame Felder für "Neues Projekt" und "Projekt bearbeiten"  -->
        <Style x:Key="ProjectFormGrid" TargetType="Grid">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Kopf: Titel links, Suche und Aktionen rechts  -->
        <DockPanel Style="{StaticResource PageHeader}">
            <StackPanel
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <Grid Width="280">
                    <TextBox
                        Padding="32,7,8,7"
                        local:Ui.Placeholder="Suchen nach Name, Kunde, Kostenträger"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="11,0,0,0"
                        HorizontalAlignment="Left"
                        FontSize="13"
                        Foreground="{DynamicResource Theme.TextSubtle}"
                        IsHitTestVisible="False"
                        Style="{StaticResource Text.Icon}"
                        Text="&#xE721;" />
                </Grid>
                <Button
                    Margin="8,0,0,0"
                    local:Ui.Glyph="&#xE72C;"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Aktualisieren" />
                <Button
                    Margin="8,0,0,0"
                    local:Ui.Glyph="&#xE710;"
                    Command="{Binding ToggleAddPanelCommand}"
                    Content="Neues Projekt"
                    Style="{StaticResource Button.Primary}" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="Projekte" />
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="{Binding HeaderSubtitle}" />
            </StackPanel>
        </DockPanel>

        <Border
            Grid.Row="1"
            Margin="28,0,28,24"
            Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Zeitraum-Filter für Buchungen/Stunden  -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Muted}"
                        Text="Stunden im Zeitraum" />
                    <TextBox
                        Width="110"
                        local:Ui.Placeholder="Von (TT.MM.JJJJ)"
                        Text="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Von (TT.MM.JJJJ)" />
                    <TextBlock
                        Margin="8,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Muted}"
                        Text="–" />
                    <TextBox
                        Width="110"
                        local:Ui.Placeholder="Bis (TT.MM.JJJJ)"
                        Text="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Bis (TT.MM.JJJJ)" />
                    <Button
                        Margin="10,0,0,0"
                        local:Ui.Glyph="&#xE71C;"
                        Command="{Binding FilterProjectsCommand}"
                        Content="Filtern" />
                    <Button
                        Margin="6,0,0,0"
                        Command="{Binding ResetProjectsFilterCommand}"
                        Content="Zurücksetzen"
                        Style="{StaticResource Button.Ghost}" />
                </StackPanel>

                <!--  Neues Projekt  -->
                <Border
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    Style="{StaticResource Inset}"
                    Visibility="{Binding IsAddPanelOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Section}" Text="Neues Projekt" />
                        <Grid Style="{StaticResource ProjectFormGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox local:Ui.Placeholder="Projektname" Text="{Binding NewProjektname, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                local:Ui.Placeholder="Kunde"
                                Text="{Binding NewKunde, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Column="2"
                                Margin="10,0,0,0"
                                local:Ui.Placeholder="Kostenträger"
                                Text="{Binding NewKostentraeger, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox
                                Grid.Column="3"
                                Margin="16,0"
                                VerticalAlignment="Center"
                                Content="Extern (vom Kunden bezahlt)"
                                IsChecked="{Binding NewIstExtern}"
                                ToolTip="Vom Kunden bezahlt. Externe Zeit deckt parallele interne Zeit in der SAP-Verrechnung ab." />
                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                <Button
                                    local:Ui.Glyph="&#xE710;"
                                    Command="{Binding AddProjectCommand}"
                                    Content="Hinzufügen"
                                    Style="{StaticResource Button.Primary}" />
                                <Button
                                    Margin="6,0,0,0"
                                    Command="{Binding ToggleAddPanelCommand}"
                                    Content="Abbrechen" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Projekt bearbeiten  -->
                <Border
                    Grid.Row="2"
                    Margin="0,16,0,0"
                    Background="{DynamicResource Theme.AccentSoft}"
                    BorderBrush="{DynamicResource Theme.Accent}"
                    Style="{StaticResource Inset}"
                    Visibility="{Binding IsEditPanelOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Theme.AccentSoftText}"
                            Style="{StaticResource Text.Section}"
                            Text="Projekt bearbeiten" />
                        <Grid Style="{StaticResource ProjectFormGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox local:Ui.Placeholder="Projektname" Text="{Binding EditProjektname, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                local:Ui.Placeholder="Kunde"
                                Text="{Binding EditKunde, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Column="2"
                                Margin="10,0,0,0"
                                local:Ui.Placeholder="Kostenträger"
                                Text="{Binding EditKostentraeger, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox
                                Grid.Column="3"
                                Margin="16,0"
                                VerticalAlignment="Center"
                                Content="Extern (vom Kunden bezahlt)"
                                IsChecked="{Binding EditIstExtern}"
                                ToolTip="Vom Kunden bezahlt. Externe Zeit deckt parallele interne Zeit in der SAP-Verrechnung ab." />
                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                <Button
                                    local:Ui.Glyph="&#xE74E;"
                                    Command="{Binding SaveEditProjectCommand}"
                                    Content="Speichern"
                                    Style="{StaticResource Button.Primary}" />
                                <Button
                                    Margin="6,0,0,0"
                                    Command="{Binding CancelEditProjectCommand}"
                                    Content="Abbrechen" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Tabelle  -->
                <DataGrid
                    Grid.Row="3"
                    Margin="0,16,0,0"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding ProjectsView}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn
                            Width="2*"
                            Header="Projekt"
                            SortMemberPath="Projektname">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Style="{StaticResource Text.Body}"
                                        Text="{Binding Projektname}"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="2*"
                            Binding="{Binding Kunde}"
                            Header="Kunde" />
                        <DataGridTextColumn
                            Width="2*"
                            Binding="{Binding Kostentraeger}"
                            Header="Kostenträger" />
                        <DataGridTemplateColumn
                            Width="*"
                            Header="Typ"
                            SortMemberPath="TypText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="8,2"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource Theme.Surface}"
                                        BorderBrush="{DynamicResource Theme.CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource Theme.TextMuted}"
                                            Text="{Binding TypText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Buchungen}"
                            Header="Buchungen" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Stunden, Converter={StaticResource HoursToHHmm}}"
                            Header="Stunden"
                            SortMemberPath="Stunden" />
                        <DataGridTemplateColumn Width="Auto" Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button
                                            local:Ui.Glyph="&#xE70F;"
                                            Command="{Binding DataContext.StartEditProjectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource Button.IconGhost}"
                                            ToolTip="Bearbeiten" />
                                        <Button
                                            Margin="4,0,0,0"
                                            local:Ui.Glyph="&#xE74D;"
                                            Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Foreground="{DynamicResource Theme.Danger}"
                                            Style="{StaticResource Button.IconGhost}"
                                            ToolTip="Löschen" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
