<UserControl
    x:Class="Zeitmanagement.Views.ProjectsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Zeitmanagement.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:Zeitmanagement.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:ProjectsViewModel}"
    d:DesignHeight="720"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:DecimalHoursToHHmmConverter x:Key="HoursToHHmm" />
    </UserControl.Resources>

    <Grid Style="{StaticResource Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Kopf: Titel links, Suche und Aktionen rechts  -->
        <DockPanel Style="{StaticResource PageHeader}">
            <StackPanel
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <Grid Width="280">
                    <TextBox
                        Padding="32,7,8,7"
                        local:Ui.Placeholder="Suchen nach Name, Kunde, Kostenträger"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="11,0,0,0"
                        HorizontalAlignment="Left"
                        FontSize="13"
                        Foreground="{DynamicResource Theme.TextSubtle}"
                        IsHitTestVisible="False"
                        Style="{StaticResource Text.Icon}"
                        Text="&#xE721;" />
                </Grid>
                <Button
                    Margin="8,0,0,0"
                    local:Ui.Glyph="&#xE72C;"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Aktualisieren" />
                <Button
                    Margin="8,0,0,0"
                    local:Ui.Glyph="&#xE710;"
                    Command="{Binding NewProjectCommand}"
                    Content="Neues Projekt"
                    Style="{StaticResource Button.Primary}" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="Projekte" />
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="{Binding HeaderSubtitle}" />
            </StackPanel>
        </DockPanel>

        <Border
            Grid.Row="1"
            Margin="28,0,28,24"
            Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Zeitraum-Filter für Buchungen/Stunden; rechts die Standardrundung (Einstellung nur im Overlay)  -->
                <DockPanel>
                    <StackPanel
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource Text.Muted}"
                            Text="{Binding GlobalRoundingText}"
                            ToolTip="Gilt für alle Projekte ohne eigene Rundung" />
                        <Button
                            Margin="4,0,0,0"
                            local:Ui.Glyph="&#xE70F;"
                            Command="{Binding EditGlobalRoundingCommand}"
                            Style="{StaticResource Button.IconGhost}"
                            ToolTip="Standardrundung ändern" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource Text.Muted}"
                            Text="Stunden im Zeitraum" />
                        <TextBox
                            Width="110"
                            local:Ui.Placeholder="Von (TT.MM.JJJJ)"
                            Text="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Von (TT.MM.JJJJ)" />
                        <TextBlock
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource Text.Muted}"
                            Text="–" />
                        <TextBox
                            Width="110"
                            local:Ui.Placeholder="Bis (TT.MM.JJJJ)"
                            Text="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Bis (TT.MM.JJJJ)" />
                        <Button
                            Margin="10,0,0,0"
                            local:Ui.Glyph="&#xE71C;"
                            Command="{Binding FilterProjectsCommand}"
                            Content="Filtern" />
                        <Button
                            Margin="6,0,0,0"
                            Command="{Binding ResetProjectsFilterCommand}"
                            Content="Zurücksetzen"
                            Style="{StaticResource Button.Ghost}" />
                    </StackPanel>
                </DockPanel>

                <!--  Tabelle  -->
                <DataGrid
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding ProjectsView}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn
                            Width="2*"
                            Header="Projekt"
                            SortMemberPath="Projektname">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Style="{StaticResource Text.Body}"
                                        Text="{Binding Projektname}"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="2*"
                            Binding="{Binding Kunde}"
                            Header="Kunde" />
                        <DataGridTextColumn
                            Width="2*"
                            Binding="{Binding Kostentraeger}"
                            Header="Kostenträger" />
                        <DataGridTemplateColumn
                            Width="*"
                            Header="Typ"
                            SortMemberPath="TypText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="8,2"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource Theme.Surface}"
                                        BorderBrush="{DynamicResource Theme.CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource Theme.TextMuted}"
                                            Text="{Binding TypText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn
                            Width="*"
                            Header="Rundung"
                            SortMemberPath="RundungMinuten">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Style="{StaticResource Text.Muted}"
                                        Text="{Binding RundungText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Buchungen}"
                            Header="Buchungen" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Stunden, Converter={StaticResource HoursToHHmm}}"
                            Header="Stunden"
                            SortMemberPath="Stunden" />
                        <DataGridTemplateColumn
                            Width="Auto"
                            Header="Quick Switch"
                            SortMemberPath="QuickSelectAktiv">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!--
                                        UpdateSourceTrigger ausdrücklich auf PropertyChanged: Die Zeilen des DataGrids hängen an
                                        einer BindingGroup, in der Standard-Bindings erst bei deren Commit schreiben - und der
                                        gibt es im schreibgeschützten Grid nie. Ohne das bliebe der Schalter wirkungslos.
                                    -->
                                    <CheckBox
                                        HorizontalAlignment="Center"
                                        IsChecked="{Binding QuickSelectAktiv, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource Switch}"
                                        ToolTip="Ein: Das Projekt ist im Quick Switch wählbar. Aus: Es wird dort nicht angeboten. Bestehende Buchungen bleiben unberührt." />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="Auto" Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button
                                            Margin="0,0,4,0"
                                            local:Ui.Glyph="&#xE9F9;"
                                            Command="{Binding DataContext.OpenControllingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource Button.IconGhost}"
                                            ToolTip="Projektcontrolling: importierte SAP-Kosten zu diesem Kostenträger anzeigen" />
                                        <Button
                                            Margin="0,0,4,0"
                                            local:Ui.Glyph="&#xE8A5;"
                                            Command="{Binding DataContext.OpenExportCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource Button.IconGhost}"
                                            ToolTip="Tätigkeitsnachweis: Buchungen dieses Projekts als PDF oder CSV exportieren" />
                                        <Button
                                            local:Ui.Glyph="&#xE70F;"
                                            Command="{Binding DataContext.StartEditProjectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource Button.IconGhost}"
                                            ToolTip="Bearbeiten" />
                                        <Button
                                            Margin="4,0,0,0"
                                            local:Ui.Glyph="&#xE74D;"
                                            Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Foreground="{DynamicResource Theme.Danger}"
                                            Style="{StaticResource Button.IconGhost}"
                                            ToolTip="Löschen" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
