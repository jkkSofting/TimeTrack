<UserControl
    x:Class="Zeitmanagement.Views.ProjectControllingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Zeitmanagement.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="clr-namespace:Zeitmanagement.MVVM"
    xmlns:viewmodel="clr-namespace:Zeitmanagement.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:ProjectControllingViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="1600"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Gibt Spalten (die nicht im visuellen Baum liegen) Zugriff auf das ViewModel  -->
        <mvvm:BindingProxy x:Key="Proxy" Data="{Binding}" />

        <Style
            x:Key="DetailLabel"
            BasedOn="{StaticResource Text.Label}"
            TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,3,12,3" />
        </Style>

        <Style
            x:Key="DetailValue"
            BasedOn="{StaticResource Text.Body}"
            TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,3,0,3" />
        </Style>

        <Style
            x:Key="WrapMuted"
            BasedOn="{StaticResource Text.Muted}"
            TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!--  Rechtsbündige Beträge; fehlende Werte ("Nicht geliefert") gedämpft  -->
        <Style
            x:Key="Amount"
            BasedOn="{StaticResource Text.Body}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <Style
            x:Key="AmountPlan"
            BasedOn="{StaticResource Amount}"
            TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding PlannedCost}" Value="{x:Null}">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.TextSubtle}" />
                    <Setter Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="AmountActual"
            BasedOn="{StaticResource Amount}"
            TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualCost}" Value="{x:Null}">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.TextSubtle}" />
                    <Setter Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="AmountRemaining"
            BasedOn="{StaticResource Amount}"
            TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RemainingCost}" Value="{x:Null}">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.TextSubtle}" />
                    <Setter Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Status: immer als Text, die Farbe unterstützt ihn nur  -->
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.CardBorder}" />
            <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasMissingPlan}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Theme.WarningSoft}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOverrun}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Theme.DangerSoft}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Alter des SAP-Stands; veraltete Stände fallen zusätzlich zum Text farblich auf  -->
        <Style
            x:Key="FreshnessText"
            BasedOn="{StaticResource Text.Muted}"
            TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStale}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.Warning}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Zeile aus Beschriftung und Wert  -->
        <DataTemplate x:Key="DetailRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="DetailLabel" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource DetailLabel}" Text="{Binding Label}" />
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource DetailValue}"
                    Text="{Binding Value}"
                    ToolTip="{Binding Tooltip}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DiagnosticSeverity">
            <TextBlock FontWeight="SemiBold" Text="{Binding SeverityText}">
                <TextBlock.Style>
                    <Style BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Danger}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Warning}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelPreviewCommand}" />
    </UserControl.InputBindings>

    <Grid Style="{StaticResource Page}">

        <!--  ===================== Seite =====================  -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Kopf: Titel, Stand und Datei links, Aktionen rechts  -->
            <DockPanel Style="{StaticResource PageHeader}">
                <StackPanel
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button
                        Margin="8,0,0,0"
                        local:Ui.Glyph="&#xE72C;"
                        AutomationProperties.Name="Aktualisieren"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource Button.Icon}"
                        ToolTip="Aktualisieren" />
                    <Button
                        Margin="8,0,0,0"
                        local:Ui.Glyph="&#xE74D;"
                        AutomationProperties.Name="Gewählten Import löschen"
                        Command="{Binding DeleteImportCommand}"
                        Foreground="{DynamicResource Theme.Danger}"
                        Style="{StaticResource Button.Icon}"
                        ToolTip="Den gewählten Import löschen (frühere Revisionen werden wieder aktiv)" />
                    <Button
                        Margin="8,0,0,0"
                        local:Ui.Glyph="&#xE8E5;"
                        Command="{Binding ImportCommand}"
                        Content="Excel importieren"
                        Style="{StaticResource Button.Primary}"
                        ToolTip="SAP-Projektcontrolling-Datei (.xlsx) einlesen. Es werden nur PSP-Elemente übernommen, die in einem bestehenden Kostenträger enthalten sind." />
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="Projektcontrolling" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Subtitle}" Text="SAP-Kosten zu deinen Kostenträgern – nur lesend, getrennt von den Stunden" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!--  Rückmeldung  -->
            <Border
                Grid.Row="1"
                Margin="28,0,28,12"
                Background="{DynamicResource Theme.AccentSoft}"
                BorderBrush="{DynamicResource Theme.Accent}"
                Style="{StaticResource Inset}"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        local:Ui.Glyph="&#xE711;"
                        AutomationProperties.Name="Meldung schließen"
                        Command="{Binding DismissMessageCommand}"
                        DockPanel.Dock="Right"
                        Style="{StaticResource Button.IconGhost}"
                        ToolTip="Schließen" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Theme.AccentSoftText}"
                        Style="{StaticResource Text.Body}"
                        Text="{Binding StatusMessage}"
                        TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!--  Kennzahlen des gewählten Importstands  -->
            <Grid
                Grid.Row="2"
                Margin="28,0,28,12"
                Visibility="{Binding HasImports, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Muted}"
                        Text="Importstand" />
                    <ComboBox
                        MinWidth="380"
                        AutomationProperties.Name="Importstand wählen"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding Imports}"
                        SelectedItem="{Binding SelectedImport, Mode=TwoWay}"
                        ToolTip="Jeder Import ist eine unveränderliche Charge. Der neueste SAP-Stand ist vorausgewählt." />
                </StackPanel>

                <WrapPanel
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center">
                    <Border Margin="0,2,8,2" Style="{StaticResource Pill}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Muted}" Text="Kostenträger " />
                            <TextBlock FontWeight="SemiBold" Style="{StaticResource Text.Body}" Text="{Binding MatchedCountText}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,2,8,2" Style="{StaticResource Pill}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Muted}" Text="Lokale Projekte " />
                            <TextBlock FontWeight="SemiBold" Style="{StaticResource Text.Body}" Text="{Binding LinkedProjectCountText}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,2,8,2" Style="{StaticResource Pill}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Muted}" Text="Warnungen " />
                            <TextBlock FontWeight="SemiBold" Style="{StaticResource Text.Body}" Text="{Binding WarningCountText}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,2,8,2" Style="{StaticResource Pill}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding SourceText}" />
                            <TextBlock
                                Margin="8,0,0,0"
                                Style="{StaticResource FreshnessText}"
                                Text="{Binding FreshnessText}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,2,8,2" Style="{StaticResource Pill}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Muted}" Text="Währung " />
                            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding CurrencyText}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>

            <!--  ===== Leerzustand: noch nichts importiert =====  -->
            <Border
                Grid.Row="3"
                MaxWidth="720"
                Margin="28,24,28,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Style="{StaticResource Card}"
                Visibility="{Binding HasNoImports, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Section}" Text="Noch kein Import" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource Text.Body}"
                        Text="Lade eine SAP-Projektcontrolling-Datei (.xlsx), um Plan- und Ist-Kosten zu deinen Kostenträgern zu sehen."
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource WrapMuted}"
                        Text="Der Kostenträger eines Projekts muss die PSP-Element-ID aus SAP enthalten (er muss ihr nicht gleichen). Es werden nur passende PSP-Elemente übernommen – es werden keine Projekte, Kostenträger oder Buchungen angelegt oder verändert. Die Datei enthält Geldbeträge, keine Stunden: Der Stundenverlauf stammt aus deinen lokalen Buchungen." />
                    <Button
                        Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        local:Ui.Glyph="&#xE8E5;"
                        Command="{Binding ImportCommand}"
                        Content="Excel importieren"
                        Style="{StaticResource Button.Primary}" />
                </StackPanel>
            </Border>

            <!--  ===== Übersicht und Details =====  -->
            <Grid
                x:Name="ContentGrid"
                Grid.Row="3"
                Margin="28,0,28,24"
                Visibility="{Binding HasImports, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="DetailColumn" Width="600" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="DetailRow" Height="0" />
                </Grid.RowDefinitions>

                <!--  Übersicht  -->
                <Border
                    x:Name="OverviewCard"
                    Margin="0,0,12,0"
                    Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <WrapPanel VerticalAlignment="Center">
                            <Grid Width="260" Margin="0,0,8,6">
                                <TextBox
                                    Padding="32,7,8,7"
                                    local:Ui.Placeholder="Suchen: Projekt, Kostenträger, PSP, Kunde"
                                    AutomationProperties.Name="Suche in der Übersicht"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="Durchsucht lokale Projekte, Kostenträger, SAP-Projekt, PSP-Name, Kunden und Projektleiter. Die Suche ändert nichts daran, was importiert wird." />
                                <TextBlock
                                    Margin="11,0,0,0"
                                    HorizontalAlignment="Left"
                                    FontSize="13"
                                    Foreground="{DynamicResource Theme.TextSubtle}"
                                    IsHitTestVisible="False"
                                    Style="{StaticResource Text.Icon}"
                                    Text="&#xE721;" />
                            </Grid>

                            <Border
                                Margin="0,0,8,6"
                                Padding="3"
                                Background="{DynamicResource Theme.Surface}"
                                BorderBrush="{DynamicResource Theme.CardBorder}"
                                BorderThickness="1"
                                CornerRadius="9">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton
                                        Content="{Binding BatchModeText}"
                                        GroupName="ControllingMode"
                                        IsChecked="{Binding IsBatchMode, Mode=TwoWay}"
                                        Style="{StaticResource Segment}"
                                        ToolTip="Genau die Zeilen des gewählten Imports" />
                                    <RadioButton
                                        Content="{Binding LastKnownModeText}"
                                        GroupName="ControllingMode"
                                        IsChecked="{Binding IsLastKnownMode, Mode=TwoWay}"
                                        Style="{StaticResource Segment}"
                                        ToolTip="Zuletzt bekannter Stand für Kostenträger, die im gewählten Import fehlen" />
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,0,8,6" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Text.Muted}"
                                    Text="Projektleiter" />
                                <ComboBox
                                    MinWidth="130"
                                    AutomationProperties.Name="Nach Projektleiter filtern"
                                    ItemsSource="{Binding Managers}"
                                    SelectedItem="{Binding ManagerFilter, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Margin="0,0,8,6" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Text.Muted}"
                                    Text="Status" />
                                <ComboBox
                                    MinWidth="130"
                                    AutomationProperties.Name="Nach Projektstatus filtern"
                                    ItemsSource="{Binding Statuses}"
                                    SelectedItem="{Binding StatusFilter, Mode=TwoWay}" />
                            </StackPanel>

                            <CheckBox
                                Margin="0,0,12,6"
                                VerticalAlignment="Center"
                                Content="Plan fehlt"
                                IsChecked="{Binding OnlyMissingPlan}"
                                ToolTip="Nur Zeilen ohne gelieferten Planbetrag" />
                            <CheckBox
                                Margin="0,0,12,6"
                                VerticalAlignment="Center"
                                Content="Budget überschritten"
                                IsChecked="{Binding OnlyOverrun}"
                                ToolTip="Nur Zeilen, deren Ist den positiven Plan übersteigt" />
                            <Button
                                Margin="0,0,0,6"
                                Command="{Binding ResetFiltersCommand}"
                                Content="Zurücksetzen"
                                Style="{StaticResource Button.Ghost}" />
                        </WrapPanel>

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,2,0,8"
                            Style="{StaticResource WrapMuted}"
                            Text="{Binding ModeHint}" />

                        <DataGrid
                            x:Name="OverviewGrid"
                            Grid.Row="2"
                            AutoGenerateColumns="False"
                            AutomationProperties.Name="Übersicht der importierten PSP-Elemente"
                            CanUserAddRows="False"
                            CanUserResizeColumns="True"
                            EnableColumnVirtualization="True"
                            EnableRowVirtualization="True"
                            HorizontalScrollBarVisibility="Auto"
                            IsReadOnly="True"
                            ItemsSource="{Binding RowsView}"
                            SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                            VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn
                                    Width="230"
                                    MinWidth="140"
                                    Header="Kostenträger (PSP-Element)"
                                    SortMemberPath="CarrierText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Button
                                                    Margin="6,0,0,0"
                                                    local:Ui.Glyph="&#xE8C8;"
                                                    AutomationProperties.Name="Kostenträger kopieren"
                                                    Command="{Binding DataContext.CopyCarrierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    DockPanel.Dock="Right"
                                                    Style="{StaticResource Button.IconGhost}"
                                                    ToolTip="Kostenträger kopieren" />
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Style="{StaticResource Text.Body}"
                                                    Text="{Binding CarrierText}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding CarrierText}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="190"
                                    MinWidth="100"
                                    Header="Lokale Projekte"
                                    SortMemberPath="LinkedProjectNames">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Style="{StaticResource Text.Body}"
                                                Text="{Binding LinkedProjectNames}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding LinkedProjectNames}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="210"
                                    MinWidth="100"
                                    Header="PSP-Name"
                                    SortMemberPath="PspName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Style="{StaticResource Text.Body}"
                                                Text="{Binding PspName}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding PspName}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="190"
                                    MinWidth="100"
                                    Header="SAP-Projekt"
                                    SortMemberPath="ParentName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Style="{StaticResource Text.Body}"
                                                Text="{Binding ParentName}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding ParentName}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="130"
                                    MinWidth="90"
                                    Header="Plan"
                                    SortMemberPath="PlannedCost">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource AmountPlan}" Text="{Binding PlannedText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="130"
                                    MinWidth="90"
                                    Header="Ist"
                                    SortMemberPath="ActualCost">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource AmountActual}" Text="{Binding ActualText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="130"
                                    MinWidth="90"
                                    Header="Rest"
                                    SortMemberPath="RemainingCost">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource AmountRemaining}" Text="{Binding RemainingText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="140"
                                    MinWidth="90"
                                    Header="Budgetverbrauch"
                                    SortMemberPath="Consumption">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource Text.Body}"
                                                Text="{Binding ConsumptionText}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding ConsumptionText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="170"
                                    MinWidth="110"
                                    Header="Status"
                                    SortMemberPath="StatusText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusPill}">
                                                <TextBlock
                                                    FontSize="12"
                                                    Text="{Binding StatusText}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="190"
                                    MinWidth="110"
                                    Header="SAP-Stand"
                                    SortMemberPath="SourceTimestamp">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding SourceText}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Style="{StaticResource Text.Muted}"
                                                    Text="{Binding NoteText}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!--  Leerzustand der Tabelle  -->
                        <TextBlock
                            Grid.Row="2"
                            MaxWidth="520"
                            Margin="0,40,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Style="{StaticResource WrapMuted}"
                            Text="{Binding EmptyRowsText}"
                            TextAlignment="Center">
                            <TextBlock.Visibility>
                                <Binding Converter="{StaticResource BoolToVis}" Path="ShowEmptyRowsHint" />
                            </TextBlock.Visibility>
                        </TextBlock>

                        <TextBlock
                            Grid.Row="3"
                            Margin="0,8,0,0"
                            Style="{StaticResource Text.Muted}"
                            Text="{Binding VisibleCountText}" />
                    </Grid>
                </Border>

                <!--  Details: neben der Übersicht, bei wenig Platz darunter (siehe Code-Behind)  -->
                <Border
                    x:Name="DetailCard"
                    Grid.Column="1"
                    Style="{StaticResource Card}">
                    <Grid>
                        <!--  Noch keine Auswahl  -->
                        <StackPanel
                            VerticalAlignment="Top"
                            Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Text.Section}" Text="Details" />
                            <TextBlock
                                Margin="0,8,0,0"
                                Style="{StaticResource WrapMuted}"
                                Text="Wähle eine Zeile, um Kostenträger, SAP-Projektkontext, Kostenverlauf und den lokalen Stundenverlauf zu sehen." />
                        </StackPanel>

                        <ScrollViewer
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <StackPanel Grid.IsSharedSizeScope="True">

                                <!--  Kopf der Auswahl  -->
                                <DockPanel>
                                    <Button
                                        VerticalAlignment="Top"
                                        local:Ui.Glyph="&#xE8C8;"
                                        AutomationProperties.Name="Kostenträger kopieren"
                                        Command="{Binding CopyCarrierCommand}"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource Button.IconGhost}"
                                        ToolTip="Kostenträger kopieren" />
                                    <StackPanel>
                                        <TextBlock
                                            Style="{StaticResource Text.Section}"
                                            Text="{Binding SelectedRow.CarrierText}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Style="{StaticResource Text.Muted}"
                                            Text="{Binding SelectedRow.PspName}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>

                                <!--  Lokale Projekte  -->
                                <TextBlock
                                    Margin="0,14,0,4"
                                    Style="{StaticResource Text.Label}"
                                    Text="LOKALE PROJEKTE" />
                                <ItemsControl ItemsSource="{Binding DetailProjects}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2" Orientation="Horizontal">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Style="{StaticResource Text.Body}"
                                                    Text="{Binding Name}" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    Style="{StaticResource Text.Muted}"
                                                    Text="{Binding Customer, StringFormat='· Kunde (lokal): {0}'}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--  Kernwerte des gewählten PSP-Elements  -->
                                <UniformGrid
                                    Margin="0,14,0,0"
                                    Columns="4">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource Text.Label}" Text="Plan" />
                                        <TextBlock Style="{StaticResource AmountPlan}" HorizontalAlignment="Left" DataContext="{Binding SelectedRow}" Text="{Binding PlannedText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource Text.Label}" Text="Ist" />
                                        <TextBlock Style="{StaticResource AmountActual}" HorizontalAlignment="Left" DataContext="{Binding SelectedRow}" Text="{Binding ActualText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource Text.Label}" Text="Rest" />
                                        <TextBlock Style="{StaticResource AmountRemaining}" HorizontalAlignment="Left" DataContext="{Binding SelectedRow}" Text="{Binding RemainingText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Label}" Text="Verbrauch" />
                                        <TextBlock
                                            Style="{StaticResource Text.Body}"
                                            Text="{Binding SelectedRow.ConsumptionText}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </UniformGrid>
                                <Border
                                    Margin="0,8,0,0"
                                    DataContext="{Binding SelectedRow}"
                                    Style="{StaticResource StatusPill}">
                                    <TextBlock FontSize="12" Text="{Binding StatusText}" />
                                </Border>

                                <!--  Stammdaten  -->
                                <TextBlock
                                    Margin="0,14,0,4"
                                    Style="{StaticResource Text.Label}"
                                    Text="KOSTENTRÄGER UND HERKUNFT" />
                                <ItemsControl ItemTemplate="{StaticResource DetailRow}" ItemsSource="{Binding DetailItems}" />

                                <!--  SAP-Projektkontext (projektweit)  -->
                                <Button
                                    Margin="0,14,0,0"
                                    HorizontalAlignment="Left"
                                    local:Ui.Glyph="&#xE70D;"
                                    Command="{Binding ToggleContextCommand}"
                                    Content="SAP-Projektkontext – gilt für das ganze Projekt, nicht für dieses PSP-Element"
                                    Style="{StaticResource Button.Ghost}"
                                    ToolTip="Auftragswerte, Abrechnung und Fortschritt gelten für das SAP-Projekt insgesamt und werden nie über dessen PSP-Elemente summiert." />
                                <StackPanel Visibility="{Binding IsContextExpanded, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Style="{StaticResource WrapMuted}"
                                        Text="Projektweite Werte. Nicht verfügbar heißt: Die Datei liefert keinen eindeutigen Wert – nicht null."
                                        Visibility="{Binding HasContext, Converter={StaticResource BoolToVis}}" />
                                    <ItemsControl
                                        Margin="0,4,0,0"
                                        ItemTemplate="{StaticResource DetailRow}"
                                        ItemsSource="{Binding ContextItems}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Style="{StaticResource WrapMuted}"
                                        Text="Zu diesem Projekt wurde kein Kontext importiert (Blätter fehlten oder passten nicht zum Layout)."
                                        Visibility="{Binding HasNoContext, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <!--  Reiter  -->
                                <Border
                                    Margin="0,16,0,10"
                                    Padding="3"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Theme.Surface}"
                                    BorderBrush="{DynamicResource Theme.CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton
                                            Content="Kostenverlauf"
                                            GroupName="DetailTab"
                                            IsChecked="{Binding IsCostTab, Mode=TwoWay}"
                                            Style="{StaticResource Segment}" />
                                        <RadioButton
                                            Content="Lokaler Stundenverlauf"
                                            GroupName="DetailTab"
                                            IsChecked="{Binding IsHoursTab, Mode=TwoWay}"
                                            Style="{StaticResource Segment}" />
                                        <RadioButton
                                            Content="Importdetails"
                                            GroupName="DetailTab"
                                            IsChecked="{Binding IsImportTab, Mode=TwoWay}"
                                            Style="{StaticResource Segment}" />
                                    </StackPanel>
                                </Border>

                                <!--  Kostenverlauf  -->
                                <StackPanel Visibility="{Binding IsCostTab, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource WrapMuted}" Text="{Binding CostDisclaimer}" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource Text.Body}"
                                        Text="{Binding CostHistoryNote}"
                                        TextWrapping="Wrap" />
                                    <DataGrid
                                        Margin="0,8,0,0"
                                        AutoGenerateColumns="False"
                                        AutomationProperties.Name="Kostenverlauf nach SAP-Stand"
                                        CanUserAddRows="False"
                                        CanUserResizeColumns="True"
                                        HorizontalScrollBarVisibility="Auto"
                                        IsReadOnly="True"
                                        ItemsSource="{Binding CostHistory}"
                                        MaxHeight="300"
                                        RowHeight="34"
                                        SelectedItem="{Binding SelectedHistoryItem, Mode=TwoWay}"
                                        VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="130" Binding="{Binding SourceText}" Header="SAP-Stand" />
                                            <DataGridTextColumn Width="110" Binding="{Binding PlannedText}" Header="Plan" />
                                            <DataGridTextColumn Width="110" Binding="{Binding ActualText}" Header="Ist" />
                                            <DataGridTextColumn Width="110" Binding="{Binding RemainingText}" Header="Rest" />
                                            <DataGridTextColumn Width="120" Binding="{Binding ConsumptionText}" Header="Verbrauch" />
                                            <DataGridTextColumn Width="110" Binding="{Binding PlanDeltaText}" Header="Δ Plan" />
                                            <DataGridTextColumn Width="110" Binding="{Binding ActualDeltaText}" Header="Δ Ist" />
                                            <DataGridTextColumn Width="200" Binding="{Binding FileName}" Header="Datei" />
                                            <DataGridTextColumn Width="200" Binding="{Binding RevisionText}" Header="Import / Revision" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock
                                        Margin="0,12,0,4"
                                        Style="{StaticResource Text.Label}"
                                        Text="REVISIONEN DES GEWÄHLTEN STANDS" />
                                    <DataGrid
                                        AutoGenerateColumns="False"
                                        AutomationProperties.Name="Revisionen des gewählten Stands"
                                        CanUserAddRows="False"
                                        HorizontalScrollBarVisibility="Auto"
                                        IsReadOnly="True"
                                        ItemsSource="{Binding Revisions}"
                                        MaxHeight="170"
                                        RowHeight="32"
                                        VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="90" Binding="{Binding ImportText}" Header="Import" />
                                            <DataGridTextColumn Width="130" Binding="{Binding ImportedText}" Header="Importiert am" />
                                            <DataGridTextColumn Width="160" Binding="{Binding FileName}" Header="Datei" />
                                            <DataGridTextColumn Width="110" Binding="{Binding PlannedText}" Header="Plan" />
                                            <DataGridTextColumn Width="110" Binding="{Binding ActualText}" Header="Ist" />
                                            <DataGridTextColumn Width="90" Binding="{Binding StateText}" Header="Stand" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>

                                <!--  Lokaler Stundenverlauf  -->
                                <StackPanel Visibility="{Binding IsHoursTab, Converter={StaticResource BoolToVis}}">
                                    <Border
                                        Padding="10"
                                        Background="{DynamicResource Theme.WarningSoft}"
                                        BorderBrush="{DynamicResource Theme.Warning}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <TextBlock
                                            Foreground="{DynamicResource Theme.Warning}"
                                            Style="{StaticResource WrapMuted}"
                                            Text="{Binding HoursDisclaimer}" />
                                    </Border>

                                    <WrapPanel Margin="0,10,0,0">
                                        <Border
                                            Margin="0,0,10,6"
                                            Padding="3"
                                            Background="{DynamicResource Theme.Surface}"
                                            BorderBrush="{DynamicResource Theme.CardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="9">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Content="Tag" GroupName="HoursKind" IsChecked="{Binding IsHoursDay, Mode=TwoWay}" Style="{StaticResource Segment}" />
                                                <RadioButton Content="Woche" GroupName="HoursKind" IsChecked="{Binding IsHoursWeek, Mode=TwoWay}" Style="{StaticResource Segment}" ToolTip="ISO-Wochen, beginnend am Montag" />
                                                <RadioButton Content="Monat" GroupName="HoursKind" IsChecked="{Binding IsHoursMonth, Mode=TwoWay}" Style="{StaticResource Segment}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBox
                                            Width="110"
                                            Margin="0,0,6,6"
                                            local:Ui.Placeholder="Von (TT.MM.JJJJ)"
                                            AutomationProperties.Name="Stundenverlauf von Datum"
                                            Text="{Binding HoursStartText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox
                                            Width="110"
                                            Margin="0,0,6,6"
                                            local:Ui.Placeholder="Bis (TT.MM.JJJJ)"
                                            AutomationProperties.Name="Stundenverlauf bis Datum"
                                            Text="{Binding HoursEndText, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Margin="0,0,10,6"
                                            Command="{Binding ResetHoursRangeCommand}"
                                            Content="Zeitraum zurücksetzen"
                                            Style="{StaticResource Button.Ghost}" />
                                        <CheckBox
                                            Margin="0,0,0,6"
                                            VerticalAlignment="Center"
                                            Content="Kumuliert anzeigen"
                                            IsChecked="{Binding ShowCumulative}" />
                                    </WrapPanel>

                                    <TextBlock
                                        Margin="0,2,0,4"
                                        Style="{StaticResource Text.Label}"
                                        Text="PROJEKTE" />
                                    <ItemsControl ItemsSource="{Binding HoursProjects}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox
                                                    Margin="0,0,14,4"
                                                    Content="{Binding Name}"
                                                    IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource Text.Body}"
                                        Text="{Binding HoursTotalText}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        Style="{StaticResource WrapMuted}"
                                        Text="{Binding HoursMessage}"
                                        Visibility="{Binding HasHoursMessage, Converter={StaticResource BoolToVis}}" />

                                    <DataGrid
                                        Margin="0,8,0,0"
                                        AutoGenerateColumns="False"
                                        AutomationProperties.Name="Lokal erfasste Stunden"
                                        CanUserAddRows="False"
                                        CanUserResizeColumns="True"
                                        HorizontalScrollBarVisibility="Auto"
                                        IsReadOnly="True"
                                        ItemsSource="{Binding HoursBuckets}"
                                        MaxHeight="340"
                                        RowHeight="34"
                                        VerticalScrollBarVisibility="Auto"
                                        Visibility="{Binding HasHours, Converter={StaticResource BoolToVis}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="150" Binding="{Binding Label}" Header="Zeitraum" />
                                            <DataGridTextColumn Width="110" Binding="{Binding HoursText}" Header="Lokale Stunden" SortMemberPath="Minutes" />
                                            <DataGridTextColumn Width="80" Binding="{Binding HoursClockText}" Header="h:mm" SortMemberPath="Minutes" />
                                            <DataGridTextColumn
                                                Width="110"
                                                Binding="{Binding CumulativeText}"
                                                Header="Kumuliert"
                                                SortMemberPath="CumulativeMinutes"
                                                Visibility="{Binding Data.ShowCumulative, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}" />
                                            <DataGridTextColumn Width="90" Binding="{Binding EntryCount}" Header="Buchungen" />
                                            <DataGridTemplateColumn Width="Auto" Header="">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button
                                                            local:Ui.Glyph="&#xE8A7;"
                                                            AutomationProperties.Name="Tag in den Stundenbuchungen öffnen"
                                                            Command="{Binding Data.OpenDayCommand, Source={StaticResource Proxy}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource Button.IconGhost}"
                                                            ToolTip="Ersten Tag dieses Zeitraums in den Stundenbuchungen öffnen (nur ansehen)" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>

                                <!--  Importdetails  -->
                                <StackPanel Visibility="{Binding IsImportTab, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource WrapMuted}" Text="Herkunft dieser Zeile. Zu nicht übernommenen Kostenträgern der Datei werden keine Daten gespeichert oder angezeigt." />
                                    <ItemsControl
                                        Margin="0,6,0,0"
                                        ItemTemplate="{StaticResource DetailRow}"
                                        ItemsSource="{Binding ImportItems}" />
                                    <TextBlock
                                        Margin="0,10,0,4"
                                        Style="{StaticResource Text.Label}"
                                        Text="WARNUNGEN DES IMPORTS" />
                                    <ItemsControl ItemsSource="{Binding ImportWarnings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Margin="0,2"
                                                    Style="{StaticResource WrapMuted}"
                                                    Text="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Left"
                                        local:Ui.Glyph="&#xE74D;"
                                        Command="{Binding DeleteImportCommand}"
                                        Content="Gewählten Import löschen"
                                        Foreground="{DynamicResource Theme.Danger}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--  ===================== Importvorschau =====================  -->
        <Grid
            Background="{DynamicResource Theme.AppBackground}"
            Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Style="{StaticResource PageHeader}">
                <StackPanel
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding CancelPreviewCommand}"
                        Content="Abbrechen"
                        ToolTip="Schließt die Vorschau, ohne etwas zu speichern (Esc)" />
                    <Button
                        Margin="8,0,0,0"
                        local:Ui.Glyph="&#xE74E;"
                        Command="{Binding ConfirmImportCommand}"
                        Content="Importieren"
                        Style="{StaticResource Button.Primary}"
                        ToolTip="Speichert den Import als neue, unveränderliche Charge" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="Importvorschau" />
                    <TextBlock Style="{StaticResource Text.Subtitle}" Text="{Binding PreviewFileText}" />
                </StackPanel>
            </DockPanel>

            <!--  Zusammenfassung, Stand, Währung  -->
            <Border
                Grid.Row="1"
                Margin="28,0,28,12"
                Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock
                        Style="{StaticResource Text.Body}"
                        Text="{Binding PreviewSummaryText}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource WrapMuted}"
                        Text="{Binding PreviewMissingText}"
                        Visibility="{Binding HasPreviewMissing, Converter={StaticResource BoolToVis}}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Text.Label}" Text="SAP-STAND" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource Text.Body}"
                                Text="{Binding TimestampStatusText}"
                                TextWrapping="Wrap" />
                            <TextBox
                                Margin="0,6,0,0"
                                local:Ui.Placeholder="TT.MM.JJJJ HH:mm"
                                AutomationProperties.Name="SAP-Stand angeben"
                                Text="{Binding UserTimestampText, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Stand der SAP-Daten, z. B. 09.11.2026 14:30. Weder Änderungsdatum der Datei noch Importzeit noch Dateiname werden stillschweigend verwendet."
                                Visibility="{Binding NeedsTimestampInput, Converter={StaticResource BoolToVis}}" />
                            <ComboBox
                                Margin="0,6,0,0"
                                AutomationProperties.Name="Maßgeblichen SAP-Stand wählen"
                                ItemsSource="{Binding TimestampChoices}"
                                SelectedItem="{Binding SelectedTimestampChoice, Mode=TwoWay}"
                                Visibility="{Binding NeedsTimestampChoice, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Text.Label}" Text="WÄHRUNG (OPTIONAL)" />
                            <TextBox
                                Margin="0,4,0,0"
                                HorizontalAlignment="Left"
                                local:Ui.Placeholder="z. B. EUR"
                                AutomationProperties.Name="Währungscode"
                                MaxLength="3"
                                Text="{Binding CurrencyCodeText, UpdateSourceTrigger=PropertyChanged}"
                                Width="120" />
                            <TextBlock
                                Margin="0,6,0,0"
                                Style="{StaticResource WrapMuted}"
                                Text="{Binding CurrencyHintText}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Meldungen (Fehler blockieren den Import)  -->
            <Border
                Grid.Row="2"
                MaxHeight="200"
                Margin="28,0,28,12"
                Style="{StaticResource Card}"
                Visibility="{Binding PreviewHasDiagnostics, Converter={StaticResource BoolToVis}}">
                <DataGrid
                    AutoGenerateColumns="False"
                    AutomationProperties.Name="Hinweise, Warnungen und Fehler der Datei"
                    CanUserAddRows="False"
                    CanUserResizeColumns="True"
                    HorizontalScrollBarVisibility="Auto"
                    IsReadOnly="True"
                    ItemsSource="{Binding PreviewDiagnostics}"
                    RowHeight="32"
                    VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn
                            Width="90"
                            CellTemplate="{StaticResource DiagnosticSeverity}"
                            Header="Art"
                            SortMemberPath="Severity" />
                        <DataGridTextColumn Width="*" Binding="{Binding Message}" Header="Meldung" />
                        <DataGridTextColumn Width="150" Binding="{Binding Location}" Header="Blatt / Zelle" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!--  Zeilen, die übernommen würden  -->
            <Border
                Grid.Row="3"
                Margin="28,0,28,24"
                Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource WrapMuted}"
                        Text="Diese PSP-Elemente würden übernommen. Fehlende Beträge sind „Nicht geliefert“, nicht null. Die Differenz zeigt die Veränderung zum letzten vergleichbaren Importstand (Geld, keine Stunden)." />
                    <DataGrid
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        AutomationProperties.Name="Vorschau der zu übernehmenden PSP-Elemente"
                        CanUserAddRows="False"
                        CanUserResizeColumns="True"
                        EnableRowVirtualization="True"
                        HorizontalScrollBarVisibility="Auto"
                        IsReadOnly="True"
                        ItemsSource="{Binding PreviewRows}"
                        VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="230" Binding="{Binding CarrierText}" Header="Kostenträger (PSP-Element)" />
                            <DataGridTextColumn Width="190" Binding="{Binding LinkedProjectNames}" Header="Lokale Projekte" />
                            <DataGridTextColumn Width="210" Binding="{Binding PspName}" Header="PSP-Name" />
                            <DataGridTextColumn Width="190" Binding="{Binding ExternalProjectName}" Header="SAP-Projekt" />
                            <DataGridTextColumn Width="120" Binding="{Binding PlannedText}" Header="Plan" SortMemberPath="PlannedCost" />
                            <DataGridTextColumn Width="120" Binding="{Binding ActualText}" Header="Ist" SortMemberPath="ActualCost" />
                            <DataGridTextColumn Width="120" Binding="{Binding RemainingText}" Header="Rest" SortMemberPath="RemainingCost" />
                            <DataGridTextColumn Width="340" Binding="{Binding ComparisonText}" Header="Vergleich mit letztem Stand" />
                            <DataGridTextColumn Width="130" Binding="{Binding SourceSheet}" Header="Quellblatt" />
                            <DataGridTextColumn Width="70" Binding="{Binding SourceRow}" Header="Zeile" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!--  ===================== Wartezustand =====================  -->
        <Grid
            Background="#99000000"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock
                        Style="{StaticResource Text.Section}"
                        Text="{Binding BusyText}" />
                    <ProgressBar
                        Height="6"
                        Margin="0,12,0,12"
                        IsIndeterminate="True"
                        MinWidth="260" />
                    <Button
                        HorizontalAlignment="Right"
                        Command="{Binding CancelBusyCommand}"
                        Content="Abbrechen" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
