<Window
    x:Class="Zeitmanagement.Views.PenguinWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="140"
    Height="100"
    AllowsTransparency="True"
    Background="Transparent"
    Focusable="False"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">
    <!--  Farben kommen aus dem gemeinsamen Maskottchen-Design (Views/Mascot.xaml)  -->

    <!--
        Der Pinguin ist höher als das Fenster (130 statt 100): Das Fenster schneidet ihn unten
        ab und sitzt genau auf der Oberkante der Taskleiste. Schiebt man den Pinguin per
        TranslateTransform nach unten, verschwindet er optisch "hinter" der Taskleiste.
    -->
    <Grid ClipToBounds="True">
        <Canvas
            Width="110"
            Height="130"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Cursor="Hand"
            MouseLeftButtonDown="Penguin_MouseLeftButtonDown">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="Shift" Y="100" />
            </Canvas.RenderTransform>

            <!--  Linke Flosse (aus Betrachtersicht), hängt locker herunter  -->
            <Ellipse
                Canvas.Left="12"
                Canvas.Top="54"
                Width="16"
                Height="46"
                Fill="{StaticResource MascotBodyBrush}"
                RenderTransformOrigin="0.5,0"
                Stroke="{StaticResource MascotOutlineBrush}"
                StrokeThickness="1.5">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="12" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <!--  Körper  -->
            <Ellipse
                Canvas.Left="22"
                Canvas.Top="14"
                Width="66"
                Height="120"
                Fill="{StaticResource MascotBodyBrush}"
                Stroke="{StaticResource MascotOutlineBrush}"
                StrokeThickness="1.5" />

            <!--  Bauch  -->
            <Ellipse
                Canvas.Left="33"
                Canvas.Top="46"
                Width="44"
                Height="100"
                Fill="{StaticResource MascotBellyBrush}" />

            <!--  Augen  -->
            <Ellipse
                Canvas.Left="38"
                Canvas.Top="27"
                Width="14"
                Height="14"
                Fill="{StaticResource MascotBellyBrush}" />
            <Ellipse
                Canvas.Left="58"
                Canvas.Top="27"
                Width="14"
                Height="14"
                Fill="{StaticResource MascotBellyBrush}" />
            <Ellipse
                Canvas.Left="43"
                Canvas.Top="31"
                Width="6"
                Height="6"
                Fill="Black" />
            <Ellipse
                Canvas.Left="61"
                Canvas.Top="31"
                Width="6"
                Height="6"
                Fill="Black" />

            <!--  Wangen  -->
            <Ellipse
                Canvas.Left="31"
                Canvas.Top="41"
                Width="9"
                Height="6"
                Fill="{StaticResource MascotCheekBrush}" />
            <Ellipse
                Canvas.Left="70"
                Canvas.Top="41"
                Width="9"
                Height="6"
                Fill="{StaticResource MascotCheekBrush}" />

            <!--  Schnabel  -->
            <Path
                Data="M 47,41 Q 55,37 63,41 Q 55,55 47,41 Z"
                Fill="{StaticResource MascotBeakBrush}" />

            <!--  Uhr auf dem Bauch (wie beim Maskottchen), Zeiger auf 10:10  -->
            <Path
                Data="M 55,61 A 13,13 0 1 1 54.99,61 Z M 55,63 L 55,65 M 66,74 L 64,74 M 55,85 L 55,83 M 44,74 L 46,74 M 55,74 L 49.4,70.8"
                Stroke="{StaticResource MascotBodyBrush}"
                StrokeEndLineCap="Round"
                StrokeStartLineCap="Round"
                StrokeThickness="2" />
            <Path
                Data="M 55,74 L 63.2,69.3"
                Stroke="{StaticResource MascotBeakBrush}"
                StrokeEndLineCap="Round"
                StrokeStartLineCap="Round"
                StrokeThickness="2" />
            <Ellipse
                Canvas.Left="53.4"
                Canvas.Top="72.4"
                Width="3.2"
                Height="3.2"
                Fill="{StaticResource MascotBodyBrush}" />

            <!--  Rechte Flosse (aus Betrachtersicht) - die winkende  -->
            <Ellipse
                Canvas.Left="82"
                Canvas.Top="54"
                Width="16"
                Height="46"
                Fill="{StaticResource MascotBodyBrush}"
                RenderTransformOrigin="0.5,0"
                Stroke="{StaticResource MascotOutlineBrush}"
                StrokeThickness="1.5">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="Flipper" Angle="-12" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>
    </Grid>
</Window>
