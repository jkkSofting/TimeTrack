<Window
    x:Class="Zeitmanagement.Views.PenguinWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="140"
    Height="100"
    AllowsTransparency="True"
    Background="Transparent"
    Focusable="False"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">
    <!--  Der Pinguin kommt aus dem gemeinsamen Maskottchen-Design (Views/Mascot.xaml)  -->

    <!--
        Der Pinguin ist höher als das Fenster (130 statt 100): Das Fenster schneidet ihn unten
        ab und sitzt genau auf der Oberkante der Taskleiste. Schiebt man den Pinguin per
        TranslateTransform nach unten, verschwindet er optisch "hinter" der Taskleiste.
    -->
    <Grid ClipToBounds="True">
        <Canvas
            Width="104"
            Height="130"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Cursor="Hand"
            MouseLeftButtonDown="Penguin_MouseLeftButtonDown">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="Shift" Y="100" />
            </Canvas.RenderTransform>

            <!--
                Rechte Flosse (aus Betrachtersicht) - die winkende, hinter dem Körper.
                Drehpunkt ist die Schulter (88,60 im 120 x 150 Maskottchen, hier auf 104 x 130 skaliert).
            -->
            <Image
                Width="104"
                Height="130"
                Source="{StaticResource MascotRightFlipperImage}">
                <Image.RenderTransform>
                    <RotateTransform x:Name="Flipper" CenterX="76.3" CenterY="52" Angle="0" />
                </Image.RenderTransform>
            </Image>

            <Image
                Width="104"
                Height="130"
                Source="{StaticResource MascotBodyImage}" />
        </Canvas>
    </Grid>
</Window>
