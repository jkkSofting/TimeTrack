<Window
    x:Class="Zeitmanagement.Views.FloatingQuickSelectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Zeitmanagement.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:Zeitmanagement.ViewModel"
    Title="Quick Switch"
    Width="330"
    d:DataContext="{d:DesignInstance Type=viewModel:QuickSelectViewModel}"
    ResizeMode="CanMinimize"
    ShowInTaskbar="True"
    SizeToContent="Height"
    Topmost="True"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--  Farben (identisch zum Quick-Select-Theme)  -->
        <Color x:Key="ColText">#F5F7FB</Color>
        <Color x:Key="ColTextMuted">#B7C0D8</Color>

        <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColText}" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColTextMuted}" />
        <SolidColorBrush x:Key="BrushAccent" Color="#1F2A4D" />

        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#0B1020" />
            <GradientStop Offset="1" Color="#121A33" />
        </LinearGradientBrush>

        <!--  Flat-Button  -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Background" Value="#2D3A63" />
            <Setter Property="BorderBrush" Value="#42507C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#34406E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Pin-Toggle (immer im Vordergrund)  -->
        <Style x:Key="PinToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Background" Value="#2D3A63" />
            <Setter Property="BorderBrush" Value="#42507C" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#6C7BAF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A7BD5" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#5B9BE8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Status-Punkt: grün wenn aktiv, grau wenn nicht  -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="#5B6785" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAnyActive}" Value="True">
                    <Setter Property="Fill" Value="#3DD68C" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Pretty ComboBox (aus dem Quick-Select-Theme übernommen)  -->
        <Style
            x:Key="NiceCombo"
            BasedOn="{StaticResource {x:Type ComboBox}}"
            TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Background" Value="#233055" />
            <Setter Property="BorderBrush" Value="#33406A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton
                                x:Name="ToggleButton"
                                ClickMode="Press"
                                Focusable="False"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <!--  Chromeless toggle so the dark box fills the whole combo width  -->
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border
                                            Background="#233055"
                                            BorderBrush="#33406A"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <DockPanel Margin="10,6">
                                                <Path
                                                    Width="10"
                                                    Height="6"
                                                    DockPanel.Dock="Right"
                                                    VerticalAlignment="Center"
                                                    Data="M 0 0 L 5 5 L 10 0"
                                                    Fill="{StaticResource BrushTextMuted}" />
                                                <ContentPresenter
                                                    Margin="2,0,8,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                            </DockPanel>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup
                                x:Name="Popup"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PopupAnimation="Slide">
                                <Border
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="#233055"
                                    BorderBrush="#33406A"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <ScrollViewer MaxHeight="240">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A3A67" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#334579" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgGradient}">
        <StackPanel Margin="14,12">
            <!--  Kopfzeile: Titel + Pin  -->
            <Grid>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource BrushText}"
                    Text="Quick Switch" />
                <ToggleButton
                    HorizontalAlignment="Right"
                    Content="📌 Vordergrund"
                    IsChecked="{Binding Topmost, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource PinToggle}"
                    ToolTip="Fenster immer im Vordergrund halten" />
            </Grid>

            <!--  Schnellwechsel  -->
            <TextBlock
                Margin="2,12,0,4"
                Foreground="{StaticResource BrushTextMuted}"
                Text="Projekt wechseln" />
            <ComboBox
                ItemsSource="{Binding ConfiguredProjects}"
                SelectedItem="{Binding ActiveProjectName, Mode=TwoWay}"
                Style="{StaticResource NiceCombo}" />

            <!--  Aktueller Status  -->
            <Border
                Margin="0,12,0,0"
                Padding="12,10"
                Background="{StaticResource BrushAccent}"
                CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse
                        Grid.Column="0"
                        Width="12"
                        Height="12"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource StatusDot}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrushText}"
                            Text="{Binding ActiveStatusText}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource BrushTextMuted}"
                            Text="{Binding ActiveSinceText}"
                            Visibility="{Binding IsAnyActive, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="15"
                        Foreground="{StaticResource BrushText}"
                        Text="{Binding ActiveElapsedText}" />
                </Grid>
            </Border>

            <!--  Stop  -->
            <Button
                Margin="0,12,0,0"
                Command="{Binding StopActiveCommand}"
                Content="Buchung stoppen"
                Style="{StaticResource FlatButton}" />
        </StackPanel>
    </Border>
</Window>
