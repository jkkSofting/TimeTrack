<Window
    x:Class="Zeitmanagement.Views.FloatingQuickSelectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Zeitmanagement.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:Zeitmanagement.ViewModel"
    Title="Quick Switch"
    Width="340"
    d:DataContext="{d:DesignInstance Type=viewModel:QuickSelectViewModel}"
    Background="{DynamicResource Theme.AppBackground}"
    FontFamily="Segoe UI"
    ResizeMode="CanMinimize"
    ShowInTaskbar="True"
    SizeToContent="Height"
    UseLayoutRounding="True"
    WindowStartupLocation="Manual"
    mc:Ignorable="d">
    <Window.Resources>
        <!--  Kleine, quadratische Icon-Buttons (Fortsetzen/Pause/Stop) innerhalb eines Slots  -->
        <Style
            x:Key="SlotIconButton"
            BasedOn="{StaticResource Button.Icon}"
            TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
        </Style>

        <!--  Nur sichtbar, während der Slot aktiv läuft (Pause-Button)  -->
        <Style
            x:Key="SlotRunningOnlyButton"
            BasedOn="{StaticResource SlotIconButton}"
            TargetType="Button">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Nur sichtbar, während der Slot pausiert ist (Fortsetzen-Button)  -->
        <Style
            x:Key="SlotPausedOnlyButton"
            BasedOn="{StaticResource SlotIconButton}"
            TargetType="Button">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Umrandung des Umschalters Projekte/Tickets (zwei RadioButtons im Segment-Stil)  -->
        <Style x:Key="SegmentBar" TargetType="Border">
            <Setter Property="Padding" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        </Style>

        <!--  Status-Punkt: grün während der Slot läuft, gelb während er pausiert ist  -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource Theme.Success}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource Theme.Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel Margin="14,12,14,14">
            <!--  Kopfzeile: Maskottchen + Titel + Pin  -->
            <Grid>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <ContentControl
                        Width="24"
                        Height="24"
                        Margin="0,0,8,0"
                        Focusable="False"
                        Template="{StaticResource MascotLogoTemplate}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Section}"
                        Text="Quick Switch" />
                </StackPanel>
                <ToggleButton
                    Padding="10,5"
                    HorizontalAlignment="Right"
                    local:Ui.Glyph="&#xE718;"
                    Content="Vordergrund"
                    IsChecked="{Binding Topmost, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource Toggle.Accent}"
                    ToolTip="Fenster immer im Vordergrund halten" />
            </Grid>

            <!--  Aktive Projekte, laufend oder pausiert (bis zu 4 parallele Slots)  -->
            <TextBlock
                Margin="2,14,0,6"
                Style="{StaticResource Text.Label}"
                Text="Aktive Buchungen" />

            <Border
                Padding="12"
                Style="{StaticResource Inset}"
                Visibility="{Binding NoActiveSlots, Converter={StaticResource BoolToVis}}">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource Text.Muted}"
                    Text="Keine Buchung aktiv" />
            </Border>

            <ItemsControl Focusable="False" ItemsSource="{Binding ActiveSlots}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,8"
                            Padding="12,10"
                            Effect="{x:Null}"
                            Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource StatusDot}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Theme.Text}"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Title}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource Theme.TextMuted}"
                                        Text="{Binding StatusText}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    Foreground="{DynamicResource Theme.Text}"
                                    Text="{Binding ElapsedText}" />

                                <StackPanel
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,6,0"
                                        local:Ui.Glyph="&#xE768;"
                                        Command="{Binding StartTimerCommand}"
                                        Style="{StaticResource SlotPausedOnlyButton}"
                                        ToolTip="Fortsetzen" />
                                    <Button
                                        Margin="0,0,6,0"
                                        local:Ui.Glyph="&#xE769;"
                                        Command="{Binding PauseTimerCommand}"
                                        Style="{StaticResource SlotRunningOnlyButton}"
                                        ToolTip="Pausieren" />
                                    <Button
                                        local:Ui.Glyph="&#xE71A;"
                                        Command="{Binding EndTimerCommand}"
                                        Style="{StaticResource SlotIconButton}"
                                        ToolTip="Stoppen" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Neue Buchung parallel starten (bis zu MaxActiveSlots), wahlweise für ein Projekt oder ein Ticket  -->
            <StackPanel Visibility="{Binding CanStartMoreSlots, Converter={StaticResource BoolToVis}}">
                <DockPanel Margin="2,8,0,6">
                    <Border DockPanel.Dock="Right" Style="{StaticResource SegmentBar}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton
                                Content="Projekte"
                                GroupName="QuickSwitchMode"
                                IsChecked="{Binding IsProjectMode, Mode=TwoWay}"
                                Style="{StaticResource Segment}"
                                ToolTip="Ein Projekt starten" />
                            <RadioButton
                                Content="Tickets"
                                GroupName="QuickSwitchMode"
                                IsChecked="{Binding IsTicketMode, Mode=TwoWay}"
                                Style="{StaticResource Segment}"
                                ToolTip="Ein To-Do-Ticket starten: Die Zeit wird auf das Projekt des Tickets gebucht, der Buchungstext ist der Titel des Tickets." />
                        </StackPanel>
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Label}"
                        Text="Starten" />
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        AutomationProperties.Name="Projekt starten"
                        ItemsSource="{Binding SelectableProjects}"
                        SelectedItem="{Binding PendingNewProject, Mode=TwoWay}"
                        Visibility="{Binding IsProjectMode, Converter={StaticResource BoolToVis}}" />

                    <ComboBox
                        AutomationProperties.Name="Ticket starten"
                        ItemsSource="{Binding Tickets}"
                        SelectedItem="{Binding PendingNewTicket, Mode=TwoWay}"
                        Visibility="{Binding IsTicketMode, Converter={StaticResource BoolToVis}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding Label}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        local:Ui.Glyph="&#xE768;"
                        Command="{Binding StartNewSlotCommand}"
                        Style="{StaticResource Button.Primary}"
                        ToolTip="Start" />
                </Grid>

                <TextBlock
                    Margin="2,8,0,0"
                    Style="{StaticResource Text.Muted}"
                    Text="Keine Tickets im Quick Switch. In „To-Do“ legst du je Spalte fest, welche Tickets hier erscheinen."
                    TextWrapping="Wrap"
                    Visibility="{Binding NoTicketsAvailable, Converter={StaticResource BoolToVis}}" />

                <TextBlock
                    Margin="2,8,0,0"
                    Style="{StaticResource Text.Muted}"
                    Text="{Binding StartBlockedText}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasStartBlockedText, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <TextBlock
                Margin="2,8,0,0"
                Style="{StaticResource Text.Label}"
                Text="Maximal 4 Buchungen gleichzeitig aktiv"
                Visibility="{Binding MaxSlotsReached, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!--  Roter Rahmen, solange in Teams der Bildschirm geteilt wird (Präsentation im Meeting)  -->
        <Border
            x:Name="PresentationFrame"
            BorderBrush="#E5484D"
            BorderThickness="1"
            IsHitTestVisible="False"
            Visibility="{Binding IsPresentingInTeams, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
    </Grid>
</Window>
