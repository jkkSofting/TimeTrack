<Window
    x:Class="Zeitmanagement.Views.FloatingQuickSelectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Zeitmanagement.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:Zeitmanagement.ViewModel"
    Title="Quick Switch"
    Width="330"
    d:DataContext="{d:DesignInstance Type=viewModel:QuickSelectViewModel}"
    ResizeMode="CanMinimize"
    ShowInTaskbar="True"
    SizeToContent="Height"
    WindowStartupLocation="Manual"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--  Farben (identisch zum Quick-Select-Theme)  -->
        <Color x:Key="ColText">#F5F7FB</Color>
        <Color x:Key="ColTextMuted">#B7C0D8</Color>

        <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColText}" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColTextMuted}" />
        <SolidColorBrush x:Key="BrushAccent" Color="#1F2A4D" />

        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#0B1020" />
            <GradientStop Offset="1" Color="#121A33" />
        </LinearGradientBrush>

        <!--  Flat-Button  -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Background" Value="#2D3A63" />
            <Setter Property="BorderBrush" Value="#42507C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#34406E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Pin-Toggle (immer im Vordergrund)  -->
        <Style x:Key="PinToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Background" Value="#2D3A63" />
            <Setter Property="BorderBrush" Value="#42507C" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#6C7BAF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A7BD5" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#5B9BE8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Kleiner "Stop"-Button innerhalb eines Slots  -->
        <Style x:Key="SlotStopButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>

    </Window.Resources>

    <Border Background="{StaticResource BgGradient}">
        <StackPanel Margin="14,12">
            <!--  Kopfzeile: Titel + Pin  -->
            <Grid>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource BrushText}"
                    Text="Quick Switch" />
                <ToggleButton
                    HorizontalAlignment="Right"
                    Content="📌 Vordergrund"
                    IsChecked="{Binding Topmost, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource PinToggle}"
                    ToolTip="Fenster immer im Vordergrund halten" />
            </Grid>

            <!--  Laufende Projekte (bis zu 4 parallele Slots)  -->
            <TextBlock
                Margin="2,12,0,4"
                Foreground="{StaticResource BrushTextMuted}"
                Text="Laufende Projekte" />

            <TextBlock
                Margin="2,4,0,4"
                FontStyle="Italic"
                Foreground="{StaticResource BrushTextMuted}"
                Text="Keine Buchung aktiv"
                Visibility="{Binding NoActiveSlots, Converter={StaticResource BoolToVis}}" />

            <ItemsControl ItemsSource="{Binding ActiveSlots}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,8"
                            Padding="12,10"
                            Background="{StaticResource BrushAccent}"
                            CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse
                                    Grid.Column="0"
                                    Width="12"
                                    Height="12"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Fill="#3DD68C" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource BrushText}"
                                        Text="{Binding SelectedProject}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource BrushTextMuted}"
                                        Text="{Binding Start, StringFormat=seit {0}}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    Foreground="{StaticResource BrushText}"
                                    Text="{Binding ElapsedText}" />

                                <Button
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Command="{Binding EndTimerCommand}"
                                    Content="Stop"
                                    Style="{StaticResource SlotStopButton}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Neues Projekt parallel starten (bis zu MaxActiveSlots)  -->
            <TextBlock
                Margin="2,8,0,4"
                Foreground="{StaticResource BrushTextMuted}"
                Text="Projekt starten"
                Visibility="{Binding CanStartMoreSlots, Converter={StaticResource BoolToVis}}" />
            <Grid Visibility="{Binding CanStartMoreSlots, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    Grid.Column="0"
                    ItemsSource="{Binding ConfiguredProjects}"
                    SelectedItem="{Binding PendingNewProject, Mode=TwoWay}"
                    Style="{StaticResource NiceCombo}" />

                <Button
                    Grid.Column="1"
                    Margin="6,4,4,4"
                    Command="{Binding StartNewSlotCommand}"
                    Content="Start"
                    Style="{StaticResource FlatButton}" />
            </Grid>

            <TextBlock
                Margin="2,8,0,0"
                FontStyle="Italic"
                Foreground="{StaticResource BrushTextMuted}"
                Text="Maximal 4 Projekte gleichzeitig aktiv"
                Visibility="{Binding MaxSlotsReached, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Border>
</Window>
