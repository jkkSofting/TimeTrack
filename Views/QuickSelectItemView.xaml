<UserControl
    x:Class="Zeitmanagement.Views.QuickSelectItemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Zeitmanagement.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:Zeitmanagement.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewModel:QuickSelectItemViewModel}"
    d:DesignHeight="70"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--
            Projekt-Auswahl einer Zeile: gesperrt, solange die Zeile läuft (oder pausiert ist),
            damit ein laufendes Projekt nicht durch Umstellen aus der Liste verschwindet.
        -->
        <Style
            x:Key="QuickSelectProjectCombo"
            BasedOn="{StaticResource NiceCombo}"
            TargetType="ComboBox">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="ToolTip" Value="Laufende Projekte können nicht geändert oder entfernt werden." />
                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Zeile: hervorgehoben, solange das Projekt läuft  -->
        <Style
            x:Key="Row"
            BasedOn="{StaticResource Inset}"
            TargetType="Border">
            <Setter Property="Padding" Value="14,10" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Status-Punkt: grün läuft, gelb pausiert, sonst unsichtbar  -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource Theme.ControlBorder}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource Theme.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource Theme.Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Laufzeit und Status nur bei aktiven Zeilen  -->
        <Style x:Key="ActiveOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Margin="0,0,0,8" Style="{StaticResource Row}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Ellipse
                Width="10"
                Height="10"
                Margin="0,0,14,0"
                VerticalAlignment="Center"
                Style="{StaticResource StatusDot}" />

            <ComboBox
                Grid.Column="1"
                ItemsSource="{Binding AvailableProjects}"
                SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                Style="{StaticResource QuickSelectProjectCombo}" />

            <!--  Zeiten und Laufzeit  -->
            <StackPanel
                Grid.Column="2"
                Margin="16,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <StackPanel Margin="0,0,18,0" Style="{StaticResource ActiveOnly}">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Laufzeit" />
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Theme.Text}"
                        Text="{Binding ElapsedText}" />
                </StackPanel>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Start" />
                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Start, TargetNullValue='–'}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Label}" Text="Ende" />
                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding End, TargetNullValue='–'}" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                Grid.Column="3"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    local:Ui.Glyph="&#xE768;"
                    Command="{Binding StartTimerCommand}"
                    Content="Start"
                    Style="{StaticResource Button.Primary}" />
                <Button
                    Margin="6,0,0,0"
                    local:Ui.Glyph="&#xE769;"
                    Command="{Binding PauseTimerCommand}"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Pausieren" />
                <Button
                    Margin="6,0,0,0"
                    local:Ui.Glyph="&#xE71A;"
                    Command="{Binding EndTimerCommand}"
                    Content="Stop" />
            </StackPanel>

            <Button
                Grid.Column="4"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                local:Ui.Glyph="&#xE711;"
                Command="{Binding RemoveCommand}"
                Style="{StaticResource Button.IconGhost}"
                ToolTip="Zeile entfernen" />
        </Grid>
    </Border>
</UserControl>
