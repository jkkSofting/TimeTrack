<Window
    x:Class="Zeitmanagement.Views.FishWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="160"
    Height="480"
    AllowsTransparency="True"
    Background="Transparent"
    Focusable="False"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">
    <Window.Resources>
        <SolidColorBrush x:Key="BrushFinDark" Color="#4F7FB0" />
    </Window.Resources>

    <!--
        Das Fenster sitzt auf der Oberkante der Taskleiste und ist hoch genug, dass der Fisch
        "gegen die Scheibe" klatschen und nach unten rutschen kann. Position, Größe der Spur
        und alle Animationen werden im Code gesetzt (Aufprallpunkt ist zufällig).
        Nur der Fisch selbst nimmt Klicks an (zum Fangen), die Spur lässt sie nicht auslösen.
    -->
    <Canvas ClipToBounds="True">

        <!--  Schleimspur: Wächst mit dem Fisch nach unten; liegt hinter dem Fisch  -->
        <Grid
            x:Name="Trail"
            Width="14"
            IsHitTestVisible="False"
            RenderTransformOrigin="0.5,0">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="TrailScale" ScaleY="0" />
            </Grid.RenderTransform>
            <Rectangle RadiusX="7" RadiusY="7">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#009BD7F0" />
                        <GradientStop Offset="0.5" Color="#889BD7F0" />
                        <GradientStop Offset="1" Color="#009BD7F0" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle
                Width="3"
                Margin="3,0,0,0"
                HorizontalAlignment="Left"
                Fill="White"
                Opacity="0.45"
                RadiusX="1.5"
                RadiusY="1.5" />
        </Grid>

        <!--  Fisch (Kopf nach rechts), 80 x 44  -->
        <Canvas
            x:Name="Fish"
            Width="80"
            Height="44"
            Cursor="Hand"
            MouseLeftButtonDown="Fish_MouseLeftButtonDown"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="FishScale" ScaleX="0.25" ScaleY="0.25" />
                    <RotateTransform x:Name="FishRotate" />
                    <TranslateTransform x:Name="FishMove" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!--  Schwanz- und Rückenflossen  -->
            <Polygon Fill="{StaticResource BrushFinDark}" Points="16,22 0,4 5,22 0,40" />
            <Polygon Fill="{StaticResource BrushFinDark}" Points="30,10 40,0 56,10" />
            <Polygon Fill="{StaticResource BrushFinDark}" Points="34,34 42,43 52,34" />

            <!--  Körper mit hellem Bauch  -->
            <Ellipse
                Canvas.Left="10"
                Canvas.Top="7"
                Width="66"
                Height="30"
                Stroke="{StaticResource BrushFinDark}"
                StrokeThickness="1.2">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#6F9CCB" />
                        <GradientStop Offset="0.55" Color="#B8D4EE" />
                        <GradientStop Offset="1" Color="#EEF5FB" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!--  Kieme, Auge  -->
            <Path
                Data="M 54,12 Q 48,22 54,32"
                Stroke="{StaticResource BrushFinDark}"
                StrokeThickness="1.5" />
            <Ellipse
                Canvas.Left="57"
                Canvas.Top="16"
                Width="7"
                Height="7"
                Fill="White" />
            <Ellipse
                Canvas.Left="60"
                Canvas.Top="18"
                Width="3.5"
                Height="3.5"
                Fill="Black" />
        </Canvas>

        <!--  Rückmeldung beim Fangen: steigt vom Fangpunkt auf und verblasst  -->
        <TextBlock
            x:Name="CaughtText"
            FontSize="15"
            FontWeight="Bold"
            Foreground="White"
            IsHitTestVisible="False"
            Opacity="0"
            Text="Gefangen!">
            <TextBlock.Effect>
                <DropShadowEffect
                    BlurRadius="6"
                    Opacity="0.8"
                    ShadowDepth="1"
                    Color="#1A2238" />
            </TextBlock.Effect>
            <TextBlock.RenderTransform>
                <TranslateTransform x:Name="CaughtTextMove" />
            </TextBlock.RenderTransform>
        </TextBlock>
    </Canvas>
</Window>
