<Window
    x:Class="Zeitmanagement.Views.FishWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="160"
    Height="480"
    AllowsTransparency="True"
    Background="Transparent"
    Focusable="False"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">
    <!--
        Das Fenster sitzt auf der Oberkante der Taskleiste und ist hoch genug, dass das Wurfobjekt
        "gegen die Scheibe" klatschen und nach unten rutschen kann. Das Wurfobjekt wechselt je nach
        Theme (Standard: Fisch) und wird als "Theme.ThrowItem" aus dem ThemeManager gezeichnet.
        Position, Größe der Spur und alle Animationen werden im Code gesetzt (Aufprallpunkt ist zufällig).
        Das Wurfobjekt ist fangbar, sobald es an der Scheibe klebt; es bleibt ca. 1 s hängen und
        rutscht dann ca. 3 s lang langsam nach unten. Ein unsichtbares Rechteck rund um das
        Wurfobjekt macht die Trefferfläche großzügig (auch ein Klick knapp daneben fängt es).
        Nur das Wurfobjekt (samt Trefferfläche) nimmt Klicks an, die Spur lässt sie nicht auslösen.
    -->
    <Canvas ClipToBounds="True">

        <!--  Schleimspur: Wächst mit dem Fisch nach unten; liegt hinter dem Fisch  -->
        <Grid
            x:Name="Trail"
            Width="14"
            IsHitTestVisible="False"
            RenderTransformOrigin="0.5,0">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="TrailScale" ScaleY="0" />
            </Grid.RenderTransform>
            <Rectangle RadiusX="7" RadiusY="7">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#009BD7F0" />
                        <GradientStop Offset="0.5" Color="#889BD7F0" />
                        <GradientStop Offset="1" Color="#009BD7F0" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle
                Width="3"
                Margin="3,0,0,0"
                HorizontalAlignment="Left"
                Fill="White"
                Opacity="0.45"
                RadiusX="1.5"
                RadiusY="1.5" />
        </Grid>

        <!--  Wurfobjekt (je nach Theme, Standard: Fisch), 80 x 44  -->
        <Canvas
            x:Name="Fish"
            Width="80"
            Height="44"
            Cursor="Hand"
            MouseLeftButtonDown="Fish_MouseLeftButtonDown"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="FishScale" ScaleX="0.25" ScaleY="0.25" />
                    <RotateTransform x:Name="FishRotate" />
                    <TranslateTransform x:Name="FishMove" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!--
                Unsichtbare, großzügige Trefferfläche (Canvas clippt Kinder nicht, negative Offsets sind ok).
                Nicht ganz transparent (Alpha 1): Das Fenster ist ein Layered Window, Pixel mit Alpha 0
                nimmt Windows nicht als Klickziel, sie würden den Klick durchlassen.
            -->
            <Rectangle
                Canvas.Left="-30"
                Canvas.Top="-30"
                Width="140"
                Height="104"
                Fill="#01000000" />

            <!--  Das Wurfobjekt selbst, je Theme aus den ThrowItem-Ressourcen (Views/ThrowItems.xaml)  -->
            <Image
                Width="80"
                Height="44"
                Source="{DynamicResource Theme.ThrowItem}"
                IsHitTestVisible="False" />
        </Canvas>

        <!--  Rückmeldung beim Fangen: steigt vom Fangpunkt auf und verblasst  -->
        <TextBlock
            x:Name="CaughtText"
            FontSize="15"
            FontWeight="Bold"
            Foreground="White"
            IsHitTestVisible="False"
            Opacity="0"
            Text="Gefangen!">
            <TextBlock.Effect>
                <DropShadowEffect
                    BlurRadius="6"
                    Opacity="0.8"
                    ShadowDepth="1"
                    Color="#1A2238" />
            </TextBlock.Effect>
            <TextBlock.RenderTransform>
                <TranslateTransform x:Name="CaughtTextMove" />
            </TextBlock.RenderTransform>
        </TextBlock>
    </Canvas>
</Window>
