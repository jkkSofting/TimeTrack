<UserControl
    x:Class="Zeitmanagement.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Zeitmanagement.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:Zeitmanagement.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:DashboardViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <TextBlock
                FontSize="150"
                Text="{Binding ProjectsCounter, FallbackValue='90'}"
                TextAlignment="Center" />
            <TextBlock FontSize="30" Text="Projekte" />
        </StackPanel>
        <StackPanel Grid.Column="1">
            <TextBlock
                FontSize="150"
                Text="{Binding BookingsCounter, FallbackValue='900'}"
                TextAlignment="Center" />
            <TextBlock FontSize="30" Text="Buchungen" />
        </StackPanel>
        <StackPanel Grid.Column="2">
            <TextBlock
                FontSize="150"
                Text="{Binding HoursCounter, FallbackValue='90'}"
                TextAlignment="Center" />
            <TextBlock FontSize="30" Text="Stunden gearbeitet" />
        </StackPanel>

    </Grid>
</UserControl>
