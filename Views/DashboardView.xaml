<UserControl
    x:Class="Zeitmanagement.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Zeitmanagement.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:Zeitmanagement.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:DashboardViewModel}"
    d:DesignHeight="720"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:NumberFormatterConverter x:Key="Fmt" />
        <local:DecimalHoursToHHmmConverter x:Key="HoursToHHmm" />

        <!--  Icon-Kachel links in den Kennzahl-Karten  -->
        <Style x:Key="IconBadge" TargetType="Border">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{DynamicResource Theme.AccentSoft}" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <!--  Kennzahl-Karte  -->
        <DataTemplate x:Key="StatCardTemplate">
            <Border Margin="0,0,16,0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource IconBadge}">
                        <Viewbox Stretch="Uniform">
                            <Path Data="{Binding IconGeometry}" Fill="{DynamicResource Theme.AccentSoftText}" />
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Caption}" />
                        <local:CountUpTextBlock
                            Margin="0,4,0,2"
                            DurationMilliseconds="900"
                            FontSize="38"
                            FontWeight="Bold"
                            Foreground="{DynamicResource Theme.Text}"
                            FormatString="{Binding FormatString}"
                            TargetValue="{Binding Value}" />
                        <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Subnote}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  Kleine Kennzahl in der zweiten Reihe  -->
        <Style x:Key="MetricValue" TargetType="local:CountUpTextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
            <Setter Property="DurationMilliseconds" Value="800" />
        </Style>

        <!--  Heatmap-Zelle: Farbe je Aktivitätsstufe aus dem Theme  -->
        <Style x:Key="HeatCell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Theme.Heat0}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="1">
                    <Setter Property="Background" Value="{DynamicResource Theme.Heat1}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="2">
                    <Setter Property="Background" Value="{DynamicResource Theme.Heat2}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="3">
                    <Setter Property="Background" Value="{DynamicResource Theme.Heat3}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="4">
                    <Setter Property="Background" Value="{DynamicResource Theme.Heat4}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WeekdayLabel" TargetType="TextBlock">
            <Setter Property="Height" Value="17" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
        </Style>

        <Style x:Key="LegendCell" TargetType="Border">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Kopf: Titel links, Spaß-Vergleich rechts  -->
        <DockPanel Style="{StaticResource PageHeader}">
            <Border
                Padding="16,10"
                DockPanel.Dock="Right"
                Style="{StaticResource Card}">
                <StackPanel Orientation="Horizontal">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Label}" Text="Zum Vergleich hast du so lange gearbeitet wie" />
                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Theme.Accent}"
                                Text="{Binding ComparisonFactorText}" />
                            <TextBlock
                                Width="280"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource Text.Body}"
                                Text="{Binding ComparisonCaption}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <Button
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding NextComparisonCommand}"
                        Style="{StaticResource Button.Icon}"
                        ToolTip="Neuer Vergleich">
                        <TextBlock FontSize="16" Text="🎲" />
                    </Button>
                </StackPanel>
            </Border>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="Dashboard" />
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="{Binding HeaderSubtitle}" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,0,28,24">

                <!--  Reihe 1: große Kennzahlen  -->
                <Grid Margin="0,0,-16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding StatProjects}" ContentTemplate="{StaticResource StatCardTemplate}" />
                    <ContentPresenter
                        Grid.Column="1"
                        Content="{Binding StatBookings}"
                        ContentTemplate="{StaticResource StatCardTemplate}" />
                    <ContentPresenter
                        Grid.Column="2"
                        Content="{Binding StatHours}"
                        ContentTemplate="{StaticResource StatCardTemplate}" />
                </Grid>

                <!--  Reihe 2: Zusatzinfos  -->
                <Border Margin="0,16,0,0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="Heute gebucht" />
                            <local:CountUpTextBlock
                                FormatString="0.## h"
                                Style="{StaticResource MetricValue}"
                                TargetValue="{Binding TodayHours}" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding TodayHours, Converter={StaticResource HoursToHHmm}}" />
                        </StackPanel>

                        <Border
                            Grid.Column="1"
                            Width="1"
                            Margin="24,0"
                            Background="{DynamicResource Theme.Divider}" />

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Ø Stunden/Tag (letzte 5 Werktage)" />
                            <local:CountUpTextBlock
                                FormatString="0.## h"
                                Style="{StaticResource MetricValue}"
                                TargetValue="{Binding AvgHoursLast5Days}" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding AvgHoursLast5Days, Converter={StaticResource HoursToHHmm}}" />
                        </StackPanel>

                        <Border
                            Grid.Column="3"
                            Width="1"
                            Margin="24,0"
                            Background="{DynamicResource Theme.Divider}" />

                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Top-Projekt (letzte 30 Tage)" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="24"
                                Style="{StaticResource Text.Value}"
                                Text="{Binding TopProjectName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding TopProjectHours, Converter={StaticResource HoursToHHmm}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Reihe 3: Aktivitäts-Heatmap (GitHub-Style); Klick auf einen Tag öffnet ihn  -->
                <Border Margin="0,16,0,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <!--  Legende  -->
                            <StackPanel
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Text.Label}"
                                    Text="Weniger" />
                                <Border Background="{DynamicResource Theme.Heat0}" Style="{StaticResource LegendCell}" />
                                <Border Background="{DynamicResource Theme.Heat1}" Style="{StaticResource LegendCell}" />
                                <Border Background="{DynamicResource Theme.Heat2}" Style="{StaticResource LegendCell}" />
                                <Border Background="{DynamicResource Theme.Heat3}" Style="{StaticResource LegendCell}" />
                                <Border Background="{DynamicResource Theme.Heat4}" Style="{StaticResource LegendCell}" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Text.Label}"
                                    Text="Mehr" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Section}" Text="Aktivität der letzten 12 Monate" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource Text.Label}"
                                    Text="Klick auf einen Tag öffnet ihn in der Stundenbuchung" />
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer
                            local:Ui.ForwardMouseWheel="True"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">

                                <!--  Wochentags-Labels (Wochenstart = Montag)  -->
                                <StackPanel Margin="0,0,6,0" VerticalAlignment="Top">
                                    <Border Height="16" />
                                    <TextBlock Style="{StaticResource WeekdayLabel}" Text="Mo" />
                                    <TextBlock Style="{StaticResource WeekdayLabel}" Text="" />
                                    <TextBlock Style="{StaticResource WeekdayLabel}" Text="Mi" />
                                    <TextBlock Style="{StaticResource WeekdayLabel}" Text="" />
                                    <TextBlock Style="{StaticResource WeekdayLabel}" Text="Fr" />
                                    <TextBlock Style="{StaticResource WeekdayLabel}" Text="" />
                                    <TextBlock Style="{StaticResource WeekdayLabel}" Text="" />
                                </StackPanel>

                                <!--  Wochen-Spalten  -->
                                <ItemsControl ItemsSource="{Binding HeatColumns}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Top">
                                                <!--  Monatslabel: Canvas, damit langer Text überläuft ohne die Rasterbreite zu ändern  -->
                                                <Canvas Width="17" Height="16">
                                                    <TextBlock
                                                        Canvas.Left="0"
                                                        Canvas.Top="2"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource Theme.TextMuted}"
                                                        Text="{Binding MonthLabel}" />
                                                </Canvas>
                                                <ItemsControl ItemsSource="{Binding Days}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button
                                                                Width="13"
                                                                Height="13"
                                                                Margin="2"
                                                                Command="{Binding DataContext.OpenDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Focusable="False"
                                                                ToolTip="{Binding Tooltip}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border
                                                                            x:Name="cell"
                                                                            BorderBrush="Transparent"
                                                                            BorderThickness="1"
                                                                            CornerRadius="3"
                                                                            Style="{StaticResource HeatCell}" />
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="cell" Property="BorderBrush" Value="{DynamicResource Theme.Text}" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                                <Button.Style>
                                                                    <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                                                        <Style.Triggers>
                                                                            <!--  Zukünftige Tage: unsichtbar, halten aber das Raster  -->
                                                                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                                                <Setter Property="Visibility" Value="Hidden" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <TextBlock
                    Margin="2,14,0,0"
                    Style="{StaticResource Text.Label}"
                    Text="{Binding NowStamp, StringFormat='Stand: {0}'}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
