<UserControl
    x:Class="Zeitmanagement.Views.FragmentationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Zeitmanagement.Views"
    xmlns:viewmodel="clr-namespace:Zeitmanagement.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:FragmentationViewModel}"
    d:DesignHeight="720"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Color x:Key="ColBgDark">#0B1020</Color>
        <Color x:Key="ColCard">#1A2238</Color>
        <Color x:Key="ColText">#F5F7FB</Color>
        <Color x:Key="ColTextMuted">#B7C0D8</Color>

        <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColText}" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColTextMuted}" />
        <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColCard}" />

        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#0B1020" />
            <GradientStop Offset="1" Color="#121A33" />
        </LinearGradientBrush>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{StaticResource BrushCard}" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" Opacity="0.4" ShadowDepth="3" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Empty bar placeholder -->
        <SolidColorBrush x:Key="BrushEmpty" Color="#2A3050" />
        <local:NullToVisibilityConverter x:Key="NullToCollapsed" />
    </UserControl.Resources>

    <Grid Background="{StaticResource BgGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Style="{StaticResource Card}" Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Fragmentierung" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource BrushText}" />
                <TextBlock Text="Wie zersplittert war dein Tag?" FontSize="13"
                           Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,12" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Mode selector -->
                    <ComboBox ItemsSource="{Binding ViewModes}" SelectedItem="{Binding SelectedMode}"
                              Width="100" Margin="0,0,16,0" FontSize="14" />

                    <!-- Navigation -->
                    <Button Content="◀" Command="{Binding PreviousCommand}"
                            Width="36" Height="36" FontSize="16" Margin="0,0,8,0"
                            Background="#2A3050" Foreground="White" BorderThickness="0" />
                    <TextBlock Text="{Binding RangeLabel}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushText}" VerticalAlignment="Center"
                               MinWidth="180" TextAlignment="Center" />
                    <Button Content="▶" Command="{Binding NextCommand}"
                            Width="36" Height="36" FontSize="16" Margin="8,0,0,0"
                            Background="#2A3050" Foreground="White" BorderThickness="0" />

                    <!-- Date picker -->
                    <DatePicker SelectedDate="{Binding ReferenceDate}" Margin="24,0,0,0"
                                Width="140" FontSize="13" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ BARS ═══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8,0">
            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>

                                <!-- Date label -->
                                <TextBlock Text="{Binding DateLabel}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushText}" VerticalAlignment="Center" />

                                <!-- Segmented bar: Canvas = 1440 units wide (full day), Viewbox stretches it -->
                                <Viewbox Grid.Column="1" Stretch="Fill" StretchDirection="Both" Height="32">
                                    <Canvas Width="1000" Height="32" Background="{StaticResource BrushEmpty}">
                                        <ItemsControl ItemsSource="{Binding Segments}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="1000" Height="32" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding StartMinute}" />
                                                    <Setter Property="Canvas.Top" Value="0" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="{Binding Minutes}" Height="32"
                                                            ToolTip="{Binding ProjectName}"
                                                            Command="{Binding DataContext.SelectSegmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{Binding Brush}" Cursor="Hand">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Opacity" Value="0.8" />
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Canvas>
                                </Viewbox>

                                <!-- Stats -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Foreground="{StaticResource BrushText}" FontSize="12">
                                        <Run Text="{Binding TotalHours, StringFormat='{}{0:F1}h'}" />
                                    </TextBlock>
                                    <TextBlock Foreground="{StaticResource BrushTextMuted}" FontSize="11">
                                        <Run Text="{Binding SwitchCount, StringFormat='{}{0} Wechsel'}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ═══ DETAIL PANEL ═══ -->
        <Border Grid.Row="2" Style="{StaticResource Card}"
                Visibility="{Binding SelectedSegment, Converter={StaticResource NullToCollapsed}}"
                DataContext="{Binding}">
            <StackPanel DataContext="{Binding SelectedSegment}">
                <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushText}">
                    <Run Text="{Binding ProjectName, Mode=OneWay}" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock FontSize="14" Foreground="{StaticResource BrushTextMuted}" Text="Zeit: " />
                    <TextBlock FontSize="14" Foreground="{StaticResource BrushText}">
                        <Run Text="{Binding StartTime, Mode=OneWay}" /> – <Run Text="{Binding EndTime, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="14" Foreground="{StaticResource BrushTextMuted}" Margin="24,0,0,0" Text="Dauer: " />
                    <TextBlock FontSize="14" Foreground="{StaticResource BrushText}" Text="{Binding DurationHours, StringFormat='{}{0:F2}h', Mode=OneWay}" />
                </StackPanel>
                <TextBlock FontSize="13" Foreground="{StaticResource BrushTextMuted}" Margin="0,8,0,0"
                           Text="{Binding Description, Mode=OneWay, TargetNullValue='(keine Beschreibung)'}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- ═══ LEGEND ═══ -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <ItemsControl ItemsSource="{Binding Legend}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                            <Border Width="14" Height="14" CornerRadius="3"
                                    Background="{Binding Brush}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding ProjectName}" FontSize="13"
                                       Foreground="{StaticResource BrushText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>
