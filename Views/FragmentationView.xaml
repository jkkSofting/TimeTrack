<UserControl
    x:Class="Zeitmanagement.Views.FragmentationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Zeitmanagement.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:Zeitmanagement.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:FragmentationViewModel}"
    d:DesignHeight="720"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:NullToVisibilityConverter x:Key="NullToCollapsed" />
    </UserControl.Resources>

    <Grid Style="{StaticResource Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Kopf: Titel links, Zeitraum-Auswahl rechts  -->
        <DockPanel Style="{StaticResource PageHeader}">
            <StackPanel
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <ComboBox
                    Width="110"
                    Margin="0,0,16,0"
                    ItemsSource="{Binding ViewModes}"
                    SelectedItem="{Binding SelectedMode}" />
                <Button
                    local:Ui.Glyph="&#xE76B;"
                    Command="{Binding PreviousCommand}"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Zurück" />
                <TextBlock
                    MinWidth="170"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Theme.Text}"
                    Text="{Binding RangeLabel}"
                    TextAlignment="Center" />
                <Button
                    local:Ui.Glyph="&#xE76C;"
                    Command="{Binding NextCommand}"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Weiter" />
                <DatePicker
                    Width="140"
                    Margin="16,0,0,0"
                    SelectedDate="{Binding ReferenceDate}" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="Fragmentierung" />
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="Wie zersplittert war dein Tag? Klick auf einen Abschnitt zeigt Details." />
            </StackPanel>
        </DockPanel>

        <!--  Legende  -->
        <ItemsControl
            Grid.Row="1"
            Margin="30,0,28,10"
            ItemsSource="{Binding Legend}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,18,4" Orientation="Horizontal">
                        <Border
                            Width="12"
                            Height="12"
                            Margin="0,0,6,0"
                            Background="{Binding Brush}"
                            CornerRadius="3" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource Text.Muted}"
                            Text="{Binding ProjectName}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  Tage  -->
        <Border
            Grid.Row="2"
            Margin="28,0,28,24"
            Padding="8,12"
            Style="{StaticResource Card}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Days}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="12,0"
                                Padding="0,10"
                                BorderBrush="{DynamicResource Theme.Divider}"
                                BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource Text.Body}"
                                        Text="{Binding DateLabel}" />

                                    <!--  Segmentierte Leiste: Canvas = 1000 Einheiten breit, die Viewbox streckt sie  -->
                                    <Border
                                        Grid.Column="1"
                                        Height="28"
                                        Background="{DynamicResource Theme.Track}"
                                        CornerRadius="6">
                                        <Viewbox Stretch="Fill" StretchDirection="Both">
                                            <Canvas Width="1000" Height="32">
                                                <ItemsControl ItemsSource="{Binding Segments}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas Width="1000" Height="32" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left" Value="{Binding StartMinute}" />
                                                            <Setter Property="Canvas.Top" Value="0" />
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button
                                                                Width="{Binding Minutes}"
                                                                Height="32"
                                                                Command="{Binding DataContext.SelectSegmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Focusable="False"
                                                                ToolTip="{Binding ProjectName}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="seg" Background="{Binding Brush}" />
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="seg" Property="Opacity" Value="0.75" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>

                                    <StackPanel
                                        Grid.Column="2"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Style="{StaticResource Text.Body}"
                                            Text="{Binding TotalHours, StringFormat='{}{0:F1} h'}" />
                                        <TextBlock Style="{StaticResource Text.Label}" Text="{Binding SwitchCount, StringFormat='{}{0} Wechsel'}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!--  Details zum angeklickten Abschnitt  -->
        <Border
            Grid.Row="3"
            Margin="28,-8,28,24"
            Style="{StaticResource Card}"
            Visibility="{Binding SelectedSegment, Converter={StaticResource NullToCollapsed}}">
            <StackPanel DataContext="{Binding SelectedSegment}">
                <TextBlock Style="{StaticResource Text.Section}" Text="{Binding ProjectName, Mode=OneWay}" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Muted}" Text="Zeit: " />
                    <TextBlock Style="{StaticResource Text.Body}">
                        <Run Text="{Binding StartTime, Mode=OneWay}" /><Run Text=" – " /><Run Text="{Binding EndTime, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock
                        Margin="24,0,0,0"
                        Style="{StaticResource Text.Muted}"
                        Text="Dauer: " />
                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding DurationHours, StringFormat='{}{0:F2} h', Mode=OneWay}" />
                </StackPanel>
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource Text.Muted}"
                    Text="{Binding Description, Mode=OneWay, TargetNullValue='(keine Beschreibung)'}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
