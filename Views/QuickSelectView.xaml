<UserControl
    x:Class="Zeitmanagement.Views.QuickSelectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Zeitmanagement.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:Zeitmanagement.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewModel:QuickSelectViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Style="{StaticResource Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Kopf  -->
        <DockPanel Style="{StaticResource PageHeader}">
            <Button
                VerticalAlignment="Center"
                local:Ui.Glyph="&#xE8A7;"
                Click="OpenFloatingWindow_Click"
                Content="Quick Switch öffnen"
                DockPanel.Dock="Right"
                ToolTip="Kleines, immer sichtbares Fenster zum schnellen Wechseln öffnen" />

            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="Quick Select" />
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="Deine Projekte für den Schnellzugriff: Projekt wählen, starten, pausieren, stoppen. Bis zu 4 laufen parallel." />
            </StackPanel>
        </DockPanel>

        <Border
            Grid.Row="1"
            Margin="28,0,28,24"
            Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock
                    Margin="0,0,0,12"
                    DockPanel.Dock="Top"
                    Style="{StaticResource Text.Label}"
                    Text="Eine neue Zeile erscheint automatisch, sobald in der letzten ein Projekt gewählt ist." />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl Focusable="False" ItemsSource="{Binding QuickSelectItems}" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
