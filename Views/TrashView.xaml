<UserControl
    x:Class="Zeitmanagement.Views.TrashView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Zeitmanagement.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:Zeitmanagement.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:TrashViewModel}"
    d:DesignHeight="720"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Gemeinsame Umrandung für Umschalter aus mehreren Segmenten (wie in der Export-Seite)  -->
        <Style x:Key="SegmentBar" TargetType="Border">
            <Setter Property="Padding" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        </Style>

        <Style x:Key="RightText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <Style x:Key="EntryProjectText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding ProjektHinweis}" />
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Kopf: Titel links, Aktion rechts  -->
        <DockPanel Style="{StaticResource PageHeader}">
            <Button
                VerticalAlignment="Center"
                local:Ui.Glyph="&#xE74D;"
                Command="{Binding EmptyTrashCommand}"
                Content="Papierkorb leeren"
                DockPanel.Dock="Right"
                Style="{StaticResource Button.Danger}"
                ToolTip="Alle Einträge im Papierkorb endgültig löschen" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="Papierkorb" />
                <TextBlock
                    Style="{StaticResource Text.Subtitle}"
                    Text="Gelöschte Projekte und Buchungen wiederherstellen oder endgültig entfernen" />
            </StackPanel>
        </DockPanel>

        <!--  Hinweis (Erfolg, Umbenennung, Fehler)  -->
        <Border
            Grid.Row="1"
            Margin="28,12,28,0"
            Padding="12,8"
            Style="{StaticResource Inset}"
            Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button
                    local:Ui.Glyph="&#xE711;"
                    Command="{Binding DismissNoticeCommand}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource Button.IconGhost}"
                    ToolTip="Hinweis schließen" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource Text.Body}"
                    Text="{Binding Notice}"
                    TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!--  Umschalter Projekte / Buchungen  -->
        <Border
            Grid.Row="2"
            Margin="28,16,28,0"
            Style="{StaticResource SegmentBar}">
            <StackPanel Orientation="Horizontal">
                <RadioButton
                    Content="{Binding ProjectsTabText}"
                    GroupName="TrashTab"
                    IsChecked="{Binding ShowProjects, Mode=TwoWay}"
                    Style="{StaticResource Segment}" />
                <RadioButton
                    Content="{Binding EntriesTabText}"
                    GroupName="TrashTab"
                    IsChecked="{Binding ShowEntries, Mode=TwoWay}"
                    Style="{StaticResource Segment}" />
            </StackPanel>
        </Border>

        <Border
            Grid.Row="3"
            Margin="28,12,28,24"
            Style="{StaticResource Card}">
            <Grid>
                <!--  Projekte  -->
                <Grid Visibility="{Binding ShowProjects, Converter={StaticResource BoolToVis}}">
                    <DataGrid
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding Projects}"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn
                                Width="2*"
                                Header="Projekt"
                                SortMemberPath="Projektname">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Style="{StaticResource Text.Body}"
                                            Text="{Binding Projektname}"
                                            TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="2*"
                                Binding="{Binding Kunde}"
                                Header="Kunde" />
                            <DataGridTextColumn
                                Width="2*"
                                Binding="{Binding Kostentraeger}"
                                Header="Kostenträger" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding AnzahlBuchungen}"
                                ElementStyle="{StaticResource RightText}"
                                Header="Buchungen" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding GeloeschtAmText}"
                                Header="Gelöscht am" />
                            <DataGridTemplateColumn
                                Width="Auto"
                                Header="Aktionen">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button
                                                Command="{Binding DataContext.RestoreProjectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="Wiederherstellen"
                                                Style="{StaticResource Button.Secondary}" />
                                            <Button
                                                Margin="4,0,0,0"
                                                local:Ui.Glyph="&#xE74D;"
                                                Command="{Binding DataContext.PurgeProjectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Foreground="{DynamicResource Theme.Danger}"
                                                Style="{StaticResource Button.IconGhost}"
                                                ToolTip="Endgültig löschen" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Muted}"
                        Text="Keine gelöschten Projekte."
                        Visibility="{Binding IsProjectsEmpty, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!--  Buchungen  -->
                <Grid Visibility="{Binding ShowEntries, Converter={StaticResource BoolToVis}}">
                    <DataGrid
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding Entries}"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding DatumText}"
                                Header="Datum" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding ZeitText}"
                                Header="Zeit" />
                            <DataGridTextColumn
                                Width="2*"
                                Binding="{Binding Projektname}"
                                ElementStyle="{StaticResource EntryProjectText}"
                                Header="Projekt" />
                            <DataGridTextColumn
                                Width="2*"
                                Binding="{Binding Beschreibung}"
                                Header="Beschreibung" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding GeloeschtAmText}"
                                Header="Gelöscht am" />
                            <DataGridTemplateColumn
                                Width="Auto"
                                Header="Aktionen">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button
                                                Command="{Binding DataContext.RestoreEntryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="Wiederherstellen"
                                                Style="{StaticResource Button.Secondary}" />
                                            <Button
                                                Margin="4,0,0,0"
                                                local:Ui.Glyph="&#xE74D;"
                                                Command="{Binding DataContext.PurgeEntryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Foreground="{DynamicResource Theme.Danger}"
                                                Style="{StaticResource Button.IconGhost}"
                                                ToolTip="Endgültig löschen" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Muted}"
                        Text="Keine gelöschten Buchungen."
                        Visibility="{Binding IsEntriesEmpty, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
