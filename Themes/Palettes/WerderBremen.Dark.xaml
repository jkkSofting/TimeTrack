<!--  Farbschema "WerderBremen.Dark" (Werder Bremen, dunkel: Grün-Weiß unter Flutlicht). Alle Paletten haben dieselben Schlüssel;
      der ThemeManager tauscht zur Laufzeit die komplette Palette aus.  -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Boolean x:Key="Theme.IsDark">True</sys:Boolean>
    <sys:String x:Key="Theme.Greeting">⚽  Werder Bremen</sys:String>

    <Color x:Key="Theme.TitleBarColor">#0D1611</Color>
    <Color x:Key="Theme.TitleBarTextColor">#EDF7F1</Color>

    <LinearGradientBrush x:Key="Theme.AppBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#0D1611" />
        <GradientStop Offset="1" Color="#111D16" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Theme.Sidebar" Color="#0B1A12" />
    <SolidColorBrush x:Key="Theme.SidebarBorder" Color="#15291D" />
    <SolidColorBrush x:Key="Theme.SidebarText" Color="#CFEBDA" />
    <SolidColorBrush x:Key="Theme.SidebarTextMuted" Color="#789C86" />
    <SolidColorBrush x:Key="Theme.SidebarHover" Color="#11241A" />
    <SolidColorBrush x:Key="Theme.SidebarSelected" Color="#17402A" />
    <SolidColorBrush x:Key="Theme.SidebarSelectedText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Theme.Card" Color="#14221A" />
    <SolidColorBrush x:Key="Theme.CardBorder" Color="#213528" />
    <SolidColorBrush x:Key="Theme.Surface" Color="#192B20" />
    <SolidColorBrush x:Key="Theme.SurfaceHover" Color="#22382A" />
    <SolidColorBrush x:Key="Theme.Control" Color="#17271D" />
    <SolidColorBrush x:Key="Theme.ControlBorder" Color="#2B4535" />
    <SolidColorBrush x:Key="Theme.ControlHover" Color="#1E3125" />
    <SolidColorBrush x:Key="Theme.Text" Color="#EDF7F1" />
    <SolidColorBrush x:Key="Theme.TextMuted" Color="#9DBBA9" />
    <SolidColorBrush x:Key="Theme.TextSubtle" Color="#66816F" />
    <SolidColorBrush x:Key="Theme.Accent" Color="#22B062" />
    <SolidColorBrush x:Key="Theme.AccentHover" Color="#3CC478" />
    <SolidColorBrush x:Key="Theme.AccentPressed" Color="#1A9452" />
    <SolidColorBrush x:Key="Theme.OnAccent" Color="#04140B" />
    <SolidColorBrush x:Key="Theme.AccentSoft" Color="#173A27" />
    <SolidColorBrush x:Key="Theme.AccentSoftText" Color="#8EE2B3" />
    <SolidColorBrush x:Key="Theme.Divider" Color="#213528" />
    <SolidColorBrush x:Key="Theme.Track" Color="#1D3024" />
    <SolidColorBrush x:Key="Theme.Hover" Color="#1A2D21" />
    <SolidColorBrush x:Key="Theme.Selection" Color="#1F4430" />
    <SolidColorBrush x:Key="Theme.Popup" Color="#17271D" />
    <SolidColorBrush x:Key="Theme.ScrollThumb" Color="#2B4535" />
    <SolidColorBrush x:Key="Theme.ScrollThumbHover" Color="#43654F" />
    <SolidColorBrush x:Key="Theme.Success" Color="#3DD68C" />
    <SolidColorBrush x:Key="Theme.SuccessSoft" Color="#14352A" />
    <SolidColorBrush x:Key="Theme.Warning" Color="#FFB454" />
    <SolidColorBrush x:Key="Theme.WarningSoft" Color="#3A2A16" />
    <SolidColorBrush x:Key="Theme.Danger" Color="#FF6B81" />
    <SolidColorBrush x:Key="Theme.DangerSoft" Color="#3A1620" />

    <SolidColorBrush x:Key="Theme.Heat0" Color="#192B20" />
    <SolidColorBrush x:Key="Theme.Heat1" Color="#18452D" />
    <SolidColorBrush x:Key="Theme.Heat2" Color="#1B6B40" />
    <SolidColorBrush x:Key="Theme.Heat3" Color="#22A05C" />
    <SolidColorBrush x:Key="Theme.Heat4" Color="#5FE09A" />

    <DropShadowEffect x:Key="Theme.CardShadow" BlurRadius="18" Direction="270" Opacity="0.3" ShadowDepth="2" Color="#000000" />
    <DropShadowEffect x:Key="Theme.PopupShadow" BlurRadius="20" Direction="270" Opacity="0.48" ShadowDepth="4" Color="#000000" />
</ResourceDictionary>
