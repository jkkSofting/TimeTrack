<!--  Farbschema "GtaVi.Dark" (GTA VI / Leonida, dunkel: Twilight &amp; Neon Night, tiefes Violett, Flamingo-Pink und Sunset-Gold). Alle Paletten haben dieselben Schlüssel;
      der ThemeManager tauscht zur Laufzeit die komplette Palette aus.  -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Boolean x:Key="Theme.IsDark">True</sys:Boolean>
    <sys:String x:Key="Theme.Greeting">🌴  Welcome to Leonida</sys:String>

    <Color x:Key="Theme.TitleBarColor">#13101C</Color>
    <Color x:Key="Theme.TitleBarTextColor">#F5F0EB</Color>

    <LinearGradientBrush x:Key="Theme.AppBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#13101C" />
        <GradientStop Offset="1" Color="#1B1228" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Theme.Sidebar" Color="#22143A" />
    <SolidColorBrush x:Key="Theme.SidebarBorder" Color="#22143A" />
    <SolidColorBrush x:Key="Theme.SidebarText" Color="#F5F0EB" />
    <SolidColorBrush x:Key="Theme.SidebarTextMuted" Color="#B9A8D6" />
    <SolidColorBrush x:Key="Theme.SidebarHover" Color="#2F1D4D" />
    <SolidColorBrush x:Key="Theme.SidebarSelected" Color="#4A2456" />
    <SolidColorBrush x:Key="Theme.SidebarSelectedText" Color="#FFC56B" />
    <SolidColorBrush x:Key="Theme.Card" Color="#1E192B" />
    <SolidColorBrush x:Key="Theme.CardBorder" Color="#3D3456" />
    <SolidColorBrush x:Key="Theme.Surface" Color="#251F35" />
    <SolidColorBrush x:Key="Theme.SurfaceHover" Color="#2B243D" />
    <SolidColorBrush x:Key="Theme.Control" Color="#2B243D" />
    <SolidColorBrush x:Key="Theme.ControlBorder" Color="#4A4068" />
    <SolidColorBrush x:Key="Theme.ControlHover" Color="#352D4C" />
    <SolidColorBrush x:Key="Theme.Text" Color="#F5F0EB" />
    <SolidColorBrush x:Key="Theme.TextMuted" Color="#A99FC2" />
    <SolidColorBrush x:Key="Theme.TextSubtle" Color="#7E7399" />
    <SolidColorBrush x:Key="Theme.Accent" Color="#E84E8A" />
    <SolidColorBrush x:Key="Theme.AccentHover" Color="#F0679C" />
    <SolidColorBrush x:Key="Theme.AccentPressed" Color="#DD4580" />
    <SolidColorBrush x:Key="Theme.OnAccent" Color="#1D1729" />
    <SolidColorBrush x:Key="Theme.AccentSoft" Color="#46243E" />
    <SolidColorBrush x:Key="Theme.AccentSoftText" Color="#FF9CC2" />
    <SolidColorBrush x:Key="Theme.Divider" Color="#3D3456" />
    <SolidColorBrush x:Key="Theme.Track" Color="#2B243D" />
    <SolidColorBrush x:Key="Theme.Hover" Color="#2B243D" />
    <SolidColorBrush x:Key="Theme.Selection" Color="#4A2540" />
    <SolidColorBrush x:Key="Theme.Popup" Color="#2B243D" />
    <SolidColorBrush x:Key="Theme.ScrollThumb" Color="#3D3456" />
    <SolidColorBrush x:Key="Theme.ScrollThumbHover" Color="#5C5082" />
    <SolidColorBrush x:Key="Theme.Success" Color="#38A389" />
    <SolidColorBrush x:Key="Theme.SuccessSoft" Color="#212A36" />
    <SolidColorBrush x:Key="Theme.Warning" Color="#E59838" />
    <SolidColorBrush x:Key="Theme.WarningSoft" Color="#36282D" />
    <SolidColorBrush x:Key="Theme.Danger" Color="#EA4B5C" />
    <SolidColorBrush x:Key="Theme.DangerSoft" Color="#361F31" />

    <SolidColorBrush x:Key="Theme.Heat0" Color="#251F35" />
    <SolidColorBrush x:Key="Theme.Heat1" Color="#5C2B45" />
    <SolidColorBrush x:Key="Theme.Heat2" Color="#A33C5A" />
    <SolidColorBrush x:Key="Theme.Heat3" Color="#E8604F" />
    <SolidColorBrush x:Key="Theme.Heat4" Color="#F7A63B" />

    <!--  Kategoriefarben für Projekte und Balken, in fester Reihenfolge vergeben. Geprüft: mindestens 3:1 Kontrast zur Karte,
          Nachbarn auch bei Rot-Grün-Schwäche unterscheidbar (CIELAB-Abstand). DataNeutral: violettstichiges Schiefergrau für "zählt nicht".  -->
    <SolidColorBrush x:Key="Theme.Data0" Color="#F0609A" />
    <SolidColorBrush x:Key="Theme.Data1" Color="#F7B84A" />
    <SolidColorBrush x:Key="Theme.Data2" Color="#4FD0D6" />
    <SolidColorBrush x:Key="Theme.Data3" Color="#3FA0E8" />
    <SolidColorBrush x:Key="Theme.Data4" Color="#E04F6F" />
    <SolidColorBrush x:Key="Theme.Data5" Color="#5B7FE8" />
    <SolidColorBrush x:Key="Theme.Data6" Color="#E8553F" />
    <SolidColorBrush x:Key="Theme.Data7" Color="#2FA6A0" />
    <SolidColorBrush x:Key="Theme.DataNeutral" Color="#8479A0" />

    <DropShadowEffect x:Key="Theme.CardShadow" BlurRadius="18" Direction="270" Opacity="0.4" ShadowDepth="2" Color="#0B0812" />
    <DropShadowEffect x:Key="Theme.PopupShadow" BlurRadius="20" Direction="270" Opacity="0.55" ShadowDepth="4" Color="#0B0812" />
</ResourceDictionary>
