<!--  Farbschema "Halloween.Dark" (Halloween, dunkel: Kürbis, Kerzenschein und Mitternacht). Alle Paletten haben dieselben Schlüssel;
      der ThemeManager tauscht zur Laufzeit die komplette Palette aus.  -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Boolean x:Key="Theme.IsDark">True</sys:Boolean>
    <sys:String x:Key="Theme.Greeting">🎃  Happy Halloween</sys:String>

    <Color x:Key="Theme.TitleBarColor">#120C16</Color>
    <Color x:Key="Theme.TitleBarTextColor">#F6EEE6</Color>

    <LinearGradientBrush x:Key="Theme.AppBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#120C16" />
        <GradientStop Offset="1" Color="#1A1220" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Theme.Sidebar" Color="#0D0911" />
    <SolidColorBrush x:Key="Theme.SidebarBorder" Color="#1E1525" />
    <SolidColorBrush x:Key="Theme.SidebarText" Color="#E4D6EA" />
    <SolidColorBrush x:Key="Theme.SidebarTextMuted" Color="#8D7A96" />
    <SolidColorBrush x:Key="Theme.SidebarHover" Color="#1A1320" />
    <SolidColorBrush x:Key="Theme.SidebarSelected" Color="#2A1D33" />
    <SolidColorBrush x:Key="Theme.SidebarSelectedText" Color="#FFB777" />
    <SolidColorBrush x:Key="Theme.Card" Color="#1E1624" />
    <SolidColorBrush x:Key="Theme.CardBorder" Color="#33233D" />
    <SolidColorBrush x:Key="Theme.Surface" Color="#251B2D" />
    <SolidColorBrush x:Key="Theme.SurfaceHover" Color="#31233B" />
    <SolidColorBrush x:Key="Theme.Control" Color="#221929" />
    <SolidColorBrush x:Key="Theme.ControlBorder" Color="#432F4F" />
    <SolidColorBrush x:Key="Theme.ControlHover" Color="#2B2034" />
    <SolidColorBrush x:Key="Theme.Text" Color="#F6EEE6" />
    <SolidColorBrush x:Key="Theme.TextMuted" Color="#BBA8C2" />
    <SolidColorBrush x:Key="Theme.TextSubtle" Color="#7D6B86" />
    <SolidColorBrush x:Key="Theme.Accent" Color="#FF8A1F" />
    <SolidColorBrush x:Key="Theme.AccentHover" Color="#FFA04A" />
    <SolidColorBrush x:Key="Theme.AccentPressed" Color="#E07410" />
    <SolidColorBrush x:Key="Theme.OnAccent" Color="#1A0F05" />
    <SolidColorBrush x:Key="Theme.AccentSoft" Color="#3D2414" />
    <SolidColorBrush x:Key="Theme.AccentSoftText" Color="#FFB777" />
    <SolidColorBrush x:Key="Theme.Divider" Color="#33233D" />
    <SolidColorBrush x:Key="Theme.Track" Color="#2C2034" />
    <SolidColorBrush x:Key="Theme.Hover" Color="#281E30" />
    <SolidColorBrush x:Key="Theme.Selection" Color="#3A2945" />
    <SolidColorBrush x:Key="Theme.Popup" Color="#221929" />
    <SolidColorBrush x:Key="Theme.ScrollThumb" Color="#432F4F" />
    <SolidColorBrush x:Key="Theme.ScrollThumbHover" Color="#5E4470" />
    <SolidColorBrush x:Key="Theme.Success" Color="#3DD68C" />
    <SolidColorBrush x:Key="Theme.SuccessSoft" Color="#14352A" />
    <SolidColorBrush x:Key="Theme.Warning" Color="#FFB454" />
    <SolidColorBrush x:Key="Theme.WarningSoft" Color="#3A2A16" />
    <SolidColorBrush x:Key="Theme.Danger" Color="#FF6B81" />
    <SolidColorBrush x:Key="Theme.DangerSoft" Color="#3A1620" />

    <SolidColorBrush x:Key="Theme.Heat0" Color="#251B2D" />
    <SolidColorBrush x:Key="Theme.Heat1" Color="#4A2A3A" />
    <SolidColorBrush x:Key="Theme.Heat2" Color="#8A3F1E" />
    <SolidColorBrush x:Key="Theme.Heat3" Color="#D4661A" />
    <SolidColorBrush x:Key="Theme.Heat4" Color="#FF9A3C" />

    <!--  Kategoriefarben für Projekte und Balken, in fester Reihenfolge vergeben. Geprüft (dataviz-Validator):
          Helligkeitsband, Mindestsättigung, Nachbarn unterscheidbar bei Rot-Grün-Schwäche und normalem Sehen,
          mindestens 3:1 Kontrast zur Karte. DataNeutral: Grau für "zählt nicht".  -->
    <SolidColorBrush x:Key="Theme.Data0" Color="#AB5202" />
    <SolidColorBrush x:Key="Theme.Data1" Color="#A278E4" />
    <SolidColorBrush x:Key="Theme.Data2" Color="#3D9735" />
    <SolidColorBrush x:Key="Theme.Data3" Color="#AB3F84" />
    <SolidColorBrush x:Key="Theme.Data4" Color="#B08E05" />
    <SolidColorBrush x:Key="Theme.Data5" Color="#437DDE" />
    <SolidColorBrush x:Key="Theme.Data6" Color="#BA3E3C" />
    <SolidColorBrush x:Key="Theme.Data7" Color="#05A5B3" />
    <SolidColorBrush x:Key="Theme.DataNeutral" Color="#7C8496" />

    <DropShadowEffect x:Key="Theme.CardShadow" BlurRadius="18" Direction="270" Opacity="0.35" ShadowDepth="2" Color="#000000" />
    <DropShadowEffect x:Key="Theme.PopupShadow" BlurRadius="20" Direction="270" Opacity="0.5" ShadowDepth="4" Color="#000000" />
</ResourceDictionary>
