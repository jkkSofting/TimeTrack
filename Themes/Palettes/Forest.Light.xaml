<!--  Farbschema "Forest.Light" (Wald, hell: Moos, Tannen und Waldboden). Alle Paletten haben dieselben Schlüssel;
      der ThemeManager tauscht zur Laufzeit die komplette Palette aus.  -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Boolean x:Key="Theme.IsDark">False</sys:Boolean>
    <x:Static x:Key="Theme.Greeting" Member="sys:String.Empty" />

    <Color x:Key="Theme.TitleBarColor">#F3F6F1</Color>
    <Color x:Key="Theme.TitleBarTextColor">#1B2A20</Color>

    <LinearGradientBrush x:Key="Theme.AppBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F3F6F1" />
        <GradientStop Offset="1" Color="#EBF1E8" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Theme.Sidebar" Color="#234A32" />
    <SolidColorBrush x:Key="Theme.SidebarBorder" Color="#234A32" />
    <SolidColorBrush x:Key="Theme.SidebarText" Color="#DCEBDF" />
    <SolidColorBrush x:Key="Theme.SidebarTextMuted" Color="#8FB39A" />
    <SolidColorBrush x:Key="Theme.SidebarHover" Color="#2B5A3D" />
    <SolidColorBrush x:Key="Theme.SidebarSelected" Color="#346B48" />
    <SolidColorBrush x:Key="Theme.SidebarSelectedText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Theme.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Theme.CardBorder" Color="#DDE7DA" />
    <SolidColorBrush x:Key="Theme.Surface" Color="#F5F8F3" />
    <SolidColorBrush x:Key="Theme.SurfaceHover" Color="#E9F0E5" />
    <SolidColorBrush x:Key="Theme.Control" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Theme.ControlBorder" Color="#CCD9C7" />
    <SolidColorBrush x:Key="Theme.ControlHover" Color="#F2F6EF" />
    <SolidColorBrush x:Key="Theme.Text" Color="#1B2A20" />
    <SolidColorBrush x:Key="Theme.TextMuted" Color="#556B5C" />
    <SolidColorBrush x:Key="Theme.TextSubtle" Color="#97A99B" />
    <SolidColorBrush x:Key="Theme.Accent" Color="#3A8A4C" />
    <SolidColorBrush x:Key="Theme.AccentHover" Color="#47A05A" />
    <SolidColorBrush x:Key="Theme.AccentPressed" Color="#2F733F" />
    <SolidColorBrush x:Key="Theme.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Theme.AccentSoft" Color="#E3F1E5" />
    <SolidColorBrush x:Key="Theme.AccentSoftText" Color="#2F733F" />
    <SolidColorBrush x:Key="Theme.Divider" Color="#E3EBE0" />
    <SolidColorBrush x:Key="Theme.Track" Color="#E4ECE1" />
    <SolidColorBrush x:Key="Theme.Hover" Color="#F1F6EE" />
    <SolidColorBrush x:Key="Theme.Selection" Color="#DDEEDF" />
    <SolidColorBrush x:Key="Theme.Popup" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Theme.ScrollThumb" Color="#C9D6C5" />
    <SolidColorBrush x:Key="Theme.ScrollThumbHover" Color="#A7BCA2" />
    <SolidColorBrush x:Key="Theme.Success" Color="#1F9D60" />
    <SolidColorBrush x:Key="Theme.SuccessSoft" Color="#E3F6EC" />
    <SolidColorBrush x:Key="Theme.Warning" Color="#B26A00" />
    <SolidColorBrush x:Key="Theme.WarningSoft" Color="#FFF1DC" />
    <SolidColorBrush x:Key="Theme.Danger" Color="#D6334C" />
    <SolidColorBrush x:Key="Theme.DangerSoft" Color="#FDE8EC" />

    <SolidColorBrush x:Key="Theme.Heat0" Color="#E4ECE1" />
    <SolidColorBrush x:Key="Theme.Heat1" Color="#B9DDBE" />
    <SolidColorBrush x:Key="Theme.Heat2" Color="#7FC28B" />
    <SolidColorBrush x:Key="Theme.Heat3" Color="#43A058" />
    <SolidColorBrush x:Key="Theme.Heat4" Color="#2B7A3D" />

    <!--  Kategoriefarben für Projekte und Balken, in fester Reihenfolge vergeben. Geprüft (dataviz-Validator):
          Helligkeitsband, Mindestsättigung, Nachbarn unterscheidbar bei Rot-Grün-Schwäche und normalem Sehen,
          mindestens 3:1 Kontrast zur Karte. DataNeutral: Grau für "zählt nicht".  -->
    <SolidColorBrush x:Key="Theme.Data0" Color="#2F6E2A" />
    <SolidColorBrush x:Key="Theme.Data1" Color="#BA7E2D" />
    <SolidColorBrush x:Key="Theme.Data2" Color="#037EAF" />
    <SolidColorBrush x:Key="Theme.Data3" Color="#944126" />
    <SolidColorBrush x:Key="Theme.Data4" Color="#06A295" />
    <SolidColorBrush x:Key="Theme.Data5" Color="#8062B0" />
    <SolidColorBrush x:Key="Theme.Data6" Color="#606301" />
    <SolidColorBrush x:Key="Theme.Data7" Color="#B171B4" />
    <SolidColorBrush x:Key="Theme.DataNeutral" Color="#8A92A3" />

    <DropShadowEffect x:Key="Theme.CardShadow" BlurRadius="18" Direction="270" Opacity="0.07" ShadowDepth="2" Color="#1B2A20" />
    <DropShadowEffect x:Key="Theme.PopupShadow" BlurRadius="20" Direction="270" Opacity="0.11200000000000002" ShadowDepth="4" Color="#1B2A20" />
</ResourceDictionary>
