<!--  Farbschema "Christmas.Light" (Weihnachten, hell: Kerzenrot, Tannengrün und Schnee). Alle Paletten haben dieselben Schlüssel;
      der ThemeManager tauscht zur Laufzeit die komplette Palette aus.  -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Boolean x:Key="Theme.IsDark">False</sys:Boolean>
    <sys:String x:Key="Theme.Greeting">🎄  Frohe Weihnachten</sys:String>

    <Color x:Key="Theme.TitleBarColor">#FAF7F2</Color>
    <Color x:Key="Theme.TitleBarTextColor">#1E2A22</Color>

    <LinearGradientBrush x:Key="Theme.AppBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FAF7F2" />
        <GradientStop Offset="1" Color="#F3F1EA" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Theme.Sidebar" Color="#8E1B23" />
    <SolidColorBrush x:Key="Theme.SidebarBorder" Color="#8E1B23" />
    <SolidColorBrush x:Key="Theme.SidebarText" Color="#FBE6E7" />
    <SolidColorBrush x:Key="Theme.SidebarTextMuted" Color="#E0A2A7" />
    <SolidColorBrush x:Key="Theme.SidebarHover" Color="#A0242D" />
    <SolidColorBrush x:Key="Theme.SidebarSelected" Color="#B32E38" />
    <SolidColorBrush x:Key="Theme.SidebarSelectedText" Color="#FFE08A" />
    <SolidColorBrush x:Key="Theme.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Theme.CardBorder" Color="#E8E2D6" />
    <SolidColorBrush x:Key="Theme.Surface" Color="#FBF9F4" />
    <SolidColorBrush x:Key="Theme.SurfaceHover" Color="#F2EEE4" />
    <SolidColorBrush x:Key="Theme.Control" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Theme.ControlBorder" Color="#D9D1C2" />
    <SolidColorBrush x:Key="Theme.ControlHover" Color="#FAF7F0" />
    <SolidColorBrush x:Key="Theme.Text" Color="#1E2A22" />
    <SolidColorBrush x:Key="Theme.TextMuted" Color="#5E6B61" />
    <SolidColorBrush x:Key="Theme.TextSubtle" Color="#A0A89E" />
    <SolidColorBrush x:Key="Theme.Accent" Color="#1F7A45" />
    <SolidColorBrush x:Key="Theme.AccentHover" Color="#26904F" />
    <SolidColorBrush x:Key="Theme.AccentPressed" Color="#186438" />
    <SolidColorBrush x:Key="Theme.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Theme.AccentSoft" Color="#E2F2E8" />
    <SolidColorBrush x:Key="Theme.AccentSoftText" Color="#186438" />
    <SolidColorBrush x:Key="Theme.Divider" Color="#ECE6DA" />
    <SolidColorBrush x:Key="Theme.Track" Color="#EEE9DE" />
    <SolidColorBrush x:Key="Theme.Hover" Color="#F8F5EE" />
    <SolidColorBrush x:Key="Theme.Selection" Color="#E6F2EA" />
    <SolidColorBrush x:Key="Theme.Popup" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Theme.ScrollThumb" Color="#D6CEBF" />
    <SolidColorBrush x:Key="Theme.ScrollThumbHover" Color="#B9AE9B" />
    <SolidColorBrush x:Key="Theme.Success" Color="#1F9D60" />
    <SolidColorBrush x:Key="Theme.SuccessSoft" Color="#E3F6EC" />
    <SolidColorBrush x:Key="Theme.Warning" Color="#B26A00" />
    <SolidColorBrush x:Key="Theme.WarningSoft" Color="#FFF1DC" />
    <SolidColorBrush x:Key="Theme.Danger" Color="#D6334C" />
    <SolidColorBrush x:Key="Theme.DangerSoft" Color="#FDE8EC" />

    <SolidColorBrush x:Key="Theme.Heat0" Color="#EEE9DE" />
    <SolidColorBrush x:Key="Theme.Heat1" Color="#F5E3A8" />
    <SolidColorBrush x:Key="Theme.Heat2" Color="#EBC65A" />
    <SolidColorBrush x:Key="Theme.Heat3" Color="#D29B22" />
    <SolidColorBrush x:Key="Theme.Heat4" Color="#A8741A" />

    <!--  Kategoriefarben für Projekte und Balken, in fester Reihenfolge vergeben. Geprüft (dataviz-Validator):
          Helligkeitsband, Mindestsättigung, Nachbarn unterscheidbar bei Rot-Grün-Schwäche und normalem Sehen,
          mindestens 3:1 Kontrast zur Karte. DataNeutral: Grau für "zählt nicht".  -->
    <SolidColorBrush x:Key="Theme.Data0" Color="#A12F2F" />
    <SolidColorBrush x:Key="Theme.Data1" Color="#50A248" />
    <SolidColorBrush x:Key="Theme.Data2" Color="#835CBE" />
    <SolidColorBrush x:Key="Theme.Data3" Color="#924500" />
    <SolidColorBrush x:Key="Theme.Data4" Color="#0097D2" />
    <SolidColorBrush x:Key="Theme.Data5" Color="#A06604" />
    <SolidColorBrush x:Key="Theme.Data6" Color="#86398B" />
    <SolidColorBrush x:Key="Theme.Data7" Color="#06A295" />
    <SolidColorBrush x:Key="Theme.DataNeutral" Color="#8A92A3" />

    <DropShadowEffect x:Key="Theme.CardShadow" BlurRadius="18" Direction="270" Opacity="0.07" ShadowDepth="2" Color="#2A1A10" />
    <DropShadowEffect x:Key="Theme.PopupShadow" BlurRadius="20" Direction="270" Opacity="0.11200000000000002" ShadowDepth="4" Color="#2A1A10" />
</ResourceDictionary>
