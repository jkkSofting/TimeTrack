<!--  Farbschema "Easter.Dark" (Ostern, dunkel: Flieder und Pastell in der Dämmerung). Alle Paletten haben dieselben Schlüssel;
      der ThemeManager tauscht zur Laufzeit die komplette Palette aus.  -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Boolean x:Key="Theme.IsDark">True</sys:Boolean>
    <sys:String x:Key="Theme.Greeting">🐣  Frohe Ostern</sys:String>

    <Color x:Key="Theme.TitleBarColor">#17141F</Color>
    <Color x:Key="Theme.TitleBarTextColor">#F3EFF8</Color>

    <LinearGradientBrush x:Key="Theme.AppBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#17141F" />
        <GradientStop Offset="1" Color="#1C1826" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Theme.Sidebar" Color="#120F19" />
    <SolidColorBrush x:Key="Theme.SidebarBorder" Color="#221D2E" />
    <SolidColorBrush x:Key="Theme.SidebarText" Color="#E3DAF2" />
    <SolidColorBrush x:Key="Theme.SidebarTextMuted" Color="#8F84A6" />
    <SolidColorBrush x:Key="Theme.SidebarHover" Color="#1D1828" />
    <SolidColorBrush x:Key="Theme.SidebarSelected" Color="#2A2240" />
    <SolidColorBrush x:Key="Theme.SidebarSelectedText" Color="#D9C6FF" />
    <SolidColorBrush x:Key="Theme.Card" Color="#201B2B" />
    <SolidColorBrush x:Key="Theme.CardBorder" Color="#312A42" />
    <SolidColorBrush x:Key="Theme.Surface" Color="#262034" />
    <SolidColorBrush x:Key="Theme.SurfaceHover" Color="#302841" />
    <SolidColorBrush x:Key="Theme.Control" Color="#231E2F" />
    <SolidColorBrush x:Key="Theme.ControlBorder" Color="#3B3250" />
    <SolidColorBrush x:Key="Theme.ControlHover" Color="#2B243A" />
    <SolidColorBrush x:Key="Theme.Text" Color="#F3EFF8" />
    <SolidColorBrush x:Key="Theme.TextMuted" Color="#B3A8C6" />
    <SolidColorBrush x:Key="Theme.TextSubtle" Color="#776C8C" />
    <SolidColorBrush x:Key="Theme.Accent" Color="#B49AF0" />
    <SolidColorBrush x:Key="Theme.AccentHover" Color="#C5B0F5" />
    <SolidColorBrush x:Key="Theme.AccentPressed" Color="#9C80DE" />
    <SolidColorBrush x:Key="Theme.OnAccent" Color="#1A1326" />
    <SolidColorBrush x:Key="Theme.AccentSoft" Color="#33284D" />
    <SolidColorBrush x:Key="Theme.AccentSoftText" Color="#D9C9FF" />
    <SolidColorBrush x:Key="Theme.Divider" Color="#312A42" />
    <SolidColorBrush x:Key="Theme.Track" Color="#2C2539" />
    <SolidColorBrush x:Key="Theme.Hover" Color="#2A2337" />
    <SolidColorBrush x:Key="Theme.Selection" Color="#3A2F55" />
    <SolidColorBrush x:Key="Theme.Popup" Color="#231E2F" />
    <SolidColorBrush x:Key="Theme.ScrollThumb" Color="#3B3250" />
    <SolidColorBrush x:Key="Theme.ScrollThumbHover" Color="#56497A" />
    <SolidColorBrush x:Key="Theme.Success" Color="#3DD68C" />
    <SolidColorBrush x:Key="Theme.SuccessSoft" Color="#14352A" />
    <SolidColorBrush x:Key="Theme.Warning" Color="#FFB454" />
    <SolidColorBrush x:Key="Theme.WarningSoft" Color="#3A2A16" />
    <SolidColorBrush x:Key="Theme.Danger" Color="#FF6B81" />
    <SolidColorBrush x:Key="Theme.DangerSoft" Color="#3A1620" />

    <SolidColorBrush x:Key="Theme.Heat0" Color="#262034" />
    <SolidColorBrush x:Key="Theme.Heat1" Color="#3E3258" />
    <SolidColorBrush x:Key="Theme.Heat2" Color="#5E4A8F" />
    <SolidColorBrush x:Key="Theme.Heat3" Color="#8A6CD0" />
    <SolidColorBrush x:Key="Theme.Heat4" Color="#C3A9F7" />

    <DropShadowEffect x:Key="Theme.CardShadow" BlurRadius="18" Direction="270" Opacity="0.3" ShadowDepth="2" Color="#000000" />
    <DropShadowEffect x:Key="Theme.PopupShadow" BlurRadius="20" Direction="270" Opacity="0.48" ShadowDepth="4" Color="#000000" />
</ResourceDictionary>
