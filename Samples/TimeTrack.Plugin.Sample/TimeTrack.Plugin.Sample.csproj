<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Beispiel und Vorlage für ein TimeTrack-Plugin: eine Seite und ein Einstellungsbereich, ohne Abhängigkeiten.
    Bauen:      dotnet build Samples\TimeTrack.Plugin.Sample
    Ausprobieren: den Inhalt von bin\Debug\net48 nach
                C:\ProgramData\Kaltenmark-Engineering\TimeTracker\Plugins\TimeTrack.Plugin.Sample\ kopieren,
                TimeTrack starten, unter Einstellungen → Plugins aktivieren, neu starten.
    Nicht Teil der Zeitmanagement.sln: Der Release-Build und der Installer sollen es nicht mitnehmen.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>TimeTrack.Plugin.Sample</AssemblyName>
    <RootNamespace>TimeTrack.Plugin.Sample</RootNamespace>
    <Product>Beispiel-Plugin</Product>
    <Description>Zeigt, wie ein Plugin eine Seite und Einstellungen hinzufügt.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false: Die Abstractions-DLL kommt zur Laufzeit aus TimeTrack und darf nicht im Plugin-Ordner liegen. -->
    <ProjectReference Include="..\..\TimeTrack.Plugins.Abstractions\TimeTrack.Plugins.Abstractions.csproj" Private="false" />
  </ItemGroup>

</Project>
